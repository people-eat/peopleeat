                    "expr": "histogram_quantile(0.75, sum by (le, vital_name) (rate(client_web_vital_score_bucket{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])))",
                    "legendFormat": "{{vital_name}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "editorMode": "code",
