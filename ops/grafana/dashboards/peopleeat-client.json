            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (vital_name) (rate(client_web_vital_duration_milliseconds_count{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval]))",
