{
    "uid": "peopleeat-graphql",
    "title": "peopleeat / GraphQL",
    "description": "GraphQL operation and subscription latency, throughput, and errors.",
    "tags": ["peopleeat"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "editable": true,
    "graphTooltip": 1,
    "fiscalYearStartMonth": 0,
    "liveNow": false,
    "weekStart": "",
    "links": [
        {
            "title": "peopleeat dashboards",
            "type": "dashboards",
            "tags": ["peopleeat"],
            "asDropdown": true,
            "includeVars": true,
            "keepTime": true
        }
    ],
    "annotations": {
        "list": []
    },
    "templating": {
        "list": [
            {
                "name": "environment",
                "type": "query",
                "label": "Environment",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "description": "Defaults to production. Switch to test (or All) when debugging staging.",
                "query": "label_values(graphql_operation_duration_milliseconds_count{service_name=\"peopleeat\"}, deployment_environment)",
                "refresh": 2,
                "includeAll": true,
                "multi": true,
                "allValue": ".*",
                "current": {
                    "selected": true,
                    "text": "production",
                    "value": "production"
                },
                "sort": 1
            }
        ]
    },
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "Operations",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "collapsed": false,
            "panels": []
        },
        {
            "id": 1,
            "type": "timeseries",
            "title": "Request rate by operation",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 1,
                        "fillOpacity": 15,
                        "spanNulls": true,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (graphql_operation_name) (rate(graphql_operation_duration_milliseconds_count{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval]))",
                    "legendFormat": "{{graphql_operation_name}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "editorMode": "code",
                    "range": true,
                    "instant": false
                }
            ]
        },
