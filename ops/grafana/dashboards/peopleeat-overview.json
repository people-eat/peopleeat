{
    "uid": "peopleeat-overview",
    "title": "peopleeat / Overview",
    "description": "Ops at a glance: GraphQL RED, jobs, client vitals. Environment defaults to production; toggle to test or All.",
    "tags": ["peopleeat"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "editable": true,
    "graphTooltip": 1,
    "fiscalYearStartMonth": 0,
    "liveNow": false,
    "weekStart": "",
    "links": [
        {
            "title": "peopleeat dashboards",
            "type": "dashboards",
            "tags": ["peopleeat"],
            "asDropdown": true,
            "includeVars": true,
            "keepTime": true
        }
    ],
    "annotations": {
        "list": []
    },
    "templating": {
        "list": [
            {
                "name": "environment",
                "type": "query",
                "label": "Environment",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "description": "Defaults to production. Switch to test (or All) when debugging staging.",
                "query": "label_values(graphql_operation_duration_milliseconds_count{service_name=\"peopleeat\"}, deployment_environment)",
                "refresh": 2,
                "includeAll": true,
                "multi": true,
                "allValue": ".*",
                "current": {
                    "selected": true,
                    "text": "production",
                    "value": "production"
                },
                "sort": 1
            }
        ]
    },
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "GraphQL",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "collapsed": false,
            "panels": []
        },
        {
            "id": 1,
            "type": "stat",
            "title": "GraphQL req/s",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto",
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(graphql_operation_duration_milliseconds_count{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval]))",
                    "legendFormat": "",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "editorMode": "code",
                    "range": false,
                    "instant": true
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "GraphQL error rate",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto",
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(graphql_operation_errors_total{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])) / clamp_min(sum(rate(graphql_operation_duration_milliseconds_count{service_name=\"peopleeat\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])), 1e-9)",
                    "legendFormat": "",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "editorMode": "code",
                    "range": false,
                    "instant": true
                }
            ]
        },
