# Local development environment variables.
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored.
#
# Loaded by:
#   - Vite (npm run dev / npm run build) — auto-loaded by Vite from .env.local
#   - drizzle.config.ts (npm run db:push / db:migrate / db:generate / db:studio)
# NOT loaded by tests — see .env.test.example for that.
#
# All values are validated at server boot in
# src/server/env/environmentVariablesCreate.ts. See docs/infrastructure.md
# for the full table and docs/architecture/environment.md for the design.
# Boot fails when any always-required var is missing. EMAIL_TRANSPORT=console
# and SLACK_TRANSPORT=console skip provider credentials for local/dev.

# --- Always required (boot fails without them) ------------------------------

DATABASE_URL="postgres://postgres:postgres@localhost:5432/mydb"
sessionCookieName="my-app-session-id"
WEB_PAGE_URL="http://localhost:3000"
VISITOR_IP_HASH_SALT="dev-only-change-me-with-openssl-rand-hex-32"

GOOGLE_GENERATIVE_AI_API_KEY="replace-me"
GOOGLE_PLACES_API_KEY="replace-me"
SERVER_TOKEN_SECRET="replace-me-with-a-long-random-string"

AUTH_OTP_PEPPER="test-otp-pepper"
# 32-byte AES key as 64 hex chars. Generate with: openssl rand -hex 32
AUTH_TOTP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Stripe Connect — use test-mode keys locally.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

RECAPTCHA_SECRET_KEY="replace-me"
RECAPTCHA_SITE_KEY="replace-me"

LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY="replace-me"
LIVEKIT_API_SECRET="replace-me"

OBJECT_STORAGE_S3_BUCKET="peopleeat-object-storage"
OBJECT_STORAGE_S3_ENDPOINT="https://garage-s3.example.com"
OBJECT_STORAGE_S3_REGION="garage"
OBJECT_STORAGE_S3_ACCESS_KEY_ID="replace-me"
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY="replace-me"

KLAVIYO_PRIVATE_API_KEY="pk_replace_me"

# --- Transports (console skips provider credentials) ------------------------

# How transactional email is delivered. `console` prints the message (incl.
# OTP codes) to the server terminal — preferred for local/dev. `resend` sends
# via the Resend API and requires RESEND_* below. Defaults to `resend` when unset.
EMAIL_TRANSPORT=console
# RESEND_API_KEY=
# Bare address — send prefixes display name `peopleeat <…>`. Override with `Name <addr>` if needed.
# RESEND_FROM_EMAIL=peopleeat@mail.people-eat.com
# RESEND_WEBHOOK_SECRET=

# How Slack ops posts are delivered. `console` prints to the server terminal —
# preferred for local/dev. `slack` posts via the Web API and requires
# SLACK_BOT_TOKEN + all SLACK_CHANNEL_* below. Defaults to `slack` when unset.
SLACK_TRANSPORT=console
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_BOOKING_REQUESTS=
# SLACK_CHANNEL_CASH_COWS=
# SLACK_CHANNEL_SIGN_UPS=
# SLACK_CHANNEL_SUPPORT_REQUESTS=
# SLACK_CHANNEL_GIFT_CARD_PURCHASES=
# SLACK_CHANNEL_BOOKING_REQUEST_REPORTS=
# SLACK_CHANNEL_OPS_ALERTS=
# SLACK_CHANNEL_WHATSAPP_MESSAGES=

# How WhatsApp is delivered. `console` prints to the server terminal —
# preferred for local/dev. `meta` calls the Meta Cloud API and requires
# WHATSAPP_* below. Defaults to `meta` when unset.
WHATSAPP_TRANSPORT=console
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Observability (OpenTelemetry / Langfuse). Defaults to off — see
# docs/architecture/observability.md. Leave off for local/dev unless you are
# intentionally sending traces to a non-production project.
LANGFUSE_TRANSPORT=off
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_TRANSPORT=off
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OBSERVABILITY_ENVIRONMENT=development

# --- Optional defaults ------------------------------------------------------

# Set to "true" in production to enable Secure + SameSite=None on the session
# cookie. Leave unset for localhost.
# sessionCookieSecure="false"

# Cookie domain scope for cross-subdomain sessions (e.g. ".example.com").
# Leave unset to scope to the request host only.
# sessionCookieDomainScope=""

# Commit SHA reported by /api/health. In Docker this is set via the BUILD_SHA
# build arg (see Dockerfile). Defaults to "unknown" locally.
# BUILD_SHA=""

# Optional LiveKit room-name prefix so multi-env DBs sharing one cluster do not
# collide (default: WEB_PAGE_URL hostname).
# LIVEKIT_ROOM_PREFIX="localhost"

# Path-style addressing for Garage/Traefik (default true; set false to disable).
# OBJECT_STORAGE_S3_FORCE_PATH_STYLE="true"
