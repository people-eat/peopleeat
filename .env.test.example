# Integration-test environment variables.
#
# Copy this file to .env.test and fill in a real value. .env.test is
# gitignored.
#
# Loaded by src/server/test/commandTestUtils.ts (via dotenv) and by e2e/
# fixtures (via e2e/env.ts) before integration / Playwright tests run. Unit
# tests do NOT depend on this file — they pass an explicit source object to
# environmentVariablesCreate() via environmentVariablesTestSource(). Only the
# command/integration/e2e tests that hit a real Postgres need the values below.
#
# Use a SEPARATE database from production — tests insert freely (UUID isolation,
# no truncate between cases). For local Playwright against `npm run dev`, keep
# DATABASE_URL aligned with `.env.local`. E2e loads `.env.test` then `.env.local`
# with override so sessionCookieName matches the running Vite process.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb_test"
sessionCookieName="session-id"
WEB_PAGE_URL="http://localhost:3000"
VISITOR_IP_HASH_SALT="test-salt"

GOOGLE_GENERATIVE_AI_API_KEY="test-google-ai"
GOOGLE_PLACES_API_KEY="test-google-places"
SERVER_TOKEN_SECRET="test-server-token-secret"
AUTH_OTP_PEPPER="test-otp-pepper"
AUTH_TOTP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
RECAPTCHA_SECRET_KEY="test-recaptcha-secret"
RECAPTCHA_SITE_KEY="test-recaptcha-site"

LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY="test-livekit-key"
LIVEKIT_API_SECRET="test-livekit-secret"

OBJECT_STORAGE_S3_BUCKET="test-bucket"
OBJECT_STORAGE_S3_ENDPOINT="https://garage.example.com"
OBJECT_STORAGE_S3_REGION="garage"
OBJECT_STORAGE_S3_ACCESS_KEY_ID="test-access-key"
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY="test-secret-key"

KLAVIYO_PRIVATE_API_KEY="pk_klaviyo_test"

# Prefer console so accidental unmocked email.send / slack.postMessage never
# hit external providers.
EMAIL_TRANSPORT="console"
SLACK_TRANSPORT="console"
WHATSAPP_TRANSPORT="console"
LANGFUSE_TRANSPORT="off"
OTEL_TRANSPORT="off"
