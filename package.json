        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": "^24.20.0",
        "npm": "^12.0.2",
        "pnpm": "please-use-npm",
