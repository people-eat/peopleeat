{
    "name": "peopleeat",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "([ -z \"$CI\" ] && npm dedupe --quiet || true)",
        "check": "npm run format:check && npm run type:check && npm run lint:check && npm run spell:check && npm run usage:check && npm run commitlint:check",
        "commitlint:check": "commitlint --from \"$(git rev-parse --verify HEAD~1 2>/dev/null || git hash-object -t tree /dev/null)\" --to HEAD",
        "dev": "node --import ./ops/observability/register.mjs ./node_modules/vite/bin/vite.js dev --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "drizzle-kit generate && prettier --write drizzle/",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:check-applied": "tsx scripts/migrationsCheck.ts",
        "db:reconcile": "tsx scripts/migrationsReconcile.ts",
        "db:wipe": "tsx scripts/databaseWipe.ts",
        "images:optimize-public": "tsx scripts/optimizePublicImages.ts",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio",
        "graphql:generate": "graphql-codegen --config codegen.ts",
        "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
        "lint:check": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
        "spell:check": "cspell . --no-progress --dot",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "email:dev": "email dev --dir src/server/email/previews --port 3030",
        "email:build": "email build --dir src/server/email/previews",
        "email:start": "email start",
        "type:check": "npm exec tsc -- --noEmit",
        "usage:check": "knip",
        "prepare": "husky"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.109",
        "@apollo/server": "^5.5.1",
        "@aws-sdk/client-s3": "^3.1161.0",
