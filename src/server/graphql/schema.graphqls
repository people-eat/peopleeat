type PublicCityQuery {
    findOneByPathName(pathName: String!): PublicCity
    findMany: [PublicCity!]!
}

type PublicPartnerQuery {
    findOneByPathName(pathName: String!): PublicPartner
    findMany: [PublicPartner!]!
}

type PublicOccasionQuery {
    findOneByPathName(pathName: String!): PublicOccasion
    findMany: [PublicOccasion!]!
}

type PublicBlogPostQuery {
    findOneByPathName(pathName: String!): PublicBlogPost
    findMany: [PublicBlogPost!]!
}

# Shared lat/long pair. Output + input keep parallel names (`GeoCoordinates` /
# `GeoCoordinatesInput`) — GraphQL forbids reusing one name across kinds.
type GeoCoordinates {
    latitude: Latitude!
    longitude: Longitude!
}

input GeoCoordinatesInput {
    latitude: Latitude!
    longitude: Longitude!
}

# Public chefs listing / detail — `isVisible && isApprovedByAdmin` only.
# Detail is keyed by `cookId` for now; slug URLs are planned (see public-chefs.md).
# `findMany` lists cooks with ≥1 published meal; optional `searchText` and
# `geoCoordinates` (travel-radius filter — for city pages later).

input PublicCookFindManyCriterion {
    searchText: String
    # When set, keep cooks whose travel origin reaches this point
    # (`maximumTravelDistance` vs haversine; null max distance = unlimited).
    geoCoordinates: GeoCoordinatesInput
}

type PublicCookQuery {
    findOne(cookId: ID!): PublicCook
    findMany(criterion: PublicCookFindManyCriterion): [PublicCook!]!
}

# --- Fixed-route SEO (WebPages) -----------------------------------------------
#
# Admin-editable bilingual title/description for fixed marketing and chrome
# routes. Missing DB rows use shared defaults (ghost). First admin write
# upserts. Dynamic city/partner/occasion/blog detail SEO stays on those entity
# tables. See docs/features/admin-web-pages.md.

enum WebPageKey {
    LANDING
    CITIES
    PARTNERS
    OCCASIONS
    CHEFS
    BLOG_POSTS
    ABOUT_US
    GIFT_CARD
    HOW_TO_BECOME_A_CHEF
    BOOKING_REQUEST
    BOOKING_REQUEST_FORM
    BOOKING_REQUEST_CHAT
    CHEF_SIGN_UP
    IMPRINT
    TERMS_AND_CONDITIONS
    PRIVACY_POLICY
    SIGN_IN
    PROFILE
    ADMINISTRATION
}

type AdminWebPage {
    webPageKey: WebPageKey!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    # False when no DB row exists yet (ghost; fields from shared defaults).
    persisted: Boolean!
    # Null when not persisted.
    updatedAt: DateTime
}

type PublicWebPage {
    webPageKey: WebPageKey!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
}

input AdminWebPageUpdate {
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
}

type PublicWebPageQuery {
    findOne(webPageKey: WebPageKey!): PublicWebPage!
}

# --- Feature toggles ----------------------------------------------------------
#
# Fixed-key on/off switches. Missing DB rows are disabled (ghost). See
# docs/features/admin-feature-toggles.md.

enum FeatureToggleKey {
    AI_MENU_EVALUATION
    COOK_BIOGRAPHY_AI_WRITE
    COOK_WALLET_STRIPE_BALANCE
    BOOKING_REQUEST_RESTRICTIONS
    BOOKING_REQUEST_OFFER_CHAT_REACTIONS
    BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT
    ASSISTANT_CUSTOMER
    ASSISTANT_COOK
    PUBLICATION_MEALS
    PUBLICATION_MENUS
    WHATSAPP_ENGLISH_TEMPLATES
    WHATSAPP_WEBHOOK_SIGNATURE_VALIDATION
}

type AdminFeatureToggle {
    featureToggleKey: FeatureToggleKey!
    # False when the row is missing (`persisted: false`).
    enabled: Boolean!
    # False when no DB row exists yet (ghost).
    persisted: Boolean!
    # Null when not persisted.
    updatedAt: DateTime
    # Persisted per-user overrides for this key.
    userOverrides: [AdminFeatureToggleUserOverride!]!
}

# Persisted per-user override of a global feature toggle.
type AdminFeatureToggleUserOverride {
    userId: ID!
    featureToggleKey: FeatureToggleKey!
    # Force on (`true`) or force off (`false`) for this user.
    enabled: Boolean!
    updatedAt: DateTime!
    user: AdminUser!
}
