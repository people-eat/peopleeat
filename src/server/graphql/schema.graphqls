scalar DateTime
scalar Date
# Untyped JSON payload — used only where the GraphQL schema is itself a union
# of values that the UI surfaces verbatim (e.g. tool call arguments rendered
# in a debug/inspect dialog). See docs/architecture/chat.md.
scalar JSON
# Contact / geo format gates from graphql-scalars (parse + serialize). See
# docs/architecture/api-layer.md. Commands still own normalize/uniqueness
# (e.g. emailNormalize, phone uniqueness).
scalar EmailAddress
scalar PhoneNumber
scalar Latitude
scalar Longitude
# IANA time zone (e.g. Europe/Berlin). Validated by graphql-scalars
# TimeZoneResolver. See docs/architecture/i18n.md.
scalar TimeZone

enum Locale {
    de
    en
}

enum ChatMessageDeliveryStatus {
    SENT
    DELIVERED
    READ
    FAILED
}

type ChatMessageReaction {
    emoji: String!
    # Viewer-relative: true when the reaction was applied by the viewer's party
    # (same convention as `ChatMessageUser.isOwn`).
    isOwn: Boolean!
}

type ChatMessageUser {
    chatMessageId: ID!
    # Lean public identity — no email / last name / phone. See `PublicUser`.
    author: PublicUser!
    # Viewer-relative: true when this message was authored by the requesting
    # user (assistant chats) or by the viewer's party on an offer thread
    # (customer / cook / admin). Stamped at map time — `PublicUser` has no id.
    isOwn: Boolean!
    # Wire-only affordance (not persisted). Always `false` today; reserved so
    # admin / inspector surfaces can opt into an in-bubble copy control later
    # without a schema migration. See docs/architecture/chat.md.
    showCopyButton: Boolean!
    # Wire-only affordance (not persisted). When true, long user bodies clamp
    # to two lines with an expand chevron — useful on assistant transcripts
    # where the human's pastes are secondary to the model reply. Stamped
    # `true` by assistant chat mappers and `false` by offer/support mappers.
    # See docs/architecture/chat.md.
    collapseLongBody: Boolean!
    # Soft-hide flag from offer-chat `*_MESSAGE_SIMPLE` payloads. Stamped from
    # payload for admin viewers; peers never receive hidden rows in `messages`.
    # Other chat surfaces (assistant / support / WhatsApp) always stamp `false`.
    # See docs/features/booking-offer-chat.md.
    hiddenByAdmin: Boolean!
    # Wire-only. True when the viewer is admin and this bubble is an
    # `ADMIN_MESSAGE_SIMPLE` (hard-delete allowed). Always `false` elsewhere.
    canHardDelete: Boolean!
    body: String!
    # Files the user attached to this message, in send-order. Empty list when
    # the message was a plain-text send. The bytes are not exposed inline —
    # `FileUpload.url` points at `/api/file-uploads/:id` which streams them
    # back behind the same session cookie that authorized the upload.
    attachments: [FileUpload!]!
    # Optional delivery ticks for outbound WhatsApp (and future carriers).
    # Null on assistant / offer / support messages.
    deliveryStatus: ChatMessageDeliveryStatus
    # Emoji reactions on this message (WhatsApp Concierge today; empty elsewhere).
    # Not separate transcript rows — overlays on the target bubble.
    reactions: [ChatMessageReaction!]!
    createdAt: DateTime!
}

# A persisted user-uploaded file. Consumer-agnostic — chat surfaces these
# today as message attachments via the `ChatMessageUser.attachments` field,
# but the same shape is reused by other surfaces (e.g. assistant-side
# outputs, avatars, document uploads).
type FileUpload {
    fileUploadId: ID!
    filename: String!
    # IANA media type — drives both the in-bubble preview (image vs file
    # chip) and the LLM-side `FilePart` `mediaType` in
    # `toModelMessages`.
    mediaType: String!
    # Size in bytes. Mirrors what the upload route persisted; clamped at the
    # route, not validated again here.
    size: Int!
    # Server-rooted URL to stream the bytes back. Today: `/api/file-uploads/:id`.
    url: String!
}

# Offer-domain timeline row projected from `BookingRequestOfferEvents`
# (everything except `*_MESSAGE_SIMPLE`, which become `ChatMessageUser`).
# `chatMessageId` is the event UUID. `payload` matches the domain JSONB for
# `type`. See docs/architecture/booking.md and docs/architecture/chat.md.
enum ChatMessageBookingRequestOfferEventType {
    COOK_CREATED
    COOK_UPDATED_SUGGESTED_MENU
    USER_REQUESTED_MENU_CHANGES
    USER_CONFIGURED_MENU
    COOK_ACCEPTED
    COOK_DECLINED
    USER_ACCEPTED
    USER_DECLINED
    USER_CANCELLED
    ADMIN_HANDED_OVER_CLOSED
    ADMIN_HANDED_OVER_TO_COOK
    USER_PARTICIPANTS_UPDATED
    USER_PARTICIPANT_AMENDMENT_REQUESTED
    COOK_PARTICIPANT_AMENDMENT_ACCEPTED
    COOK_PARTICIPANT_AMENDMENT_DECLINED
    COOK_PREPARATIONS_COMPLETED
    ADMIN_PREPARATIONS_CLEARED
    USER_RESTRICTIONS_UPDATED
    USER_DATE_UPDATED
    USER_TIME_UPDATED
    USER_PREFERENCES_UPDATED
    USER_LOCATION_UPDATED
    COOK_CHANGED_PRICE
    SYSTEM_CHANGED_PRICE
    USER_CALL_SLOT_REQUESTED
    COOK_CALL_SLOT_REQUESTED
    COOK_CALL_SLOT_CONFIRMED
    USER_CALL_SLOT_CONFIRMED
    COOK_CALL_SLOT_DECLINED
    USER_CALL_SLOT_DECLINED
    USER_CALL_SLOT_CANCELLED
    COOK_CALL_SLOT_CANCELLED
}

type ChatMessageBookingRequestOfferEvent {
    chatMessageId: ID!
    type: ChatMessageBookingRequestOfferEventType!
    payload: JSON!
    createdAt: DateTime!
}

# Human offer/support transcript rows. Not members of the assistant parts model.
union HumanChatMessage = ChatMessageUser | ChatMessageBookingRequestOfferEvent

# --- Assistant chat (durable turn + parts) ------------------------------------
#
# See docs/architecture/chat.md. Bodies are JSONB parts; GraphQL strips
# `stepStart`. Tool slot typing for `promptUserForInput` lives in Zod + UI only.

enum ChatTurnStatus {
    QUEUED
    RUNNING
    AWAITING_INPUT
    COMPLETE
    FAILED
    CANCELLED
}

enum ChatMessageRole {
    USER
    ASSISTANT
}

enum ChatMessageStatus {
    PENDING
    STREAMING
    COMPLETE
    FAILED
    CANCELLED
}

enum ChatMessagePartState {
    STREAMING
    DONE
}

enum ChatToolState {
    INPUT_STREAMING
    INPUT_AVAILABLE
    APPROVAL_REQUESTED
    APPROVAL_RESPONDED
    OUTPUT_AVAILABLE
    OUTPUT_ERROR
    OUTPUT_DENIED
}

enum ChatToolApprovalStatus {
    REQUESTED
    APPROVED
    DENIED
}

type ChatTurnUsage {
    inputTokens: Int
    outputTokens: Int
    totalTokens: Int
    reasoningTokens: Int
    cachedInputTokens: Int
}

type ChatTurnFailure {
    code: String!
}

type ChatTurnDebug {
    agentName: String
    modelId: String
    finishReason: String
    usage: ChatTurnUsage
}

type ChatTurn {
    chatTurnId: ID!
    sequence: Int!
    status: ChatTurnStatus!
    revision: Int!
    locale: Locale
    userMessage: ChatMessage!
    assistantMessage: ChatMessage!
    failure: ChatTurnFailure
    debug: ChatTurnDebug
    createdAt: DateTime!
    startedAt: DateTime
    completedAt: DateTime
    lastModifiedAt: DateTime!
}

type ChatMessage {
    chatMessageId: ID!
    chatTurnId: ID!
    role: ChatMessageRole!
    status: ChatMessageStatus!
    revision: Int!
    parts: [ChatMessagePart!]!
    # User-role attachments only; empty for assistant messages.
    attachments: [FileUpload!]!
    createdAt: DateTime!
    lastModifiedAt: DateTime!
}

type ChatMessageTextPart {
    partId: ID!
    state: ChatMessagePartState!
    text: String!
}

type ChatMessageReasoningPart {
    partId: ID!
    state: ChatMessagePartState!
    text: String!
}

type ChatToolApproval {
    approvalId: ID!
    status: ChatToolApprovalStatus!
    descriptor: JSON
    reason: String
}

type ChatToolDebug {
    input: JSON
    output: JSON
    errorText: String
}

type ChatMessageToolPart {
    partId: ID!
    toolCallId: ID!
    toolName: String!
    title: String
    state: ChatToolState!
    providerExecuted: Boolean!
    preliminary: Boolean!
    approval: ChatToolApproval
    # Gated: CHAT_DEBUG_ENABLED or any admin session (own rail + inspecting). Always persisted in JSONB.
    debug: ChatToolDebug
}

type ChatMessageSourceUrlPart {
    partId: ID!
    sourceId: ID!
    url: String!
    title: String
}

type ChatMessageSourceDocumentPart {
    partId: ID!
    sourceId: ID!
    mediaType: String!
    title: String!
    filename: String
}

type ChatMessageFilePart {
    partId: ID!
    mediaType: String!
    filename: String
    url: String!
}

type ChatMessageDataPart {
    partId: ID!
    dataType: String!
    data: JSON!
}

union ChatMessagePart =
    | ChatMessageTextPart
    | ChatMessageReasoningPart
    | ChatMessageToolPart
    | ChatMessageSourceUrlPart
    | ChatMessageSourceDocumentPart
    | ChatMessageFilePart
    | ChatMessageDataPart

type Chat {
    chatId: ID!
    # Owning user. Null only for legacy pre-ownership rows (unreachable via
    # User.assistantChat(s) / Admin.assistantChat(s) after backfill filters).
    userId: ID
    # Which assistant rail this chat belongs to. Null only on legacy rows.
    surface: ChatSurface
    title: String!
    lastModifiedAt: DateTime!
    # Sequence-ordered turns. Loaded only when selected (list queries omit it).
    turns: [ChatTurn!]!
}

# Soft-delete is owner-facing only; `Chat` never exposes `deletedAt` (filtered out).

type ChatTurnSnapshot {
    turns: [ChatTurn!]!
}

type ChatTurnUpserted {
    turn: ChatTurn!
}

union ChatTurnUpdate = ChatTurnSnapshot | ChatTurnUpserted

# Which product surface owns an assistant chat. Booking-request stays out until
# that surface ships. See docs/features/assistant-sidebar.md.
enum ChatSurface {
    admin
    customer
    cook
}

enum UserPreferredCommunication {
    SMS
    WHATS_APP
    CALL
    E_MAIL
}

# Account lifecycle. `ANONYMIZED` after delete/admin anonymize — email null, no login.
# `BANNED` may still sign in but marketplace writes are blocked; see docs/features/account.md.
enum UserStatus {
    ACTIVE
    BANNED
    ANONYMIZED
}

# Self-serve registration after email OTP verify (new email). Name is always
# required. Phone, birthDate, and preferredCommunication are optional on the
# schema so lightweight surfaces (gift-card purchase) can omit them; other UIs
# still collect and send them. Optional `cook` inserts a `Cooks` row in the
# same transaction (chef sign-up). See docs/features/sign-in.md.
input UserCreate {
    firstName: String!
    lastName: String!
    phoneNumber: PhoneNumber
    birthDate: Date
    preferredCommunication: UserPreferredCommunication
    # UI locale at registration — stamped on `Users.locale` for emails/jobs.
    locale: Locale!
    # Browser IANA zone at registration — stamped on `Users.timeZone`.
    timeZone: TimeZone!
    cook: CookCreate
}

# Patch. At least one field required. `profilePictureFileUploadId: null`
# clears the picture. Upload bytes via POST /api/file-uploads first, then
# pass the id here. See docs/features/profile-pictures.md.
input UserUpdate {
    firstName: String
    lastName: String
    phoneNumber: PhoneNumber
    birthDate: Date
    preferredCommunication: UserPreferredCommunication
    locale: Locale
    timeZone: TimeZone
    profilePictureFileUploadId: ID
}

type User {
    userId: ID!
    # ACTIVE | BANNED | ANONYMIZED. Session-owned; drives the private profile
    # restriction banner. Admin ban/unban: `AdminMutation.userStatusUpdate`.
    # See docs/features/account.md.
    status: UserStatus!
    # Null when the account has been anonymized (`Users.status = ANONYMIZED`).
    # Active users always have an address. See docs/features/account.md.
    emailAddress: EmailAddress
    firstName: String!
    lastName: String!
    phoneNumber: PhoneNumber
    birthDate: Date
    preferredCommunication: UserPreferredCommunication
    # Profile language — drives mismatch gate + outbound transactional email.
    # See docs/architecture/i18n.md.
    locale: Locale!
    # IANA zone for date/time display. See docs/architecture/i18n.md.
    timeZone: TimeZone!
    # Current profile picture. Bytes live in FileUploads; this field resolves
    # the linked upload (url → /api/file-uploads/:id). Public GET when this FK
    # points at the upload. See docs/features/profile-pictures.md.
    profilePicture: FileUpload
    # Admin read namespace — non-null only for the session's own admin user
    # (row in `Admins` with `adminId` = `Users.userId`). Null for anonymous
    # sessions, non-admin logged-in users, and any future cross-user lookups.
    # Lets public surfaces ask "is the current user an admin?" with a single
    # nullable field check instead of catching a `guardAdmin` exception.
    # Mutations still live on `Mutation.admin`. See
    # `docs/architecture/authorization-admin.md`.
    admin: Admin
    # Cook membership probe — non-null only for the session's own cook user
    # (row in `Cooks` with `cookId` = `Users.userId`). Same nullable pattern as
    # `User.admin`; see `docs/architecture/authorization-admin.md`. Profile
    # switches cook vs customer UI on this field.
    cook: Cook
    # Own-user only. Active sessions (`wasTerminatedAt` null) for account
    # settings. Null/empty when the parent is not the requesting user — nullable
    # so identity-only `User` selections (chat authors, etc.) stay lightweight.
    sessions: [UserSession!]
    # Own-user only. Registered passkeys for account settings. Null/empty when
    # the parent is not the requesting user. Never exposes credential material.
    passkeys: [AuthPasskey!]
    # Own-user only. TOTP authenticator when enrolled (pending or confirmed).
    # Null when the parent is not the requesting user or none exists.
    timeBasedOneTimePassword: AuthTimeBasedOneTimePassword
    # Own-user acceptance timestamps (null until accept / admin-created).
    lastAcceptedPrivacyPolicy: DateTime
    lastAcceptedTerms: DateTime
    # Own-user only. Computed pending legal docs vs lastAccepted*. Null when
    # the parent is not the requesting user.
    legalAcceptance: UserLegalAcceptance
    # Own-user booking requests. Null when the parent is not the requesting
    # user (identity-only `User` selections). Empty until create/list commands.
    bookingRequests: [UserBookingRequest!]
    bookingRequest(bookingRequestId: ID!): UserBookingRequest
    # Own-user previous event venues from booking requests. Null when the parent
    # is not the requesting user. Empty when none. Newest first, deduped, capped.
    # Lean alternative to hydrating `bookingRequests` for form quick-select.
    previousEventAddresses: [CookTravelOriginAddress!]

    # Own-user support cases (general + booking-linked). Null when the parent
    # is not the requesting user. Newest first.
    supportRequests: [UserSupportRequest!]
    supportRequest(supportRequestId: ID!): UserSupportRequest
    # Own-user assistant chats. Null when the parent is not the requesting
    # user. List is lazy — sidebars only query when "All chats" opens.
    # See docs/features/assistant-sidebar.md.
    assistantChats(criterion: UserAssistantChatCriterion!): [Chat!]
    assistantChat(chatId: ID!): Chat
    # Own-user gift-card purchases (`buyerUserId`). Null when the parent is
    # not the requesting user. Newest first. See docs/features/gift-card-purchase.md.
    giftCards: [UserGiftCard!]
}

# Filter + pagination for `User.assistantChats`. Optional `surface` scopes to
# one rail (admin / customer / cook). Optional `searchText` matches title
# (case-insensitive contains). Default sort `lastModifiedAt` desc.
input UserAssistantChatCriterion {
    skip: Int! = 0
    take: Int! = 25
    surface: ChatSurface
    searchText: String
}

# Safe session summary for account settings (not the request `Session` type).
type UserSession {
    sessionId: ID!
    createdAt: DateTime!
    lastInteractionAt: DateTime!
    userAgent: String
    isCurrent: Boolean!
}

# Safe passkey summary — never `publicKey` / `credentialId`.
type AuthPasskey {
    authPasskeyId: ID!
    deviceType: String
    backedUp: Boolean!
    createdAt: DateTime!
}

# Safe TOTP summary for account settings — never the secret or recovery plaintext.
type AuthTimeBasedOneTimePassword {
    authTimeBasedOneTimePasswordId: ID!
    confirmedAt: DateTime
    recoveryCodesRemaining: Int!
    createdAt: DateTime!
}

# Returned once from enroll start — secret material for QR / manual entry.
type AuthTotpEnrollStartResult {
    otpauthUrl: String!
    secret: String!
}

# Returned once from enroll confirm — store recovery codes offline.
type AuthTotpEnrollConfirmResult {
    recoveryCodes: [String!]!
}

# Presence of a pending second-factor challenge after primary auth.
type AuthTotpChallenge {
    expiresAt: DateTime!
}

# Cook read namespace — resolved only when `User.cook` is non-null (session's
# own user has a `Cooks` row). `cookId` (= `Users.userId`) is the identity /
# presence probe; domain child fields hang beside it. Same 1:1 membership
# pattern as `Admin`. Soft-deleted meals / menus (`deletedAt`) are never
# returned here — see `AdminCookMeal` / `AdminCookMenu` for admin views.

# Where a cook meal is used (inventory menus vs offer-copied menus) and whether
# soft-delete would leave a course with zero meal options. See cook-meals.md.
type CookMealRelationshipMenu {
    menuId: ID!
    menuTitle: String!
    courseTitle: String!
    blocksDeletion: Boolean!
}

type CookMealRelationshipBookingRequestOffer {
    bookingRequestOfferId: ID!
    bookingRequestUserName: String!
    bookingRequestDateTime: DateTime!
    menuTitle: String!
    courseTitle: String!
    blocksDeletion: Boolean!
}

type CookMealRelationships {
    menus: [CookMealRelationshipMenu!]!
    offers: [CookMealRelationshipBookingRequestOffer!]!
    deletionBlockedByRelationships: Boolean!
}

type CookMeal {
    mealId: ID!
    title: String!
    description: String!
    imageFileUploadId: ID
    imageUrl: String
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
    relationships: CookMealRelationships!
}

# One course on a cook menu. Soft-deleted meals are omitted from `mealOptions`.
type CookMenuCourse {
    courseId: ID!
    title: String!
    mealSelectionLimit: Int
    mealOptions: [CookMeal!]!
}

# Booking-request context for an offer-scoped `CookMenu` copy. Null on library
# (inventory) menus. `status` drives whether the cook may still edit the copy.
type CookMenuOfferContext {
    bookingRequestOfferId: ID!
    bookingRequestDateTime: DateTime!
    customerFirstName: String!
    status: BookingRequestOfferStatus!
}

# Cook-owned menu. Soft-deleted menus never appear here — see `AdminCookMenu`.
# `copyOfMenuId` is set on offer-scoped copies (points at the inventory source).
# `bookingRequestOfferId` / `offerContext` are set only on offer-scoped copies.
# `courseMealOptionImages` — public image URLs of non-deleted meal options that
# have a photo, ordered by course index then option index, deduped by URL.
type CookMenu {
    menuId: ID!
    title: String!
    description: String!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
    copyOfMenuId: ID
    bookingRequestOfferId: ID
    offerContext: CookMenuOfferContext
    # Living inventory template this offer copy was made from (`copyOfMenuId`).
    # Null on library menus, when unlinked, or when the template was deleted.
    templateMenu: CookMenu
    courses: [CookMenuCourse!]!
    courseMealOptionImages: [String!]!
}

type CookTravelOriginAddress {
    displayText: String!
    latitude: Latitude!
    longitude: Longitude!
    addressLine1: String!
    addressLine2: String!
    city: String!
    postCode: String!
    state: String!
    country: String!
}

enum CookStripeStatus {
    EMPTY
    PREPARED
    COMPLETED
    ACTIVE_WAS_RESET
}

enum CookStripeOnboardingKind {
    ONBOARDING_URL
    ALREADY_COMPLETE
    NOT_APPROVED
}

type CookStripeOnboardingResult {
    kind: CookStripeOnboardingKind!
    # Present when `kind` is `ONBOARDING_URL` — absolute Stripe Account Link.
    url: String
}

type CookStripeDashboardResult {
    # Absolute Express dashboard login URL, or null when the wallet is inactive.
    url: String
}

# Cook-facing buckets for Stripe Account `requirements.*` keys — never expose raw keys.
enum CookStripeRequirementCategory {
    IDENTITY_VERIFICATION
    BANK_ACCOUNT
    TERMS_OF_SERVICE
    BUSINESS_DETAILS
    PERSONAL_DETAILS
    OTHER
}

enum CookStripeDisabledReason {
    PAST_DUE
    PENDING_VERIFICATION
    REJECTED
    LISTED
    OTHER
}

# Live `accounts.retrieve` snapshot for the wallet page. Null when no Connect
# account or Stripe retrieve fails. Not on userUpdates (would hit Stripe every push).
type CookStripeAccountDetails {
    detailsSubmitted: Boolean!
    chargesEnabled: Boolean!
    payoutsEnabled: Boolean!
    disabledReason: CookStripeDisabledReason
    currentlyDue: [CookStripeRequirementCategory!]!
    pastDue: [CookStripeRequirementCategory!]!
    pendingVerification: [CookStripeRequirementCategory!]!
}

enum CookStripeBalanceTransactionKind {
    PAYMENT
    PAYOUT
    TRANSFER
    FEE
    ADJUSTMENT
    OTHER
}

enum CookStripeBalanceTransactionStatus {
    AVAILABLE
    PENDING
}

# Live Connect balance + recent balance transactions for `/profile/wallet`.
# Null when no Connect account or Stripe retrieve fails. Not on userUpdates.
type CookStripeWallet {
    availableCents: Int!
    pendingCents: Int!
    transactions: [CookStripeBalanceTransaction!]!
}

type CookStripeBalanceTransaction {
    balanceTransactionId: ID!
    kind: CookStripeBalanceTransactionKind!
    status: CookStripeBalanceTransactionStatus!
    # Net Connect balance change in EUR cents (credits positive, debits negative).
    netCents: Int!
    createdAt: DateTime!
    availableOn: DateTime!
    description: String
}

type LocationSuggestion {
    displayText: String!
    latitude: Latitude!
    longitude: Longitude!
    structuredAddress: CookTravelOriginAddress
}

type Cook {
    cookId: ID!
    isVisible: Boolean!
    isApprovedByAdmin: Boolean!
    canCreateOffers: Boolean!
    stripeStatus: CookStripeStatus!
    # Live Stripe requirements for `/profile/wallet`. Null without an account id.
    stripeAccountDetails: CookStripeAccountDetails
    # Live Connect balance + recent transactions for `/profile/wallet`. Null without an account id.
    stripeWallet: CookStripeWallet
    # Optional public display name; when set, `PublicCook.user.display` prefers it over firstName.
    stageName: String
    # Full address for the cook; public surfaces should only expose `city` (and
    # optionally city-level coords derived from it) — see cook-profile.md.
    exactTravelOriginAddress: CookTravelOriginAddress
    biography: String!
    biographySummary: String!
    # True while a pending cook-biography-summary-generate job exists for this
    # cook (created|retry|active). Derived from pg-boss via payload cookId — not a Cooks column.
    biographySummaryGenerating: Boolean!
    # Landscape brand mark for the public chef About section. Null → marketing benefits fallback.
    logo: FileUpload
    cuisineStyle: String
    cookingPhilosophy: String
    # Same aggregate as `PublicCook.rating` — published customer reviews on completed offers.
    # Used for cook self-preview of listing cards; `reviewCount: 0` when none.
    rating: PublicCookRating!
    travelExpensesAmount: Int!
    maximumTravelDistance: Int
    minimumPriceAmount: Int
    maximumPriceAmount: Int
    minimumParticipants: Int
    maximumParticipants: Int
    callSchedulingEnabled: Boolean!
    callDurationMinutes: Int!
    callAvailabilityRules: [CookCallAvailabilityRule!]!
    # Date-ranged exceptions (typically today → +90 days on the cook calls page).
    callAvailabilityExceptions(from: Date!, to: Date!): [CookCallAvailabilityException!]!
    # Derived free slots in [from, to). Cap ~60 days. Europe/Berlin wall clock.
    callSlots(from: DateTime!, to: DateTime!): [CookCallSlot!]!
    # Discovery-call bookings across offers. Omit criterion (or empty statuses
    # without from/to) → PENDING+CONFIRMED with endAt >= now. See
    # CookCallSlotBookingCriterion.
    callSlotBookings(criterion: CookCallSlotBookingCriterion): [CookCallSlotBooking!]!
    meals: [CookMeal!]!
    meal(mealId: ID!): CookMeal
    # One count per criterion, same order. Soft-deleted never counted. Empty
    # criteria / oversized batches throw. See CookMealCriterion.
    mealsCounts(criteria: [CookMealCriterion!]!): [Int!]!
    # Library (inventory) menus only — `bookingRequestOfferId` null. Offer pickers
    # depend on this. See `offerMenus` for per-offer copies.
    menus: [CookMenu!]!
    # Offer-scoped menu copies for this cook (non-deleted). See cook-menus.md.
    offerMenus: [CookMenu!]!
    # Library or offer-scoped menu owned by the cook (non-deleted).
    menu(menuId: ID!): CookMenu
    # One count per criterion, same order. Soft-deleted never counted. Empty
    # criteria / oversized batches throw. See CookMenuCriterion.
    menusCounts(criteria: [CookMenuCriterion!]!): [Int!]!
    # Open booking-request pool (travel radius / notified). See booking-offers.md.
    bookingRequests(criterion: CookBookingRequestFindManyCriterion): [CookBookingRequest!]!
    bookingRequest(bookingRequestId: ID!): CookBookingRequest
    # Deep-link lookup for pool detail/create. Reasons only when the cook is
    # pool-eligible (auto-approved + in radius, or admin-approved + notified).
    # Every denial collapses to CookBookingRequestNotFound (no existence oracle).
    # See booking-offers.md.
    bookingRequestLookup(bookingRequestId: ID!): CookBookingRequestLookupResult!
    # Cook offer inbox. Omit criterion / bucket = all offers (sidebar unread).
    # See booking-offers.md.
    bookingRequestOffers(criterion: CookBookingRequestOfferFindManyCriterion): [CookBookingRequestOffer!]!
    bookingRequestOffer(bookingRequestOfferId: ID!): CookBookingRequestOffer
    lastModifiedAt: DateTime!
}

# Result of `Cook.bookingRequestLookup` — stale email deep-links and live
# unavailability. Available carries the full request; other members expose no
# request PII. OfferAlreadyExists is the only member with an offer id.
union CookBookingRequestLookupResult =
    | CookBookingRequestAvailable
    | CookBookingRequestCanceled
    | CookBookingRequestTaken
    | CookBookingRequestExpired
    | CookBookingRequestOfferAlreadyExists
    | CookBookingRequestNotFound

type CookBookingRequestAvailable {
    bookingRequest: CookBookingRequest!
}

# Marker-only members use `_` (always null) because GraphQL object types need a field.
type CookBookingRequestCanceled {
    _: Boolean
}

type CookBookingRequestTaken {
    _: Boolean
}

type CookBookingRequestExpired {
    _: Boolean
}

type CookBookingRequestOfferAlreadyExists {
    bookingRequestOfferId: ID!
}

type CookBookingRequestNotFound {
    _: Boolean
}

# Filter for `Cook.mealsCounts`. Optional `searchText` matches title
# (case-insensitive contains). Soft-deleted meals are never counted.
input CookMealCriterion {
    searchText: String
}

# Filter for `Cook.menusCounts`. Same shape as `CookMealCriterion`.
input CookMenuCriterion {
    searchText: String
}

# Filter for `Cook.callSlotBookings`. Omit / empty `statuses` → PENDING +
# CONFIRMED. When statuses are default and both `from` / `to` are omitted,
# also require `endAt >= now` (upcoming). `from` / `to` bound `startAt`
# (inclusive / exclusive).
input CookCallSlotBookingCriterion {
    statuses: [CookCallSlotBookingStatus!]
    from: DateTime
    to: DateTime
}

# Recurring weekly discovery-call window. `dayOfWeek` is JS getDay() (0 = Sun … 6 = Sat).
# Minutes are inclusive start / exclusive end after midnight (0…1440).
type CookCallAvailabilityRule {
    cookCallAvailabilityRuleId: ID!
    dayOfWeek: Int!
    startMinuteOfDay: Int!
    endMinuteOfDay: Int!
}

enum CookCallAvailabilityExceptionType {
    BLOCK
    OPEN
}

# Per-date override. Null start/end = whole day. BLOCK removes; OPEN adds.
type CookCallAvailabilityException {
    cookCallAvailabilityExceptionId: ID!
    date: Date!
    type: CookCallAvailabilityExceptionType!
    startMinuteOfDay: Int
    endMinuteOfDay: Int
}

input CookCallAvailabilityRuleCreate {
    dayOfWeek: Int!
    startMinuteOfDay: Int!
    endMinuteOfDay: Int!
}

input CookCallAvailabilityExceptionCreate {
    date: Date!
    type: CookCallAvailabilityExceptionType!
    startMinuteOfDay: Int
    endMinuteOfDay: Int
}

# Required travel fields for create paths (`UserCreate.cook`,
# `AdminUserCreate.cook`, `UserMutation.cookCreate`). Biography / cuisine /
# philosophy are optional at create (filled later on chef profile). When set,
# `cuisineStyle` / `cookingPhilosophy` must be catalog values from
# `src/shared/cookProfile.ts`. `exactTravelOriginAddress` is the selected Places
# `displayText`; the server resolves and stores the structured payload.
input CookCreate {
    exactTravelOriginAddress: String!
    biography: String
    cuisineStyle: String
    cookingPhilosophy: String
    travelExpensesAmount: Int!
    maximumTravelDistance: Int!
}

# Patch for cook profile / travel / call settings. At least one field required.
# `exactTravelOriginAddress` is the selected Places `displayText` (full address);
# the server resolves it via Places and stores the structured payload.
# `cuisineStyle` / `cookingPhilosophy` must be values from the shared catalogs
# in `src/shared/cookProfile.ts` (or null to clear).
input CookUpdate {
    isVisible: Boolean
    # Optional public display name. Null / blank clears.
    stageName: String
    biography: String
    # Admin-only. Ignored on `CookMutation.update` (cooks cannot edit the summary;
    # it is AI-generated on cook biography save). Applied by `AdminMutation.cookUpdate`.
    biographySummary: String
    # Landscape brand mark. Null clears. Replaces and deletes the previous upload when set.
    logoFileUploadId: ID
    cuisineStyle: String
    cookingPhilosophy: String
    exactTravelOriginAddress: String
    travelExpensesAmount: Int
    maximumTravelDistance: Int
    minimumPriceAmount: Int
    maximumPriceAmount: Int
    minimumParticipants: Int
    maximumParticipants: Int
    callSchedulingEnabled: Boolean
    callDurationMinutes: Int
}

# Create payload for cook meals (assistant tools + future forms). When omitted
# on `mealCreate`, the command still inserts a draft with a placeholder title.
input CookMealCreate {
    title: String!
    description: String
}

# Patch for cook meal edits. At least one field required. `imageFileUploadId: null`
# clears the image; `publishedAt: null` unpublishes. Soft-delete is a separate
# `mealDelete` mutation — `deletedAt` is never on this input or on `CookMeal`.
input CookMealUpdate {
    title: String
    description: String
    imageFileUploadId: ID
    publishedAt: DateTime
}

# Course payload for menu create/update. `mealIds` order is the option order.
# `mealSelectionLimit` null = single-select; only valid when ≥2 options and 2…N.
input CookMenuCourseInput {
    title: String!
    mealIds: [ID!]!
    mealSelectionLimit: Int
}

# Patch for cook menu edits. At least one field required. When `courses` is set,
# the full course tree is replaced. Soft-delete is a separate `menuDelete`.
input CookMenuUpdate {
    title: String
    description: String
    publishedAt: DateTime
    courses: [CookMenuCourseInput!]
}

# AI menu suggestion — course with resolved meal ids (existing and newly
# inserted drafts). See `menuSuggestionFromText` / `menuTitleDescriptionSuggest`.
type CookMenuCourseSuggestion {
    title: String!
    mealIds: [ID!]!
}

type CookMenuSuggestion {
    title: String!
    description: String!
    courses: [CookMenuCourseSuggestion!]!
}

# Cook write namespace — gated by `guardCookMutation` (session user has a `Cooks`
# row). Stamps `cookId` (= `Users.userId`) onto the parent in TypeScript only
# (see `extensions.ts`) for downstream commands.
type CookMutation {
    update(input: CookUpdate!): MutationResult!
    stripeOnboardingStart(returnUrl: String!, refreshUrl: String!): CookStripeOnboardingResult!
    stripeStatusSync: MutationResult!
    stripeDashboardUrlCreate: CookStripeDashboardResult!
    # Creates a meal. Omit `meal` for a draft placeholder title; pass
    # `CookMealCreate` to set title/description. Returns `mealId` as `referenceId`.
    mealCreate(meal: CookMealCreate): MutationResult!
    mealUpdate(mealId: ID!, meal: CookMealUpdate!): MutationResult!
    # Soft-delete — stamps `deletedAt`. Row stays for admin inspection.
    mealDelete(mealId: ID!): MutationResult!
    # Creates a draft menu (placeholder title, three empty default courses).
    # Returns `menuId` as `referenceId`.
    menuCreate: MutationResult!
    # Library menus: title / description / courses / publishedAt.
    # Offer-scoped copies: title / description / courses while the offer is still
    # negotiable; `publishedAt` is rejected. Soft-delete stays inventory-only.
    menuUpdate(menuId: ID!, menu: CookMenuUpdate!): MutationResult!
    # Soft-delete — stamps `deletedAt`. Row stays for admin inspection.
    # Inventory menus only.
    menuDelete(menuId: ID!): MutationResult!
    # Deep-copies courses + meal options into a new draft. Returns new `menuId`.
    # Inventory source only.
    menuCopy(menuId: ID!): MutationResult!
    # Overwrite the inventory template (`copyOfMenuId`) with this offer-scoped
    # copy's title, description, and courses. Returns the template `menuId`.
    menuSyncToTemplate(menuId: ID!): MutationResult!
    # AI: derive a structured menu from free text. Inserts NEW_MEAL drafts;
    # returns title / empty description / courses with mealIds.
    menuSuggestionFromText(text: String!): CookMenuSuggestion!
    # AI: assemble a menu from the cook's meal inventory (optional free-text
    # brief). Inserts NEW_MEAL drafts; returns title / description / courses
    # with mealIds. Own AiGenerations kind — see ai-generations.md.
    menuSuggestionFromInventory(brief: String): CookMenuSuggestion!
    # AI: suggest SEO title + first-person description from current fields +
    # courses. Returns empty `courses`.
    menuTitleDescriptionSuggest(currentTitle: String, currentDescription: String, courses: [CookMenuCourseInput!]!): CookMenuSuggestion!
    # AI: draft or improve a first-person biography. Returns suggestion only;
    # client shows a side-by-side review; Accept fills the form; Save via
    # `update` queues biography-summary regeneration.
    biographySuggest(currentBiography: String!): String!
    # Weekly call windows — max 3 per cook. Returns rule id as `referenceId`.
    callAvailabilityRuleCreate(rule: CookCallAvailabilityRuleCreate!): MutationResult!
    callAvailabilityRuleDelete(cookCallAvailabilityRuleId: ID!): MutationResult!
    # Per-date BLOCK/OPEN exceptions. Returns exception id as `referenceId`.
    callAvailabilityExceptionCreate(exception: CookCallAvailabilityExceptionCreate!): MutationResult!
    callAvailabilityExceptionDelete(cookCallAvailabilityExceptionId: ID!): MutationResult!
    # Booking-request pool / offers — see docs/features/booking.md.
    bookingRequestOpen(bookingRequestId: ID!): MutationResult!
    # Re-run AI menu evaluation + inventory menu generation for a pool request
    # (gated by AI_MENU_EVALUATION). Sets menuEvaluationLoading until the job finishes.
    bookingRequestMenuEvaluationRefresh(bookingRequestId: ID!): MutationResult!
    # Materialize the stored AI-generated menu recommendation into a draft
    # inventory menu. Returns new menuId as referenceId.
    bookingRequestGeneratedMenuApply(bookingRequestId: ID!): MutationResult!
    bookingRequestDecline(bookingRequestId: ID!, reason: String!): MutationResult!
    bookingRequestOfferCreate(input: BookingRequestOfferCreate!): MutationResult!
    # Re-accept after customer material changes reset cookAccepted.
    bookingRequestOfferAccept(bookingRequestOfferId: ID!): MutationResult!
    bookingRequestOfferDecline(bookingRequestOfferId: ID!, reason: String!): MutationResult!
    # Accept a pending participant amendment (reprice + Stripe delta). Gated by
    # BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT.
    bookingRequestOfferParticipantAmendmentAccept(bookingRequestOfferId: ID!): MutationResult!
    bookingRequestOfferParticipantAmendmentDecline(bookingRequestOfferId: ID!): MutationResult!
    # Mark groceries / preparations done — locks further customer amendments.
    bookingRequestOfferPreparationsComplete(bookingRequestOfferId: ID!): MutationResult!
    bookingRequestOfferPriceUpdate(input: BookingRequestOfferPriceUpdate!): MutationResult!
    bookingRequestOfferSuggestedMenusUpdate(input: BookingRequestOfferSuggestedMenusUpdate!): MutationResult!
    # Append a free-text negotiation message (`COOK_MESSAGE_SIMPLE` event).
    # `referenceId` is the new `bookingRequestOfferEventId`.
    bookingRequestOfferChatMessageCreate(bookingRequestOfferId: ID!, message: String!, fileUploadIds: [ID!]): MutationResult!
    # Apply or clear an emoji reaction on a `*_MESSAGE_SIMPLE` event. Empty `emoji`
    # clears. Gated by `BOOKING_REQUEST_OFFER_CHAT_REACTIONS`. No unread / email.
    # `referenceId` is the target event id.
    bookingRequestOfferChatMessageReactionUpsert(bookingRequestOfferEventId: ID!, emoji: String!): MutationResult!
    # Clears `cookUnreadNotificationCount` on this cook's offer (call when opening chat).
    bookingRequestOfferUnreadNotificationCountReset(bookingRequestOfferId: ID!): MutationResult!
    # Call-slot booking — cook proposes any free time (overlap-checked).
    bookingRequestOfferCallSlotRequest(bookingRequestOfferId: ID!, startAt: DateTime!, cookMessage: String): MutationResult!
    bookingRequestOfferCallSlotConfirm(cookCallSlotBookingId: ID!): MutationResult!
    bookingRequestOfferCallSlotDecline(cookCallSlotBookingId: ID!, reason: String): MutationResult!
    bookingRequestOfferCallSlotCancel(cookCallSlotBookingId: ID!, reason: String): MutationResult!
    # Ad-hoc / join-window LiveKit call.
    bookingRequestOfferCallCreate(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallJoin(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallLeave(bookingRequestOfferCallRoomParticipantId: ID!): MutationResult!
    # Cook's own testimonial about the platform experience for a completed
    # offer. Low `rating` (<= 3) defaults to `PENDING_REVIEW` instead of
    # auto-publishing. Returns `cookTestimonialId` as `referenceId`.
    bookingRequestOfferTestimonialCreate(input: CookBookingRequestOfferTestimonialCreate!): MutationResult!
}

# --- Booking requests / offers -------------------------------------------------
# Role-scoped types (User / Cook / Admin) + shared enums / participants / costs.
# Offer timeline is `BookingRequestOfferEvents` in DB; GraphQL projects it onto
# `messages: [HumanChatMessage!]!` (`ChatMessageUser` + `ChatMessageBookingRequestOfferEvent`).
# See docs/architecture/booking.md and docs/features/booking.md.

enum BookingRequestStatus {
    WAITING_FOR_OFFERS
    OFFERS_WAITING_FOR_REVIEW
    DEPOSIT_PAYMENT_PENDING
    PAYMENT_PULL_PENDING
    EVENT_PENDING
    COMPLETED
    EXPIRED
    CANCELED
}

enum BookingRequestPriceClassType {
    LOW
    MEDIUM
    HIGH
}

enum BookingRequestPublicationStatus {
    PUBLICATION_BLOCKED_BY_ADMIN_REVIEW
    PUBLICATION_AUTO_APPROVED
    PUBLICATION_APPROVED_BY_ADMIN
}

enum BookingRequestParticipantType {
    ADULT
    DISCOUNTED
}

enum BookingRequestOfferStatus {
    USER_NEEDS_TO_ACCEPT
    COOK_NEEDS_TO_ACCEPT
    USER_REQUESTED_MENU_CHANGES
    USER_DECLINED
    COOK_DECLINED
    USER_CHOOSE_DIFFERENT_OFFER
    USER_NEEDS_DEPOSIT_PAYMENT
    PAYMENT_PULL_PENDING
    EVENT_PENDING
    COMPLETED
    EXPIRED
    CANCELED
}

enum BookingRequestOfferPaymentStatus {
    EMPTY
    SETUP
    PAYED
    TRANSFERRED
    FAILED
    PAYED_OUT_OF_SYSTEM
}

enum BookingRequestOfferPaymentDataType {
    SETUP_INTENT
    PAYMENT_INTENT
}

enum CookCallSlotBookingStatus {
    PENDING
    CONFIRMED
    CANCELED
    COMPLETED
    DECLINED
}

enum CookCallSlotBookingActor {
    CUSTOMER
    COOK
}

type CostLineItem {
    title: String!
    # Integer cents. Discounts are negative.
    amountCents: Int!
    subLineItems: [CostLineItem!]
}

type CostBreakdown {
    lineItems: [CostLineItem!]!
    total: CostLineItem
    totalPerPerson: CostLineItem
    totalBeforeDiscount: CostLineItem
}

type BookingRequestParticipant {
    bookingRequestParticipantId: ID!
    type: BookingRequestParticipantType!
    name: String!
    restrictions: [String!]!
    createdAt: DateTime!
}

type BookingRequestOfferConfiguredMenuMeal {
    mealTitle: String!
    mealDescription: String!
    mealImageUrl: String
}

type BookingRequestOfferConfiguredMenuCourse {
    title: String!
    meals: [BookingRequestOfferConfiguredMenuMeal!]!
}

type BookingRequestOfferConfiguredMenu {
    menuId: ID
    title: String!
    description: String!
    courses: [BookingRequestOfferConfiguredMenuCourse!]!
}

type BookingRequestOfferPayment {
    clientSecret: String!
    publishableKey: String!
    type: BookingRequestOfferPaymentDataType!
}

# Pending post–dual-accept participant amendment (cook-gated). See
# docs/features/booking-offer-participant-amendment.md.
type BookingRequestOfferParticipantAmendmentParticipant {
    type: BookingRequestParticipantType!
    name: String!
    restrictions: [String!]!
}

type BookingRequestOfferParticipantAmendment {
    requestedAt: DateTime!
    participants: [BookingRequestOfferParticipantAmendmentParticipant!]!
    menuPriceCentsBefore: Int!
    menuPriceCentsAfter: Int!
    totalCentsCustomerBefore: Int!
    totalCentsCustomerAfter: Int!
    payoutCentsCookBefore: Int!
    payoutCentsCookAfter: Int!
}

type CookCallSlotBookingCustomer {
    display: String!
}

type CookCallSlotBooking {
    cookCallSlotBookingId: ID!
    cookId: ID!
    userId: ID!
    bookingRequestOfferId: ID!
    startAt: DateTime!
    endAt: DateTime!
    status: CookCallSlotBookingStatus!
    initiator: CookCallSlotBookingActor!
    customerMessage: String
    cookMessage: String
    declineReason: String
    canceledBy: CookCallSlotBookingActor
    canceledReason: String
    # LiveKit room created during this slot's join window (nullable).
    videoCallRoomId: ID
    customer: CookCallSlotBookingCustomer!
    createdAt: DateTime!
    lastModifiedAt: DateTime!
}

# Derived free discovery-call slot (not persisted).
type CookCallSlot {
    startAt: DateTime!
    endAt: DateTime!
}

enum BookingRequestOfferCallRoomStatus {
    ACTIVE
    ENDED
}

enum BookingRequestOfferCallRecordingStatus {
    PENDING
    EGRESS_COMPLETE
    TRANSCRIBING
    COMPLETED
    FAILED
}

type BookingRequestOfferCallTranscriptSegment {
    startedAtMs: Int!
    endedAtMs: Int!
    text: String!
    speakerLabel: String
}

# Admin-only call audio + transcript (see docs/features/call-recordings.md).
type BookingRequestOfferCallRecording {
    bookingRequestOfferCallRecordingId: ID!
    bookingRequestOfferCallRoomId: ID!
    status: BookingRequestOfferCallRecordingStatus!
    mediaType: String
    byteSize: Int
    transcriptText: String
    transcriptSegments: [BookingRequestOfferCallTranscriptSegment!]
    # Same-origin admin audio stream (`/api/admin/call-recordings/:id/audio`).
    audioUrl: String
    errorMessage: String
    createdAt: DateTime!
    completedAt: DateTime
}

type BookingRequestOfferCallRoom {
    bookingRequestOfferCallRoomId: ID!
    bookingRequestOfferId: ID!
    livekitRoomName: String!
    status: BookingRequestOfferCallRoomStatus!
    createdByUserId: ID!
    startedAt: DateTime!
    endedAt: DateTime
}

# JWT + URL returned by call create/join mutations.
type BookingRequestOfferCallTokenResult {
    token: String!
    url: String!
    bookingRequestOfferCallRoomParticipantId: ID!
}

# Admin calls hub row — live room and/or slot traffic (including declines/cancels).
type AdminCallListItem {
    kind: AdminCallListItemKind!
    bookingRequestId: ID!
    bookingRequestOfferId: ID!
    cookId: ID!
    customerUserId: ID!
    cookDisplayName: String!
    customerDisplayName: String!
    occasion: String!
    # Present when kind is LIVE or RECENT_ROOM.
    callRoom: BookingRequestOfferCallRoom
    # Present when kind is a slot status (PENDING / UPCOMING / RECENT_SLOT / DECLINED / CANCELED).
    callSlotBooking: CookCallSlotBooking
}

enum AdminCallListItemKind {
    LIVE
    PENDING
    UPCOMING
    RECENT_ROOM
    RECENT_SLOT
    DECLINED
    CANCELED
}

# Sortable columns for `Admin.callTraffic`. Default when omitted: `occurredAt` DESC.
# `occurredAt` = room `startedAt` or slot `startAt`; `createdAt` = room `startedAt` or slot `createdAt`.
enum AdminCallTrafficSortField {
    occurredAt
    createdAt
}

# Filter + pagination for `Admin.callTraffic` / `callTrafficCounts`. Optional
# `searchText` matches occasion, cook/customer first name / last name / email
# (case-insensitive contains). `kinds` omit or empty = all kinds. `initiators`
# only applies to slot kinds (rooms ignored when set). Optional `cookIds` /
# `userIds` (`IN`; omit or empty = no filter). Optional `range` filters by
# occurredAt (room startedAt / slot startAt). `skip` / `take` / `sort*` ignored
# by `callTrafficCounts`.
input AdminCallTrafficCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    kinds: [AdminCallListItemKind!]
    initiators: [CookCallSlotBookingActor!]
    cookIds: [ID!]
    userIds: [ID!]
    range: DateTimeRange
    sortField: AdminCallTrafficSortField
    sortDirection: SortDirection
}

# Per-cook call engagement for the overview leaderboard.
type AdminCallCookStat {
    cookId: ID!
    displayName: String!
    roomCount: Int!
    completedSlotCount: Int!
    declinedCount: Int!
    canceledCount: Int!
    pendingAwaitingCookCount: Int!
}

enum AdminCallCookStatSortField {
    roomCount
    completedSlotCount
    declinedCount
    pendingAwaitingCookCount
}

# Public identity for cross-user booking surfaces (customer sees cook; cook sees customer).
# `display` is first name, except nested under `PublicCook` where a non-empty
# `stageName` wins. No email / last name / phone.
type PublicUser {
    display: String!
    createdAt: DateTime!
    profilePicture: FileUpload
}

# Lean public cook profile — no street address, no Stripe. Nested on customer offers
# and under `Query.publicCook` for the public chefs listing / detail pages.
# See docs/features/public-chefs.md.
type PublicCook {
    cookId: ID!
    user: PublicUser!
    # True when `/chefs/$cookId` would resolve (visibility + admin approval). Nested on offers for link gating; listing still filters server-side.
    hasPublicProfile: Boolean!
    # Optional public display name; when set, `user.display` prefers it over firstName.
    stageName: String
    biography: String!
    biographySummary: String!
    # Landscape brand mark for the About section. Null → marketing benefits fallback.
    logo: FileUpload
    cuisineStyle: String
    cookingPhilosophy: String
    # City from travel origin only — never the full street address.
    city: String
    minimumPriceAmount: Int
    maximumPriceAmount: Int
    minimumParticipants: Int
    maximumParticipants: Int
    callSchedulingEnabled: Boolean!
    callDurationMinutes: Int!
    # Derived free slots in [from, to). Cap ~60 days. Europe/Berlin wall clock.
    callSlots(from: DateTime!, to: DateTime!): [CookCallSlot!]!
    # Published, non-deleted inventory meals only.
    meals: [PublicCookMeal!]!
    # Published customer reviews tied to a completed offer with this cook.
    testimonials: [CustomerTestimonial!]!
    # Aggregate rating built from `testimonials`. `reviewCount: 0` when none.
    rating: PublicCookRating!
}

type PublicCookMeal {
    mealId: ID!
    title: String!
    description: String!
    imageUrl: String
    publishedAt: DateTime
}

type PublicCookMenuCourse {
    courseId: ID!
    title: String!
    mealSelectionLimit: Int
    mealOptions: [PublicCookMeal!]!
}

type PublicCookMenu {
    menuId: ID!
    title: String!
    description: String!
    publishedAt: DateTime
    courses: [PublicCookMenuCourse!]!
    courseMealOptionImages: [String!]!
}

# --- Testimonials --------------------------------------------------------------
#
# Published rows only publicly ("PENDING_REVIEW" is admin-only). See
# docs/architecture/testimonials.md.

enum TestimonialPublicationStatus {
    PUBLISHED
    PENDING_REVIEW
}

# Discriminates which catalog a curated `CityTestimonials` / `PartnerTestimonials`
# / `OccasionTestimonials` junction row points at.
enum TestimonialType {
    COOK
    CUSTOMER
}

# Customer-authored testimonial. Optionally tied to the completed offer it was
# written about (`bookingRequestOfferTestimonialCreate`) — when tied, it also
# counts toward that offer's cook's public rating (`PublicCook.rating` /
# `PublicCook.testimonials`).
type CustomerTestimonial {
    customerTestimonialId: ID!
    authorName: String!
    location: String
    occasion: String
    body: String!
    imageUrls: [String!]!
    rating: Int
    publishedAt: DateTime
    createdAt: DateTime!
}

# Cook-authored testimonial about the platform experience (marketing quotes —
# e.g. `SectionChefTestimonials` / "become a chef" pages).
type CookTestimonial {
    cookTestimonialId: ID!
    authorName: String!
    location: String
    occasion: String
    body: String
    imageUrls: [String!]!
    rating: Int
    publishedAt: DateTime
    createdAt: DateTime!
}

union Testimonial = CustomerTestimonial | CookTestimonial

# Aggregate customer-review rating for a cook, built from published
# `CustomerTestimonial`s tied to one of that cook's completed offers.
type PublicCookRating {
    averageRating: Float
    reviewCount: Int!
}

# Curated, ordered testimonial on a public city page.
type CityTestimonial {
    index: Int!
    testimonial: Testimonial!
}

# Curated, ordered testimonial on a public partner page.
type PartnerTestimonial {
    index: Int!
    testimonial: Testimonial!
}

# Curated, ordered testimonial on a public occasion page.
type OccasionTestimonial {
    index: Int!
    testimonial: Testimonial!
}

# Empty/whitespace-only `authorName` / `location` / `occasion` fall back to the
# offer (customer/cook display name, event city, occasion) at read time — see
# `testimonialOfferFallbacksLoad.ts`.
input UserBookingRequestOfferTestimonialCreate {
    bookingRequestOfferId: ID!
    authorName: String
    location: String
    occasion: String
    body: String!
    rating: Int
    imageFileUploadIds: [ID!]
}

# Follow-up survey required when `rating < 5` — see `publicationStatusFromRating.ts`
# and `cookBookingRequestOfferTestimonialCreate.ts`.
input CookTestimonialLowRatingAnswersInput {
    whatWentWrong: String
    wouldRecommend: Boolean
    additionalFeedback: String
}

input CookBookingRequestOfferTestimonialCreate {
    bookingRequestOfferId: ID!
    authorName: String
    location: String
    occasion: String
    body: String
    rating: Int
    imageFileUploadIds: [ID!]
    # Required when `rating` is present and `< 5`.
    lowRatingAnswers: CookTestimonialLowRatingAnswersInput
}

# Shared money / status fields for role-scoped offer types.
# Customer offer — cook + public suggested menus.
type UserBookingRequestOffer {
    bookingRequestOfferId: ID!
    bookingRequestId: ID!
    cookId: ID!
    status: BookingRequestOfferStatus!
    paymentStatus: BookingRequestOfferPaymentStatus!
    userAccepted: Boolean
    cookAccepted: Boolean
    userDeclinationReason: String
    cookDeclinationReason: String
    userUnreadNotificationCount: Int!
    isPriceAutoAdjusted: Boolean
    userRequestedMenuAdjustments: Boolean
    travelDistanceKm: Float
    menuPriceCents: Int!
    travelExpensesCents: Int!
    paymentProviderFeeCents: Int!
    platformFeePercentCook: Int!
    platformFeePercentCustomer: Int!
    platformFeeCentsCook: Int!
    platformFeeCentsCustomer: Int!
    payoutCentsCook: Int!
    totalWithoutDiscountsCentsCustomer: Int!
    totalCentsCustomer: Int
    costBreakdown: CostBreakdown!
    configuredMenu: BookingRequestOfferConfiguredMenu
    payment: BookingRequestOfferPayment
    plannedPaymentPullDateTime: DateTime
    paymentDateTime: DateTime
    plannedPayoutDateTime: DateTime
    payoutDateTime: DateTime
    createdAt: DateTime!
    cook: PublicCook!
    suggestedMenus: [PublicCookMenu!]!
    callBookings: [CookCallSlotBooking!]!
    # Active LiveKit room for this offer, if any.
    activeCallRoom: BookingRequestOfferCallRoom
    # Negotiation transcript projected from `BookingRequestOfferEvents`.
    # Lazy field resolver — do not request on list cards.
    messages: [HumanChatMessage!]!
    # This customer's own review of the cook for this offer, if submitted.
    customerTestimonial: CustomerTestimonial
    # True once the offer is eligible for a review and none has been submitted
    # yet — drives a "leave a review" prompt on the offer page.
    testimonialMissing: Boolean!
    # Post–dual-accept groceries / prep lock (null when not marked).
    preparationsCompletedAt: DateTime
    # Pending cook-gated participant amendment, if any.
    participantAmendment: BookingRequestOfferParticipantAmendment
    # True when the customer may propose a participant amendment (ignores feature toggle).
    canRequestParticipantAmendment: Boolean!
}

# Lean request context on cook offer inbox rows — no nested `offers` (avoids recursion).
# `exactEventAddress` reveals street fields only after this offer is dual-accepted;
# otherwise post code / city / country (street lines empty). See booking-offers.md.
# `invoiceAddress` is returned only after dual-accept (null until the customer
# completes checkout). Cooks need it to invoice the host.
type CookBookingRequestOfferContext {
    bookingRequestId: ID!
    status: BookingRequestStatus!
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: CookTravelOriginAddress!
    priceClassType: BookingRequestPriceClassType
    # Soft guidance (travel-adjusted at 0 km here; offer UI may recompute with stored travel).
    suggestedOfferAmountCents: Int!
    minOfferAmountCents: Int
    maxOfferAmountCents: Int
    minOfferAmountHardCents: Int
    # Resolved for the cook: adjustedMessage ?? originalMessage (trimmed).
    message: String!
    preferences: [String!]!
    # Billing address from checkout — null until paid / dual-accept gate.
    invoiceAddress: InvoiceAddress
    expiresAt: DateTime
    canceledAt: DateTime
    participants: [BookingRequestParticipant!]!
    user: PublicUser!
}

# Cook offer inbox — suggested menus are cook-owned `CookMenu` copies.
type CookBookingRequestOffer {
    bookingRequestOfferId: ID!
    bookingRequestId: ID!
    cookId: ID!
    status: BookingRequestOfferStatus!
    paymentStatus: BookingRequestOfferPaymentStatus!
    userAccepted: Boolean
    cookAccepted: Boolean
    userDeclinationReason: String
    cookDeclinationReason: String
    cookUnreadNotificationCount: Int!
    isPriceAutoAdjusted: Boolean
    userRequestedMenuAdjustments: Boolean
    travelDistanceKm: Float
    menuPriceCents: Int!
    travelExpensesCents: Int!
    paymentProviderFeeCents: Int!
    platformFeePercentCook: Int!
    platformFeePercentCustomer: Int!
    platformFeeCentsCook: Int!
    platformFeeCentsCustomer: Int!
    payoutCentsCook: Int!
    totalWithoutDiscountsCentsCustomer: Int!
    totalCentsCustomer: Int
    costBreakdown: CostBreakdown!
    configuredMenu: BookingRequestOfferConfiguredMenu
    payment: BookingRequestOfferPayment
    plannedPaymentPullDateTime: DateTime
    paymentDateTime: DateTime
    plannedPayoutDateTime: DateTime
    payoutDateTime: DateTime
    createdAt: DateTime!
    suggestedMenus: [CookMenu!]!
    callBookings: [CookCallSlotBooking!]!
    activeCallRoom: BookingRequestOfferCallRoom
    bookingRequest: CookBookingRequestOfferContext!
    # Negotiation transcript projected from `BookingRequestOfferEvents`.
    # Lazy field resolver — do not request on list cards.
    messages: [HumanChatMessage!]!
    # This cook's own testimonial about the platform for this offer, if submitted.
    cookTestimonial: CookTestimonial
    # True once the offer is eligible for a review and none has been submitted
    # yet — drives a "leave a review" prompt on the offer page.
    testimonialMissing: Boolean!
    preparationsCompletedAt: DateTime
    participantAmendment: BookingRequestOfferParticipantAmendment
    # True when the cook may mark groceries / preparations done (ignores feature toggle).
    canCompletePreparations: Boolean!
}

# Admin offer — cook nested as AdminCook.
type AdminBookingRequestOffer {
    bookingRequestOfferId: ID!
    bookingRequestId: ID!
    cookId: ID!
    status: BookingRequestOfferStatus!
    paymentStatus: BookingRequestOfferPaymentStatus!
    userAccepted: Boolean
    cookAccepted: Boolean
    userDeclinationReason: String
    cookDeclinationReason: String
    userUnreadNotificationCount: Int!
    cookUnreadNotificationCount: Int!
    # Peer offer-chat messages awaiting admin review acknowledge (post-hoc).
    adminChatReviewPendingCount: Int!
    # Last time an admin acknowledged the offer-chat review queue for this offer.
    adminChatReviewedAt: DateTime
    isPriceAutoAdjusted: Boolean
    userRequestedMenuAdjustments: Boolean
    travelDistanceKm: Float
    menuPriceCents: Int!
    travelExpensesCents: Int!
    paymentProviderFeeCents: Int!
    platformFeePercentCook: Int!
    platformFeePercentCustomer: Int!
    platformFeeCentsCook: Int!
    platformFeeCentsCustomer: Int!
    payoutCentsCook: Int!
    totalWithoutDiscountsCentsCustomer: Int!
    totalCentsCustomer: Int
    costBreakdown: CostBreakdown!
    configuredMenu: BookingRequestOfferConfiguredMenu
    payment: BookingRequestOfferPayment
    plannedPaymentPullDateTime: DateTime
    paymentDateTime: DateTime
    plannedPayoutDateTime: DateTime
    payoutDateTime: DateTime
    # True when the cook can receive a Stripe bank payout (account present, active, payouts enabled).
    cookPayoutReady: Boolean!
    # Present when `cookPayoutReady` is false — drives admin copy (no raw Stripe errors).
    cookPayoutBlockedReason: AdminCookPayoutBlockedReason
    # Stripe Dashboard deep links from `paymentData` (null when the matching id is absent).
    stripePaymentIntentUrl: String
    stripeSetupIntentUrl: String
    createdAt: DateTime!
    cook: AdminCook!
    suggestedMenus: [CookMenu!]!
    callBookings: [CookCallSlotBooking!]!
    activeCallRoom: BookingRequestOfferCallRoom
    # Admin-only: audio recordings + transcripts for rooms on this offer.
    callRecordings: [BookingRequestOfferCallRecording!]!
    # Negotiation transcript projected from `BookingRequestOfferEvents`.
    # Lazy field resolver — do not request on list cards.
    messages: [HumanChatMessage!]!
    # Lazy — parent booking request (offer-chat review context). Prefer selecting
    # only the fields needed; avoid on dense offer list cards.
    bookingRequest: AdminBookingRequest!
    customerTestimonial: AdminCustomerTestimonial
    cookTestimonial: AdminCookTestimonial
    preparationsCompletedAt: DateTime
    participantAmendment: BookingRequestOfferParticipantAmendment
    canRequestParticipantAmendment: Boolean!
    canCompletePreparations: Boolean!
    # Lazy — pending pg-boss jobs for this offer (pull, reminders, chat notify, …).
    # Do not request on list cards.
    queuedJobs: [AdminQueuedJob!]!
}

# Pending pg-boss job state (created | retry | active). Completed / cancelled /
# failed are omitted from admin `queuedJobs` lookups.
enum AdminQueuedJobState {
    CREATED
    RETRY
    ACTIVE
}

# Live snapshot of a pending pg-boss job (admin booking ops + global jobs list).
# Deep-link ids are derived from the payload; the global `Admin.queuedJobs` list
# may also resolve offer / slot / room rows to a booking request id.
type AdminQueuedJob {
    jobId: ID!
    # pg-boss queue name (e.g. booking-request-offer-pull-payment).
    name: String!
    state: AdminQueuedJobState!
    startAfter: DateTime!
    createdOn: DateTime!
    # Job payload (kind, audience, cookCallSlotBookingId, …).
    data: JSON!
    bookingRequestId: ID
    bookingRequestOfferId: ID
    giftCardId: ID
    supportRequestId: ID
    userId: ID
    cookId: ID
    chatId: ID
}

# Why an admin cannot release a Stripe bank payout for a PAYED offer yet.
enum AdminCookPayoutBlockedReason {
    MISSING_STRIPE_ACCOUNT
    STRIPE_ACCOUNT_INACTIVE
    STRIPE_PAYOUTS_DISABLED
}

# Applied promo snapshot on a customer booking request (from `BookingRequests.promoCodeId`).
type UserBookingRequestPromoCode {
    promoCodeId: ID!
    redeemCode: String!
    amountCents: Int!
}

# Applied gift-card snapshot on a customer booking request (from `BookingRequests.giftCardId`).
type UserBookingRequestGiftCard {
    giftCardId: ID!
    redeemCode: String!
    balanceCents: Int!
}

# Per-offer travel fee preview when the customer considers a new venue on edit.
type UserBookingRequestOfferTravelImpact {
    bookingRequestOfferId: ID!
    cookDisplay: String!
    travelDistanceKmBefore: Float!
    travelDistanceKmAfter: Float!
    travelExpensesCentsBefore: Int!
    travelExpensesCentsAfter: Int!
}

type UserBookingRequest {
    bookingRequestId: ID!
    userId: ID!
    status: BookingRequestStatus!
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: CookTravelOriginAddress!
    priceClassType: BookingRequestPriceClassType
    originalMessage: String!
    adjustedMessage: String
    # publicationStatus is admin-only (AdminBookingRequest). Exposing it to customers is a planned feature.
    preferences: [String!]!
    invoiceAddress: InvoiceAddress
    expiresAt: DateTime
    canceledAt: DateTime
    cancellationReason: String
    createdAt: DateTime!
    participants: [BookingRequestParticipant!]!
    offers: [UserBookingRequestOffer!]!
    # Currently applied promo / gift card (mutually exclusive). Null when none.
    promoCode: UserBookingRequestPromoCode
    giftCard: UserBookingRequestGiftCard
    # Driving-distance travel preview for a proposed venue (edit form). Empty when
    # there are no offers or a cook lacks travel origin. Uses Routes API with
    # haversine fallback.
    travelImpact(exactEventAddress: UserBookingRequestExactEventAddressInput!): [UserBookingRequestOfferTravelImpact!]!
    # At most one support case per booking request. Null when none opened yet.
    supportRequest: UserSupportRequest
}

enum SupportRequestStatus {
    OPEN
    RESOLVED
}

# Lean booking summary on support cards (customer + admin).
type SupportRequestBookingRequestSummary {
    bookingRequestId: ID!
    occasion: String!
    dateTime: DateTime!
}

type UserSupportRequest {
    supportRequestId: ID!
    subject: String!
    status: SupportRequestStatus!
    userUnreadNotificationCount: Int!
    createdAt: DateTime!
    resolvedAt: DateTime
    bookingRequest: SupportRequestBookingRequestSummary
    # Projected onto `HumanChatMessage` (text-only `ChatMessageUser` rows).
    messages: [HumanChatMessage!]!
}

type AdminSupportRequest {
    supportRequestId: ID!
    userId: ID!
    subject: String!
    status: SupportRequestStatus!
    adminUnreadNotificationCount: Int!
    createdAt: DateTime!
    resolvedAt: DateTime
    bookingRequest: SupportRequestBookingRequestSummary
    customer: AdminUser!
    messages: [HumanChatMessage!]!
}

# Sortable columns for `Admin.supportRequests`. Default when omitted:
# `lastMessageAt` (newest message / activity first). `bookingDateTime` sorts
# soonest linked booking first (rows without a booking last).
enum AdminSupportRequestSortField {
    lastMessageAt
    createdAt
    bookingDateTime
}

# Filter + pagination for `Admin.supportRequests` / `supportRequestsCounts`.
# Optional `statuses` (`IN`); omit or empty = no status filter. Optional
# `hasAdminUnread` keeps rows with `adminUnreadNotificationCount > 0`. Optional
# `searchText` matches subject / supportRequestId / userId / customer first or
# last name, or full name in either order (case-insensitive contains). Optional
# `sortField` drives server `ORDER BY` (default `lastMessageAt`). When
# `unreadFirst` is true (default), rows with admin unread come before others,
# each group still ordered by `sortField`. `skip` / `take` / `sort*` /
# `unreadFirst` ignored by counts.
input AdminSupportRequestCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more support request ids).
    supportRequestIds: [ID!]
    statuses: [SupportRequestStatus!]
    hasAdminUnread: Boolean
    sortField: AdminSupportRequestSortField
    unreadFirst: Boolean = true
}

# Concierge WhatsApp inbox. One conversation per phone. Messages project onto
# `HumanChatMessage` (text-only `ChatMessageUser` rows). See docs/features/whatsapp.md.
type AdminWhatsAppConversation {
    whatsAppConversationId: ID!
    phoneNumber: PhoneNumber!
    displayName: String
    userId: ID
    lastMessageAt: DateTime!
    # Latest transcript body for inbox rows (empty when media-only / missing).
    lastMessagePreview: String!
    adminUnreadCount: Int!
    customerServiceWindowExpiresAt: DateTime
    createdAt: DateTime!
    customer: AdminUser
    messages: [HumanChatMessage!]!
}

# Filter + pagination for `Admin.whatsAppConversations` /
# `whatsAppConversationsCounts`. Optional `searchText` matches phone,
# WhatsApp display name, conversation id, linked user email / first or last
# name / full name in either order (case-insensitive contains).
input AdminWhatsAppConversationCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    hasAdminUnread: Boolean
    userId: ID
}

# Pool / open-request surface. `exactEventAddress` never includes street fields
# (post code / city / country only) — exact venue unlocks on the cook's dual-accepted offer.
type CookBookingRequest {
    bookingRequestId: ID!
    userId: ID!
    status: BookingRequestStatus!
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: CookTravelOriginAddress!
    priceClassType: BookingRequestPriceClassType
    # Soft price-class guidance (cents per person). Soft min/max are UX-only;
    # hard min is a promo customer-total floor. See bookingRequestOfferPriceGuidance.
    suggestedOfferAmountCents: Int!
    minOfferAmountCents: Int
    maxOfferAmountCents: Int
    minOfferAmountHardCents: Int
    # Resolved for the cook: adjustedMessage ?? originalMessage (trimmed).
    message: String!
    preferences: [String!]!
    invoiceAddress: InvoiceAddress
    expiresAt: DateTime
    canceledAt: DateTime
    cancellationReason: String
    createdAt: DateTime!
    participants: [BookingRequestParticipant!]!
    offers: [CookBookingRequestOffer!]!
    # Customer identity for the cook pool / detail surfaces.
    user: PublicUser!
    estimatedTravelDistanceKm: Float
    estimatedTravelExpensesCents: Int
    # Approximate cook payout at the soft suggested price per person (paid
    # participants, travel estimate, cook platform fee). Pool-detail UX.
    estimatedCookPayoutCents: Int!
    cookPoolDetails: BookingRequestCookPoolDetails
}

type AdminBookingRequestCookInTravelRadius {
    cook: AdminCook!
    estimatedTravelDistanceKm: Float!
    # Round-trip travel estimate (distance × cook rate × 2).
    estimatedTravelExpensesCents: Int!
    # Soft suggested menu price total (per-person suggestion × paid participants).
    suggestedMenuPriceCents: Int!
    notifiedAt: DateTime
}

# Pre-create cook picker for `/admin/booking-requests/create` (no request row yet).
type AdminCookInTravelRadiusPreview {
    cook: AdminCook!
    estimatedTravelDistanceKm: Float!
}

type AdminBookingRequest {
    bookingRequestId: ID!
    userId: ID!
    status: BookingRequestStatus!
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: CookTravelOriginAddress!
    priceClassType: BookingRequestPriceClassType
    # Soft price-class guidance (cents per person). Travel adjustment uses 0 km
    # here; admin offer UI recomputes with the selected cook's travel estimate.
    suggestedOfferAmountCents: Int!
    minOfferAmountCents: Int
    maxOfferAmountCents: Int
    minOfferAmountHardCents: Int
    originalMessage: String!
    adjustedMessage: String
    publicationStatus: BookingRequestPublicationStatus!
    preferences: [String!]!
    invoiceAddress: InvoiceAddress
    expiresAt: DateTime
    canceledAt: DateTime
    cancellationReason: String
    createdAt: DateTime!
    participants: [BookingRequestParticipant!]!
    offers: [AdminBookingRequestOffer!]!
    customer: AdminUser!
    # Dual-accepted cook when one exists; null otherwise.
    cook: AdminCook
    # Currently applied promo / gift card (mutually exclusive). Null when none.
    promoCode: UserBookingRequestPromoCode
    giftCard: UserBookingRequestGiftCard
    # Cooks who can create offers and cover the venue (publication approve picker).
    cooksInTravelRadius: [AdminBookingRequestCookInTravelRadius!]!
    # Lazy — pending pg-boss jobs across all offers on this request.
    # Do not request on list cards.
    queuedJobs: [AdminQueuedJob!]!
}

# Per-menu AI fit score on a cook↔request pool row. Recommendations only —
# unsuitable menus stay selectable. See docs/features/ai-menu-evaluation.md.
type BookingRequestCookMenuEvaluationMenu {
    menuId: ID!
    evaluationSummary: String!
    isSuitable: Boolean!
}

enum CookMenuSuggestionMealOptionType {
    EXISTING_MEAL
    NEW_MEAL
}

# Draft meal option inside `generatedMenu` (not yet inserted as NEW_MEAL).
type BookingRequestCookMenuEvaluationGeneratedMealOption {
    type: CookMenuSuggestionMealOptionType!
    mealId: ID
    title: String
    description: String
}

type BookingRequestCookMenuEvaluationGeneratedCourse {
