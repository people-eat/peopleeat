    # Absolute http(s) URL or site-relative path. Null / empty clears to default.
    firstSectionCtaUrl: String
    heroImageOverlay: Boolean!
    firstSectionImageOverlay: Boolean!
    howItWorksAlternativeMedia: Boolean!
    # Set to a promoCodeId to assign, or null to clear.
