}

type BookingRequestCookMenuEvaluation {
    evaluationSummary: String!
    menus: [BookingRequestCookMenuEvaluationMenu!]!
    generatedMenu: BookingRequestCookMenuEvaluationGeneratedMenu
}

type BookingRequestCookPoolDetails {
    declinedAt: DateTime
    declinationReason: String
    notifiedAt: DateTime
    firstOpenedAt: DateTime
    menuEvaluationLoading: Boolean!
    menuEvaluation: BookingRequestCookMenuEvaluation
}

input CookBookingRequestFindManyCriterion {
    onlyDeclined: Boolean
}

# Cook offer inbox tabs. Bucket is derived from offer status (not stored).
# Omit / null = no filter (all offers). See booking-offers.md.
enum CookBookingRequestOfferListBucket {
    ACTIVE
    COMPLETED
    ARCHIVED
}

input CookBookingRequestOfferFindManyCriterion {
    bucket: CookBookingRequestOfferListBucket
}

input BookingRequestOfferCreate {
    bookingRequestId: ID!
    # Optional — empty list is allowed (price-only offers).
    suggestedMenuIds: [ID!]!
    menuPriceCents: Int!
    # Optional cook note seeded as COOK_MESSAGE_SIMPLE after COOK_CREATED. Phone numbers rejected.
    message: String
}

input BookingRequestOfferPriceUpdate {
    bookingRequestOfferId: ID!
    menuPriceCents: Int!
}

input BookingRequestOfferSuggestedMenusUpdate {
    bookingRequestOfferId: ID!
    # Inventory menu ids to copy onto the offer (empty = price-only).
    suggestedMenuIds: [ID!]!
}

# Course meal picks for `bookingRequestOfferConfiguredMenuCreate`.
input BookingRequestOfferConfiguredMenuCourseSelectionInput {
    courseId: ID!
    mealIds: [ID!]!
}

# Admin replace payload for an existing offer configured-menu snapshot.
# Does not include `menuId` — the command preserves the stored value.
input BookingRequestOfferConfiguredMenuMealInput {
    mealTitle: String!
    mealDescription: String!
    mealImageUrl: String
}

input BookingRequestOfferConfiguredMenuCourseInput {
    title: String!
    meals: [BookingRequestOfferConfiguredMenuMealInput!]!
}

input BookingRequestOfferConfiguredMenuInput {
    title: String!
    description: String!
    courses: [BookingRequestOfferConfiguredMenuCourseInput!]!
}

# Aggregated booking requests for one occasion (overview ranking).
type AdminBookingRequestOccasionStat {
    occasion: String!
    count: Int!
    totalParticipants: Int!
}

# Aggregated booking-request creations for one calendar month (overview ranking).
type AdminBookingRequestCreationMonthStat {
    # First instant of the month (`date_trunc('month', createdAt)`).
    monthStart: DateTime!
    count: Int!
    totalParticipants: Int!
}

# Offer economics for the booking-requests overview. Averages and all-time totals
# ignore the chart picker; range totals use `range` when provided (payment time:
# `paymentDateTime`, else `createdAt`).
type AdminBookingRequestOfferEconomics {
    # Mean offers per request (requests with zero offers included). 0 when no requests.
    averageOffersPerRequest: Float!
    # Mean `menuPriceCents` across all offers. 0 when none.
    averageMenuPriceCents: Int!
    # Mean customer total on paid offers (`PAYED` / `TRANSFERRED` / `PAYED_OUT_OF_SYSTEM`).
    # Uses `totalCentsCustomer`, falling back to `totalWithoutDiscountsCentsCustomer`.
    averagePaidCustomerTotalCents: Int!
    # Mean platform fee (`platformFeeCentsCook` + `platformFeeCentsCustomer`) on paid offers.
    averagePaidPlatformRevenueCents: Int!
    # Sum of customer totals on paid offers (all-time).
    totalPaidCustomerTotalCents: Int!
    # Sum of platform fees on paid offers (all-time). Platform profit / win.
    totalPaidPlatformRevenueCents: Int!
    # Sum of customer totals on paid offers whose payment falls in `range`. 0 when range omitted.
    rangeTotalPaidCustomerTotalCents: Int!
    # Sum of platform fees on paid offers whose payment falls in `range`. 0 when range omitted.
    rangeTotalPaidPlatformRevenueCents: Int!
}

# Per-cook offer volume / dual-accept conversions (overview leaderboard).
type AdminBookingRequestCookOfferStat {
    cookId: ID!
    displayName: String!
    offerCount: Int!
    # Dual-accepted offers (`userAccepted` and `cookAccepted` both true).
    conversionCount: Int!
}

enum AdminBookingRequestCookOfferStatSortField {
    offerCount
    conversionCount
}

# Sortable columns for `Admin.bookingRequests`. Default when omitted: `createdAt` DESC.
enum AdminBookingRequestSortField {
    createdAt
    dateTime
    occasion
}

# Filter + pagination for `Admin.bookingRequests` / `bookingRequestsCounts`.
# Optional `searchText` matches occasion, original message, event city /
# display text, or customer email / first or last name / full name in either
# order (case-insensitive contains). Optional `userIds` scopes to those
# customers (`IN`); omit or empty = no user filter (user-detail tab passes one
# id; list multi-select can pass many). Optional `publicationStatuses` scopes
# to those values (`IN`); omit or empty = no publication filter (overview
# queue passes blocked-for-review). Optional `statuses` scopes to derived
# lifecycle values (`IN`); omit or empty = no status filter. SQL mirrors
# `bookingRequestStatusDerive` (canceledAt, expiry, offer count, dual-accepted
# payment status, event date vs now). Optional `createdAtFrom` / `createdAtTo`
# bound `BookingRequests.createdAt` (`>=` / `<=`); omit either end for an open
# bound (admin assistant “past X days” sets `createdAtFrom`). Optional
# `sortField` / `sortDirection` drive server `ORDER BY` (default `createdAt`
# DESC). `skip` / `take` / `sort*` are ignored by `bookingRequestsCounts`.
input AdminBookingRequestCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    userIds: [ID!]
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more booking request ids).
    bookingRequestIds: [ID!]
    # Pool / outreach filter: requests with a `BookingRequestCooks` row for these
    # cooks (`IN`). Omit or empty = no cook-pool filter. Orthogonal to `userIds`
    # (customer). Admin user-detail pool tab passes one cook id.
    cookIds: [ID!]
    # When true with non-empty `cookIds`, only rows whose pool stamp has
    # `notifiedAt` set. Ignored when `cookIds` is omitted or empty.
    notifiedOnly: Boolean
    publicationStatuses: [BookingRequestPublicationStatus!]
    statuses: [BookingRequestStatus!]
    # Filter to requests that currently apply this promo (`BookingRequests.promoCodeId`).
    promoCodeId: ID
    createdAtFrom: DateTime
    createdAtTo: DateTime
    sortField: AdminBookingRequestSortField
    sortDirection: SortDirection
}

# Filter + pagination for `Admin.bookingRequestOffers` / `bookingRequestOffersCounts`.
# Optional `cookIds` scopes to those cooks (`IN`); omit or empty = no cook filter
# (user-detail offers tab passes one id; list multi-select can pass many). Optional
# `searchText` matches cookId / bookingRequestId text. Optional `paymentStatuses`
# (`IN`); omit or empty = no payment-status filter. Optional
# `plannedPayoutDateTimeTo` keeps offers whose `plannedPayoutDateTime` is set and
# `<=` that instant (due-payout queue). Optional `hasAdminChatReviewPending` keeps
# offers with `adminChatReviewPendingCount > 0` (offer-chat review pipeline).
# `skip` / `take` ignored by counts.
input AdminBookingRequestOfferCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    cookIds: [ID!]
    paymentStatuses: [BookingRequestOfferPaymentStatus!]
    plannedPayoutDateTimeTo: DateTime
    hasAdminChatReviewPending: Boolean
}

# Result of acknowledging an offer-chat review item. `nextOfferId` is the next
# oldest pending offer in the pipeline (null when the queue is clear).
type AdminBookingRequestOfferChatReviewAcknowledgeResult {
    acknowledgedOfferId: ID!
    nextOfferId: ID
}

type AuthEmailOtp {
    authEmailOtpId: ID!
    emailAddress: EmailAddress!
    expiresAt: DateTime!
    # Null while awaiting the code; set after verify for a new email (registration ticket).
    verifiedAt: DateTime
    createdAt: DateTime!
}

enum GiftCardPaymentStatus {
    PREPARED
    PAYED
}

enum GiftCardPurchaseErrorCode {
    RECAPTCHA_FAILED
}

type InvoiceAddress {
    companyName: String
    firstName: String!
    lastName: String!
    country: String!
    city: String!
    postalCode: String!
    line1: String!
    line2: String!
}

input InvoiceAddressInput {
    # Required for Zod validation-schema typing (optional String → z.nullish() breaks Properties<> under Zod v4).
    # Clients send "" when the buyer has no company.
    companyName: String!
    firstName: String!
    lastName: String!
    country: String!
    city: String!
    postalCode: String!
    line1: String!
    line2: String!
}

type GiftCardPayment {
    clientSecret: String!
    publishableKey: String!
}

type GiftCard {
    giftCardId: ID!
    buyerEmail: EmailAddress!
    occasion: String!
    recipientName: String!
    message: String!
    originalBalanceCents: Int!
    balanceCents: Int!
    # Only populated once `paymentStatus` is `PAYED`.
    redeemCode: String
    paymentStatus: GiftCardPaymentStatus!
    # Only populated while `PREPARED` (Stripe Elements needs these).
    payment: GiftCardPayment
    invoiceAddress: InvoiceAddress
    expiresAt: DateTime!
    createdAt: DateTime!
}

# Own-user gift-card purchase row for profile history. Includes PDF download
# metadata when capture succeeded at pay time.
type UserGiftCard {
    giftCardId: ID!
    buyerEmail: EmailAddress!
    occasion: String!
    recipientName: String!
    message: String!
    originalBalanceCents: Int!
    balanceCents: Int!
    # Only populated once `paymentStatus` is `PAYED`.
    redeemCode: String
    paymentStatus: GiftCardPaymentStatus!
    invoiceAddress: InvoiceAddress
    invoiceFileUploadId: ID
    invoiceFileUpload: FileUpload
    voucherFileUploadId: ID
    voucherFileUpload: FileUpload
    expiresAt: DateTime!
    createdAt: DateTime!
}

type GiftCardPurchaseError {
    code: GiftCardPurchaseErrorCode!
}

input GiftCardCreate {
    balanceCents: Int!
    occasion: String!
    recipientName: String!
    message: String!
    # Buyer UI locale — persisted on the gift-card row and used for the redeem email.
    locale: Locale!
    recaptchaToken: String!
}

input GiftCardPay {
    giftCardId: ID!
    invoiceAddress: InvoiceAddressInput!
}

# Per-session marketing-cookie consent. Null on Session means undecided (show
# the banner). See docs/features/cookie-consent.md.
type SessionCookieSetting {
    googleAnalytics: Boolean!
    clarity: Boolean!
}

# Public discount preview for a redeem code (global promo or paid gift card).
# Booking-scoped (churn) promo codes are excluded — they are not redeemable by
# new customers / public form previews.
type SessionDiscount {
    redeemCode: String!
    name: String!
    amountCents: Int!
}

type Session {
    sessionId: ID!
    user: User
    authEmailOtp: AuthEmailOtp
    # Non-null while primary auth succeeded but TOTP/recovery is still required.
    authTotpChallenge: AuthTotpChallenge
    giftCard: GiftCard
    giftCardPurchaseError: GiftCardPurchaseError
    # Null until the visitor accepts all or mandatory-only cookies.
    cookieSetting: SessionCookieSetting
    # Enabled feature toggles (missing / disabled rows omitted). See
    # docs/features/admin-feature-toggles.md.
    activeFeatureToggleKeys: [FeatureToggleKey!]!
    # Google Places text search for address autocomplete. Empty `searchText`
    # returns []. Requires `GOOGLE_PLACES_API_KEY` on the server. When
    # `onlyFullAddresses` is true, only hits with a structured street address
    # are returned. Places failures are logged and yield [].
    locationSuggestions(searchText: String!, onlyFullAddresses: Boolean! = true): [LocationSuggestion!]!
    # Lookup a global promo or paid gift card by redeem code. Null when unknown,
    # expired, empty balance, or booking-request-scoped.
    discount(redeemCode: String!): SessionDiscount
}

type MutationResult {
    success: Boolean!
    referenceId: ID
}

type ChatMessageCreateResult {
    chatId: ID!
    chatTurnId: ID!
}

# User write namespace — gated by `guardUserMutation`. Stamps `userId` onto the
# parent in TypeScript only (see `extensions.ts`) for downstream commands.
input UserBookingRequestParticipantCreate {
    type: BookingRequestParticipantType!
    name: String!
    restrictions: [String!]!
}

# Structured venue for customer create. Same fields as cook travel origin; separate
# input name avoids ZodLazy circular typing with `CookTravelOriginAddress`.
input UserBookingRequestExactEventAddressInput {
    displayText: String!
    latitude: Latitude!
    longitude: Longitude!
    addressLine1: String!
    addressLine2: String!
    city: String!
    postCode: String!
    state: String!
    country: String!
}

input UserBookingRequestCreate {
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: UserBookingRequestExactEventAddressInput!
    originalMessage: String!
    preferences: [String!]!
    participants: [UserBookingRequestParticipantCreate!]!
    priceClassType: BookingRequestPriceClassType!
    # Optional promo / gift-card code applied on create (invalid code fails create).
    redeemCode: String
}

type UserMutation {
    userUpdate(user: UserUpdate!): MutationResult!
    # Self-serve account deletion: anonymizes the signed-in user (scrubs PII,
    # nulls email, revokes auth, hides cook profile, keeps relational history).
    # Customer-facing copy is "delete account". See docs/features/account.md.
    userAnonymize: MutationResult!
    terminateSessions(sessionIds: [ID!]!): MutationResult!
    # Stamps lastAcceptedPrivacyPolicy + lastAcceptedTerms to now(). Always
    # allowed while acceptance is pending (hard-gate exception).
    userLegalAccept: MutationResult!
    authPasskeyRegisterOptions: JSON!
    authPasskeyRegisterVerify(response: JSON!): MutationResult!
    authPasskeyDelete(authPasskeyId: ID!): MutationResult!
    # Start TOTP enrollment — returns otpauth URL + secret for QR / manual entry.
    # Replaces any unconfirmed row. See docs/architecture/authentication.md.
    authTotpEnrollStart: AuthTotpEnrollStartResult!
    # Confirm enrollment with a valid authenticator code; returns recovery codes once.
    authTotpEnrollConfirm(code: String!): AuthTotpEnrollConfirmResult!
    # Discard a pending (unconfirmed) TOTP enrollment.
    authTotpEnrollCancel: MutationResult!
    # Disable confirmed TOTP — requires a valid authenticator code (not recovery).
    authTotpDisable(code: String!): MutationResult!
    # Start an email change: OTP to the new address (reuses `AuthEmailOtps`).
    # Pending state is `Session.authEmailOtp`. See docs/features/account.md.
    emailAddressUpdateOtpRequest(emailAddress: EmailAddress!, locale: Locale!): MutationResult!
    # Verify the OTP and update `Users.emailAddress`.
    emailAddressUpdateOtpVerify(code: String!): MutationResult!
    # Creates a customer booking request + radius cook notifies.
    bookingRequestCreate(input: UserBookingRequestCreate!): MutationResult!
    # Apply or clear a promo / gift-card redeem code on an owned booking request.
    # Pass `redeemCode` null/empty to clear. Returns redeem code as `referenceId` on apply.
    bookingRequestDiscountUpdate(bookingRequestId: ID!, redeemCode: String): MutationResult!
    # Idempotent: create (or return) a €50 / 30-day promo scoped to this booking
    # request. `referenceId` is the redeem code.
    bookingRequestChurnPromoCodeCreate(bookingRequestId: ID!): MutationResult!
    # Cancel an owned booking request (sets `canceledAt` + reason).
    bookingRequestCancel(bookingRequestId: ID!, reason: String!): MutationResult!
    # Customer asks for a callback (churn win-back). Logs + publishes adminUpdates;
    # Slack parity deferred.
    bookingRequestRequestRecall(bookingRequestId: ID!): MutationResult!
    # Partial update while WAITING_FOR_OFFERS / OFFERS_WAITING_FOR_REVIEW.
    # Omit a scalar to leave it unchanged. `participants` always sent (material
    # changes reset cookAccepted). Optional `exactEventAddress` patches venue
    # (resets cookAccepted + recalculates travel fees on open offers).
    bookingRequestUpdate(
        bookingRequestId: ID!
        occasion: String
        dateTime: DateTime
        preferences: [String!]
        participants: [UserBookingRequestParticipantCreate!]!
        exactEventAddress: UserBookingRequestExactEventAddressInput
    ): MutationResult!
    # Dual-accept an offer and prepare Stripe (SetupIntent / PaymentIntent / €0 transfer).
    bookingRequestOfferAccept(bookingRequestOfferId: ID!): MutationResult!
    # Propose a post–dual-accept participant change (cook must accept). Gated by
    # BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT. Returns offer id as referenceId.
    bookingRequestOfferParticipantAmendmentCreate(
        bookingRequestOfferId: ID!
        participants: [UserBookingRequestParticipantCreate!]!
    ): MutationResult!
    # After Elements confirms SI/PI — advances paymentStatus and stores invoice address.
    bookingRequestOfferPaymentStatusUpdate(bookingRequestOfferId: ID!, invoiceAddress: InvoiceAddressInput!): MutationResult!
    bookingRequestOfferDecline(bookingRequestOfferId: ID!, reason: String!): MutationResult!
    bookingRequestOfferConfiguredMenuCreate(
        bookingRequestOfferId: ID!
        # Offer-scoped menu copy id (from `suggestedMenus`).
        menuId: ID!
        courseSelections: [BookingRequestOfferConfiguredMenuCourseSelectionInput!]!
    ): MutationResult!
    # Append a free-text negotiation message (`USER_MESSAGE_SIMPLE` event).
    # `referenceId` is the new `bookingRequestOfferEventId`.
    bookingRequestOfferChatMessageCreate(bookingRequestOfferId: ID!, message: String!, fileUploadIds: [ID!]): MutationResult!
    # Apply or clear an emoji reaction on a `*_MESSAGE_SIMPLE` event. Empty `emoji`
    # clears. Gated by `BOOKING_REQUEST_OFFER_CHAT_REACTIONS`. No unread / email.
    # `referenceId` is the target event id.
    bookingRequestOfferChatMessageReactionUpsert(bookingRequestOfferEventId: ID!, emoji: String!): MutationResult!
    # Clears `userUnreadNotificationCount` on an owned offer (call when opening chat).
    bookingRequestOfferUnreadNotificationCountReset(bookingRequestOfferId: ID!): MutationResult!
    # Call-slot booking — customer proposes a derived free slot.
    bookingRequestOfferCallSlotRequest(bookingRequestOfferId: ID!, startAt: DateTime!, customerMessage: String): MutationResult!
    bookingRequestOfferCallSlotConfirm(cookCallSlotBookingId: ID!): MutationResult!
    bookingRequestOfferCallSlotDecline(cookCallSlotBookingId: ID!, reason: String): MutationResult!
    bookingRequestOfferCallSlotCancel(cookCallSlotBookingId: ID!, reason: String): MutationResult!
    # Ad-hoc / join-window LiveKit call.
    bookingRequestOfferCallCreate(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallJoin(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallLeave(bookingRequestOfferCallRoomParticipantId: ID!): MutationResult!
    # Opens a support case (optional booking link). `referenceId` is the new
    # `supportRequestId`. At most one case per booking request.
    supportRequestCreate(subject: String!, messageBody: String!, bookingRequestId: ID, fileUploadIds: [ID!]): MutationResult!
    # Append a customer reply. Reopens `RESOLVED` → `OPEN`. `referenceId` is the
    # new `supportRequestMessageId`.
    supportRequestMessageCreate(supportRequestId: ID!, message: String!, fileUploadIds: [ID!]): MutationResult!
    # Clears `userUnreadNotificationCount` when opening the support chat.
    supportRequestUnreadNotificationCountReset(supportRequestId: ID!): MutationResult!
    # Customer's own review of the cook for a completed offer. Low `rating`
    # (<= 3) defaults to `PENDING_REVIEW` instead of auto-publishing. Returns
    # `customerTestimonialId` as `referenceId`.
    bookingRequestOfferTestimonialCreate(input: UserBookingRequestOfferTestimonialCreate!): MutationResult!
    # Inserts Cooks membership for the signed-in user (existing customers → chefs).
    cookCreate(input: CookCreate!): MutationResult!
    chatMessageCreate(
        chatId: ID
        message: String!
        fileUploadIds: [ID!]
        # Client-allocated idempotency key. Retries with the same id return
        # the existing turn instead of creating a duplicate.
        clientRequestId: ID!
        # Required when creating a new chat (`chatId` null). Ignored when
        # continuing an existing chat — the row's stamped surface wins.
        surface: ChatSurface!
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
    # Continue a turn paused on `promptUserForInput` (tool result = answers JSON).
    chatInputCollectionRespond(
        chatTurnId: ID!
        toolCallId: ID!
        # Opaque answers JSON matching the tool's slot schema (Zod + UI).
        answers: JSON!
        clientRequestId: ID!
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
    chatToolApprovalRespond(
        chatTurnId: ID!
        approvalId: String!
        approved: Boolean!
        reason: String
        clientRequestId: ID!
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
    # Soft-delete an owned assistant chat. Hidden from owner lists; admin inspect
    # still sees it (`deletedAt`). `referenceId` is the `chatId`.
    chatDelete(chatId: ID!): MutationResult!
    # Owner rename. Non-empty title locks the auto-titler. Max 60 chars after trim.
    # `referenceId` is the `chatId`.
    chatTitleUpdate(chatId: ID!, title: String!): MutationResult!
    # Creates / upserts a session-owned PREPARED gift card + Stripe PaymentIntent.
    # Buyer email comes from the signed-in user. See docs/features/gift-card-purchase.md.
    giftCardCreate(input: GiftCardCreate!): MutationResult!
    # After Elements confirms the PaymentIntent — flips to PAYED, PDFs, email.
    giftCardPay(input: GiftCardPay!): MutationResult!
    # Re-capture voucher + receipt PDFs for a PAYED gift card owned by the
    # signed-in buyer. Soft-fails per PDF; success when at least one is written.
    # See docs/features/gift-card-purchase.md.
    giftCardPdfsRegenerate(giftCardId: ID!): MutationResult!
    # Cook-only write namespace. Throws when the session user is not a cook.
    cook: CookMutation!
}

# --- Chat assistant options --------------------------------------------------

input ChatAssistantOptions {
    requireToolCallApprovals: Boolean!
}

type Query {
    currentSession: Session!
    # Public latest-published legal documents (null when none published yet).
    publicLegal: PublicLegal!
    # Public content pages (published only).
    publicCity: PublicCityQuery!
    publicPartner: PublicPartnerQuery!
    publicOccasion: PublicOccasionQuery!
    publicBlogPost: PublicBlogPostQuery!
    # Visible, admin-approved cooks for the public chefs listing / detail pages.
    publicCook: PublicCookQuery!
    # Fixed-route SEO titles/descriptions (admin-editable WebPages rows).
    publicWebPage: PublicWebPageQuery!
}

type Mutation {
    authEmailOtpRequest(email: EmailAddress!, locale: Locale!): MutationResult!
    authEmailOtpVerify(email: EmailAddress!, code: String!): MutationResult!
    authEmailOtpDelete(authEmailOtpId: ID!): MutationResult!
    # After OTP verify for a new email (`AuthEmailOtp.verifiedAt` set). Creates
    # the Users row from the verified OTP email + profile input, then binds
    # session. Optional `input.cook` creates cook membership in the same write.
    userCreate(input: UserCreate!): MutationResult!
    authPasskeyAuthenticateOptions: JSON!
    authPasskeyAuthenticateVerify(response: JSON!): MutationResult!
    # Complete TOTP second factor after primary auth left `pendingTotpUserId`.
    # Accepts a 6-digit TOTP or an unused recovery code.
    authTotpVerify(code: String!): MutationResult!
    # Dismiss a pending TOTP challenge (clears pendingTotpUserId).
    authTotpChallengeDelete: MutationResult!
    # Cookie consent — upserts CookieSettings (GA + Clarity both true). Safe to
    # call again from the footer settings editor. See docs/features/cookie-consent.md.
    sessionCookieSettingAcceptAll: MutationResult!
    # Cookie consent — upserts CookieSettings (GA + Clarity both false).
    sessionCookieSettingAcceptMandatory: MutationResult!
    # Marketing newsletter subscribe (footer). Idempotent on email. See docs/features/newsletter.md.
    sessionNewsletterSubscriptionCreate(emailAddress: EmailAddress!, locale: Locale!): MutationResult!
    # First-party product analytics — pageview for the current session.
    # Soft-succeeds when the session is terminated. See docs/architecture/session-events.md.
    sessionWebPageVisitCreate(input: SessionWebPageVisitCreateInput!): MutationResult!
    # First-party product analytics — structured interaction (e.g. booking form step).
    sessionWebPageInteractionCreate(input: SessionWebPageInteractionCreateInput!): MutationResult!
    # Browser RUM ingest (Web Vitals / client GraphQL errors / route errors). Soft-succeeds.
    # See docs/architecture/observability.md.
    clientObservabilityReport(input: ClientObservabilityReportInput!): MutationResult!
    user: UserMutation!
    # Admin-only mutations, gated by `guardAdminMutation`.
    admin: AdminMutation!
}

input SessionWebPageVisitCreateInput {
    webPageKey: WebPageKey!
    path: String
    cityId: ID
    cookId: ID
    blogPostId: ID
    partnerId: ID
    occasionId: ID
    bookingRequestId: ID
}

input SessionWebPageInteractionCreateInput {
    webPageKey: WebPageKey!
    area: String!
    # Required for cook offer funnel (`cook_booking_request_offer`) steps.
    bookingRequestId: ID
    # JSON interaction payload. Funnels use
    # `{ type: "step_entered"|"step_completed", step: "…" }`.
    interaction: JSON!
}

enum ClientObservabilityKind {
    WEB_VITAL
    GRAPHQL_ERROR
    ROUTE_ERROR
}

enum ClientWebVitalName {
    LCP
    INP
    CLS
    FCP
    TTFB
}

input ClientObservabilityReportInput {
    kind: ClientObservabilityKind!
    # WEB_VITAL only.
    vitalName: ClientWebVitalName
    # WEB_VITAL numeric value (ms for timing vitals; unitless for CLS).
    value: Float
    # GRAPHQL_ERROR / ROUTE_ERROR message (truncated server-side).
    message: String
    # GRAPHQL_ERROR operation name.
    operationName: String
    # Locale-stripped path when known.
    path: String
    # ROUTE_ERROR optional TanStack route id.
    routeId: String
}

# One preferred-communication bucket for `Admin.userInsights`.
# `preferredCommunication` is null when the user has not set a preference.
type AdminUserPreferredCommunicationStat {
    preferredCommunication: UserPreferredCommunication
    count: Int!
}

# One locale bucket for `Admin.userInsights`.
type AdminUserLocaleStat {
    locale: Locale!
    count: Int!
}

# One IANA time-zone bucket for `Admin.userInsights`.
type AdminUserTimeZoneStat {
    timeZone: TimeZone!
    count: Int!
}

# Demographic / preference aggregates for the users overview. Excludes
# anonymized accounts. See docs/features/admin-users.md.
type AdminUserInsights {
    # Non-anonymized accounts (denominator for preference / locale / zone shares).
    accountCount: Int!
    # Median completed years of age among users with a birth date. Null when none.
    # Prefer this over `averageAge` when a few outliers would skew the mean.
    medianAge: Float
    # Mean completed years of age among users with a birth date. Null when none.
    averageAge: Float
    # Users contributing to age stats (non-null birth date, not anonymized).
    birthDateSampleSize: Int!
    preferredCommunication: [AdminUserPreferredCommunicationStat!]!
    locales: [AdminUserLocaleStat!]!
    # Sorted by count descending. Cap is applied in the query (top zones).
    timeZones: [AdminUserTimeZoneStat!]!
}

# Upcoming birthday row for the users overview list.
type AdminUserUpcomingBirthday {
    userId: ID!
    firstName: String!
    lastName: String!
    # Original birth date (year included).
    birthDate: Date!
    # Next calendar occurrence of the birthday (today or later).
    nextBirthday: Date!
}

# Admin-only user row for operator lists and detail. Privileged fields stay on
# this access-path type rather than widening the public `User` surface.
type AdminUser {
    userId: ID!
    # Null when the account has been anonymized. See docs/features/account.md.
    emailAddress: EmailAddress
    # Prior addresses archived on email-change verify. Never on public `User`.
    # Cleared on anonymization.
    previousEmailAddresses: [EmailAddress!]!
    firstName: String!
    lastName: String!
    # ACTIVE | BANNED | ANONYMIZED. Admin-only; not on public `User`.
    status: UserStatus!
    phoneNumber: PhoneNumber
    birthDate: Date
    preferredCommunication: UserPreferredCommunication
    # Profile language — same as public `User.locale`.
    locale: Locale!
    # IANA zone — same as public `User.timeZone`.
    timeZone: TimeZone!
    # Current profile picture. Same bytes as public `User.profilePicture`.
    profilePicture: FileUpload
    # Operator-only free-text note. Never exposed on the public `User` type.
    adminNote: String!
    # Membership labels for this row. A user can carry more than one
    # (`admin` + `customer`, or `admin` + `cook`). See `AdminUserType`.
    types: [AdminUserType!]!
    createdAt: DateTime!
    # Present when the user has a `Cooks` row; null otherwise.
    cook: AdminCook
    # Persisted per-user feature toggle overrides (force on/off). Absent keys
    # fall back to the global `FeatureToggles` default. See
    # docs/features/admin-feature-toggles.md.
    featureToggleOverrides: [AdminFeatureToggleUserOverride!]!
}

# Admin view of a cook profile — includes Stripe account id for support.
# See docs/features/cook-profile.md.
type AdminCook {
    cookId: ID!
    # Owning user row (`cookId` = `Users.userId`).
    user: AdminUser!
    isVisible: Boolean!
    isApprovedByAdmin: Boolean!
    canCreateOffers: Boolean!
    stripeStatus: CookStripeStatus!
    stripeAccountId: String
    # Stripe Dashboard deep link for the Connect account (test/live from secret key).
    stripeAccountUrl: String
    stripeAccountActive: Boolean!
    stripeAccountActiveWasReset: Boolean!
    # Live Stripe requirements (same shape as `Cook.stripeAccountDetails`). Null
    # without an account id or when Stripe retrieve fails. Request only on the
    # admin cook-profile tab — hits Stripe.
    stripeAccountDetails: CookStripeAccountDetails
    # Live Connect balance + recent transactions (same shape as `Cook.stripeWallet`).
    # Not gated by `COOK_WALLET_STRIPE_BALANCE`. Null without an account id or when
    # Stripe retrieve fails. Request only on the admin cook-profile tab — hits Stripe.
    stripeWallet: CookStripeWallet
    exactTravelOriginAddress: CookTravelOriginAddress
    biography: String!
    biographySummary: String!
    # True while a pending cook-biography-summary-generate job exists for this
    # cook (created|retry|active). Derived from pg-boss via payload cookId — not a Cooks column.
    biographySummaryGenerating: Boolean!
    # Landscape brand mark for the public chef About section. Null → marketing benefits fallback.
    logo: FileUpload
    cuisineStyle: String
    cookingPhilosophy: String
    # Same aggregate as `PublicCook.rating` — published customer reviews on completed offers.
    rating: PublicCookRating!
    travelExpensesAmount: Int!
    maximumTravelDistance: Int
    minimumPriceAmount: Int
    maximumPriceAmount: Int
    minimumParticipants: Int
    maximumParticipants: Int
    callSchedulingEnabled: Boolean!
    callDurationMinutes: Int!
    # Recurring weekly discovery-call windows (read-only on admin user detail).
    callAvailabilityRules: [CookCallAvailabilityRule!]!
    # City / partner / occasion landings that currently feature this cook.
    featuredOn: [AdminCookFeaturedLanding!]!
    # Optional public display name; when set, public surfaces prefer it over firstName.
    stageName: String
    createdAt: DateTime!
    lastModifiedAt: DateTime!
}

enum AdminCookFeaturedLandingKind {
    CITY
    PARTNER
    OCCASION
}

# Reverse index: landings that curate this cook. `id` is cityId / partnerId / occasionId.
type AdminCookFeaturedLanding {
    kind: AdminCookFeaturedLandingKind!
    id: ID!
    titleDe: String!
    titleEn: String!
    pathName: String!
}

# --- Testimonials (admin) -------------------------------------------------------
#
# See docs/architecture/testimonials.md.

type AdminCustomerTestimonial {
    customerTestimonialId: ID!
    userId: ID!
    user: AdminUser!
    bookingRequestOfferId: ID
    authorName: String
    # Effective value shown by the editor when `authorName` is empty — falls
    # back to the customer's display name via `testimonialOfferFallbacksLoad`.
    displayAuthorName: String!
    location: String
    displayLocation: String
    occasion: String
    displayOccasion: String
    body: String!
    imageUrls: [String!]!
    rating: Int
    publicationStatus: TestimonialPublicationStatus!
    publishedAt: DateTime
    createdAt: DateTime!
}

type CookTestimonialLowRatingAnswers {
    whatWentWrong: String
    wouldRecommend: Boolean
    additionalFeedback: String
}

type AdminCookTestimonial {
    cookTestimonialId: ID!
    userId: ID!
    cookId: ID!
    cook: AdminCook!
    bookingRequestOfferId: ID
    authorName: String
    # Effective value shown by the editor when `authorName` is empty — falls
    # back to the cook's display name via `testimonialOfferFallbacksLoad`.
    displayAuthorName: String!
    location: String
    displayLocation: String
    occasion: String
    displayOccasion: String
    body: String
    imageUrls: [String!]!
    rating: Int
    # Follow-up survey captured when `rating <= 3` — see `publicationStatusFromRating.ts`.
    lowRatingAnswers: CookTestimonialLowRatingAnswers
    publicationStatus: TestimonialPublicationStatus!
    publishedAt: DateTime
    createdAt: DateTime!
}

union AdminTestimonial = AdminCustomerTestimonial | AdminCookTestimonial

# Filter + pagination for `Admin.customerTestimonials`. Optional `cookIds` scopes
# to testimonials on offers by those cooks (`IN` via BookingRequestOffers).
# Omit criterion (or empty cookIds) = no cook filter. `skip` / `take` apply only
# when a criterion object is passed; omit criterion for the full unsorted-limit
# catalog used by the testimonials list and curation pickers.
input AdminCustomerTestimonialCriterion {
    skip: Int! = 0
    take: Int! = 100
    cookIds: [ID!]
}

# Filter + pagination for `Admin.cookTestimonials`. Optional `cookIds` scopes to
# those cooks (`IN`). Omit criterion (or empty cookIds) = no cook filter.
input AdminCookTestimonialCriterion {
    skip: Int! = 0
    take: Int! = 100
    cookIds: [ID!]
}

# Curated, ordered testimonial on the city editor.
type AdminCityTestimonial {
    index: Int!
    testimonial: AdminTestimonial!
}

# Curated, ordered testimonial on the partner editor.
type AdminPartnerTestimonial {
    index: Int!
    testimonial: AdminTestimonial!
}

# Curated, ordered testimonial on the occasion editor.
type AdminOccasionTestimonial {
    index: Int!
    testimonial: AdminTestimonial!
}

input AdminCustomerTestimonialCreate {
    userId: ID!
    bookingRequestOfferId: ID
    authorName: String
    location: String
    occasion: String
    body: String!
    rating: Int
    imageFileUploadIds: [ID!]
}

input AdminCustomerTestimonialUpdate {
    authorName: String
    location: String
    occasion: String
    body: String
    rating: Int
}

input AdminCookTestimonialCreate {
    cookId: ID!
    bookingRequestOfferId: ID
    authorName: String
    location: String
    occasion: String
    body: String
    rating: Int
    imageFileUploadIds: [ID!]
}

input AdminCookTestimonialUpdate {
    authorName: String
    location: String
    occasion: String
    body: String
    rating: Int
}

# Ordered curation entry for `cityTestimonialsUpdate` / `partnerTestimonialsUpdate`
# / `occasionTestimonialsUpdate`.
input TestimonialJunctionEntryInput {
    testimonialType: TestimonialType!
    testimonialId: ID!
}

# Admin view of a cook meal — includes soft-deleted rows (`deletedAt`). Cook
# GraphQL (`CookMeal`) never exposes `deletedAt`. See docs/features/cook-meals.md.
type AdminCookMeal {
    mealId: ID!
    cookId: ID!
    cookName: String!
    title: String!
    description: String!
    imageFileUploadId: ID
    imageUrl: String
    publishedAt: DateTime
    deletedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
    # Same usage / delete-gate shape as `CookMeal.relationships` (field resolver).
    relationships: CookMealRelationships!
}

# One course on an admin cook menu. Soft-deleted meals are omitted from `mealOptions`.
type AdminCookMenuCourse {
    courseId: ID!
    title: String!
    mealSelectionLimit: Int
    mealOptions: [AdminCookMeal!]!
}

enum AdminCookMealSortField {
    title
    createdAt
    publishedAt
    deletedAt
}

# Lifecycle lens for admin meal / menu lists. Omit = all rows (respecting
# `includeDeleted`). `PUBLISHED` / `DRAFT` are non-deleted only; `DELETED`
# requires `deletedAt`.
enum AdminCookInventoryStatus {
    PUBLISHED
    DRAFT
    DELETED
}

# Image / public-catalog lens for `Admin.cookMeals`. Omit = no image filter.
# `ON_PUBLIC_PAGE` / `NOT_ON_PUBLIC_PAGE` imply non-deleted + published.
enum AdminCookMealImageFilter {
    WITH_IMAGE
    WITHOUT_IMAGE
    ON_PUBLIC_PAGE
    NOT_ON_PUBLIC_PAGE
}

# Filter + pagination for `Admin.cookMeals` / `cookMealsCounts`. Optional
# `cookIds` scopes to those cooks (`IN`); omit or empty = no cook filter
# (user-detail tab passes one id; list multi-select can pass many).
# `includeDeleted` defaults true so soft-deleted inventory stays visible; ignored
# when `status` is set (`PUBLISHED`/`DRAFT` exclude deleted; `DELETED` requires it).
# `searchText` matches title, description, cook email, or cook name (first,
# last, or full name either order; case-insensitive contains). `imageFilter`
# ANDs with other filters. `skip` / `take` / `sort*` ignored by
# `cookMealsCounts`.
input AdminCookMealCriterion {
    skip: Int! = 0
    take: Int! = 25
    cookIds: [ID!]
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more meal ids).
    mealIds: [ID!]
    searchText: String
    includeDeleted: Boolean! = true
    status: AdminCookInventoryStatus
    imageFilter: AdminCookMealImageFilter
    sortField: AdminCookMealSortField
    sortDirection: SortDirection
}

# Admin view of a cook menu — includes soft-deleted rows (`deletedAt`). Cook
# GraphQL (`CookMenu`) never exposes `deletedAt`. See docs/features/cook-menus.md.
# `courseMealOptionImages` — same semantics as `CookMenu.courseMealOptionImages`.
# `courses` is hydrated on findOne; list queries return an empty array.
# List queries are inventory-only (`bookingRequestOfferId` null). FindOne also
# returns offer-scoped copies (for deep-links from admin offer pages).
type AdminCookMenu {
    menuId: ID!
    cookId: ID!
    cookName: String!
    title: String!
    description: String!
    courseCount: Int!
    courseMealOptionImages: [String!]!
    courses: [AdminCookMenuCourse!]!
    copyOfMenuId: ID
    bookingRequestOfferId: ID
    publishedAt: DateTime
    deletedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

enum AdminCookMenuSortField {
    title
    createdAt
    publishedAt
    deletedAt
}

# Filter + pagination for `Admin.cookMenus` / `cookMenusCounts`. Same shape as
# `AdminCookMealCriterion` (no `missingPublicImage`). Inventory only (offer copies
# excluded). `skip` / `take` / `sort*` ignored by `cookMenusCounts`.
input AdminCookMenuCriterion {
    skip: Int! = 0
    take: Int! = 25
    cookIds: [ID!]
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more menu ids).
    menuIds: [ID!]
    searchText: String
    includeDeleted: Boolean! = true
    status: AdminCookInventoryStatus
    sortField: AdminCookMenuSortField
    sortDirection: SortDirection
}

# Membership / surface labels used to filter `Admin.users`. A user can match
# more than one: `admin` = `Admins` row, `cook` = `Cooks` row, `customer` =
# no `Cooks` row (same split as the public profile surface).
enum AdminUserType {
    customer
    cook
    admin
}

# Shared ascending / descending for admin list `sortDirection` fields.
enum SortDirection {
    ASC
    DESC
}

# Sortable columns for `Admin.users`. Default when omitted: `createdAt` DESC.
enum AdminUserSortField {
    firstName
    lastName
    emailAddress
    createdAt
}

# Filter + pagination for `Admin.users` / `Admin.userCounts`. Optional
# `searchText` matches firstName, lastName, full name in either order, or
# emailAddress (case-insensitive contains). `types` is required — pass every
# type to leave membership unfiltered; an empty list matches nothing. `skip` /
# `take` / `sort*` are ignored by `userCounts`. Optional `sortField` /
# `sortDirection` drive server `ORDER BY` (default `createdAt` DESC).
input AdminUserCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    types: [AdminUserType!]!
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more user ids).
    userIds: [ID!]
    # When set, requires a `Cooks` row with this approval flag (typically used
    # with `types: [cook]` to list unapproved cooks).
    isApprovedByAdmin: Boolean
    # When set, only users with this account status.
    status: UserStatus
    sortField: AdminUserSortField
    sortDirection: SortDirection
}

# Inclusive DateTime bounds used by admin time-series charts (and reusable
# elsewhere). Callers must send both ends; the server normalizes them to the
# chosen granularity and zero-fills every bucket in between.
input DateTimeRange {
    startDateTime: DateTime!
    endDateTime: DateTime!
}

# Bucket size for admin overview time series. Maps to Postgres `date_trunc`.
enum AdminTimeBucketGranularity {
    day
    week
    month
}

# One zero-filled time-series point. `bucketStart` is the period boundary for
# the requested `AdminTimeBucketGranularity`.
type AdminTimeBucket {
    bucketStart: DateTime!
    count: Int!
}

# Manual account creation from `/admin/users/create`. Leaves legal acceptance
# timestamps null so the public gate fires on first sign-in. Optional `cook`
# inserts a `Cooks` row with required profile/travel fields; `asAdmin` inserts
# an `Admins` row; customer is implied when `cook` is omitted. See
# docs/features/admin-users.md.
input AdminUserCreate {
    emailAddress: EmailAddress!
    firstName: String!
    lastName: String!
    phoneNumber: PhoneNumber!
    birthDate: Date!
    preferredCommunication: UserPreferredCommunication!
    # Defaults to `de` when omitted. See docs/architecture/i18n.md.
    locale: Locale
    # Defaults to `Europe/Berlin` when omitted. See docs/architecture/i18n.md.
    timeZone: TimeZone
    asAdmin: Boolean! = false
    cook: CookCreate
}

# Admin-only session row for operator lists and detail. Privileged / attribution
# fields stay on this access-path type rather than widening request `Session`
# or account `UserSession`. See `docs/features/admin-sessions.md`.
type AdminSession {
    sessionId: ID!
    userId: ID
    # Resolved account for `userId` when present; null for anonymous sessions
    # or when the user row is gone. Prefer this over raw `userId` in admin UI.
    user: AdminUser
    lastInteractionAt: DateTime!
    wasTerminatedAt: DateTime
    connectionActive: Boolean!
    userAgent: String
    ipHash: String
    referrer: String
    landingPath: String
    isBot: Boolean!
    createdAt: DateTime!
}

# Humanized first-party analytics event for admin timelines.
type AdminSessionEvent {
    sessionEventId: ID!
    sessionId: ID!
    type: String!
    descriptionDe: String!
    descriptionEn: String!
    createdAt: DateTime!
    # Optional admin-relative path for deep-linking (e.g. booking request).
    link: String
}

# Filter + pagination for `Admin.sessionEvents` / `Admin.sessionEventsCounts`.
# At least one of `sessionIds` / `userIds` is required. `skip` / `take` are
# ignored by `sessionEventsCounts`.
input AdminSessionEventCriterion {
    sessionIds: [ID!]
    userIds: [ID!]
    types: [String!]
    skip: Int! = 0
    take: Int! = 50
}

type AdminAnalyticsSankeyNode {
    id: String!
    labelDe: String!
    labelEn: String!
}

type AdminAnalyticsSankeyLink {
    source: String!
    target: String!
    value: Int!
}

# Per-step funnel reach vs pass for human non-cook/non-admin sessions.
# `enteredCount` / `completedCount` are distinct sessions. `created` has no
# `step_entered` (completedCount comes from BOOKING_REQUEST_CREATED).
type AdminAnalyticsFunnelStepStats {
    id: String!
    labelDe: String!
    labelEn: String!
    enteredCount: Int!
    completedCount: Int!
}

type AdminAnalyticsBookingRequestFormFlow {
    nodes: [AdminAnalyticsSankeyNode!]!
    links: [AdminAnalyticsSankeyLink!]!
    steps: [AdminAnalyticsFunnelStepStats!]!
    # Distinct sessions with at least one step_completed or BOOKING_REQUEST_CREATED.
    sessionsWithCompletion: Int!
    # Distinct sessions with BOOKING_REQUEST_CREATED in range.
    bookingRequestsCreated: Int!
}

# Session-grain funnel shared by gift-card and chef sign-up analytics.
# `terminalCount` is distinct sessions that hit the lifecycle terminal step(s).
type AdminAnalyticsSessionFunnelFlow {
    nodes: [AdminAnalyticsSankeyNode!]!
    links: [AdminAnalyticsSankeyLink!]!
    steps: [AdminAnalyticsFunnelStepStats!]!
    sessionsWithCompletion: Int!
    terminalCount: Int!
}

# Cook × booking-request offer funnel for cooks notified in range.
# Early/terminal steps from BookingRequestCooks + Offers; create-UI mid-steps
# from session interactions. See docs/features/admin-analytics.md.
type AdminAnalyticsCookBookingRequestOfferFlow {
    nodes: [AdminAnalyticsSankeyNode!]!
    links: [AdminAnalyticsSankeyLink!]!
    steps: [AdminAnalyticsFunnelStepStats!]!
    notifiedCount: Int!
    openedCount: Int!
    declinedCount: Int!
    offersCreatedCount: Int!
}

# Admin view of an owned assistant chat. Legacy rows without `userId` /
# `surface` are excluded from list/detail. See
# docs/features/admin-assistant-chats.md.
type AdminAssistantChat {
    chatId: ID!
    userId: ID!
    # Owning account. Prefer this over raw `userId` in admin UI.
    user: AdminUser!
    surface: ChatSurface!
    title: String!
    lastModifiedAt: DateTime!
    createdAt: DateTime!
    # Set when the owner soft-deleted the chat. Admin inspect still lists these.
    deletedAt: DateTime
    # Sequence-ordered turns. Loaded only when selected (list queries omit it).
    turns: [ChatTurn!]!
}

# Filter + pagination for `Admin.assistantChats` / `assistantChatsCounts`.
# Optional `searchText` matches title, chatId text, or owner email / name
# (case-insensitive contains). Optional `userIds` scopes to those owners
# (`IN`); omit or empty = no user filter (user-detail tab passes one id; list
# multi-select can pass many). Optional `surface` scopes to one rail; omit =
# all surfaces. Default sort `lastModifiedAt` DESC. `skip` / `take` are ignored
# by `assistantChatsCounts`.
input AdminAssistantChatCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    userIds: [ID!]
    surface: ChatSurface
}

# Bot vs human labels used to filter `Admin.sessions`. Maps to `Sessions.isBot`.
enum AdminSessionKind {
    human
    bot
}

# Sortable columns for `Admin.sessions`. Default when omitted: `createdAt` DESC
# (not a list column — URL omits sort until the operator picks one).
enum AdminSessionSortField {
    user
    userAgent
    lastInteractionAt
    createdAt
}

# Filter + pagination for `Admin.sessions` / `Admin.sessionCounts`. Optional
# `searchText` matches sessionId, userId, userAgent, landingPath, referrer, or
# ipHash (case-insensitive contains). `kinds` is required — pass every kind to
# leave bot/human unfiltered; an empty list matches nothing. Optional `userIds`
# scopes to those accounts (`IN`); omit or empty = no user filter (user-detail
# tab passes one id; list multi-select can pass many). `skip` / `take` / `sort*`
# are ignored by `sessionCounts`. Optional `sortField` / `sortDirection` drive
# server `ORDER BY` (default `createdAt` DESC).
input AdminSessionCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    kinds: [AdminSessionKind!]!
    userIds: [ID!]
    sortField: AdminSessionSortField
    sortDirection: SortDirection
}

# Admin read namespace — resolved only when `User.admin` is non-null (session's
# own user has an `Admins` row). `adminId` (= `Users.userId`) is the identity /
# presence probe public pages select to decide whether to surface an admin
# entry point. Domain child fields never re-check membership because they
# cannot be reached without that parent. See
# `docs/architecture/authorization-admin.md`.
type Admin {
    adminId: ID!
    # Registered accounts for the admin users list. Sorted by criterion (default
    # newest first). See `AdminUserCriterion`.
    users(criterion: AdminUserCriterion!): [AdminUser!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all types, then each type). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    userCounts(criteria: [AdminUserCriterion!]!): [Int!]!
    # Registration time series for the overview chart. Buckets are zero-filled
    # across `range` at the given `granularity` (default `day`). Span capped at
    # 366 days.
    userRegistrations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Demographic / preference aggregates for the users overview (age, locale,
    # time zone, preferred communication). Independent of the chart range.
    userInsights: AdminUserInsights!
    # Next birthdays among non-anonymized users with a birth date. Sorted by
    # soonest `nextBirthday`. Default / max via `findManyTake`.
    upcomingBirthdays(take: Int! = 12): [AdminUserUpcomingBirthday!]!
    # Single-user detail. Null when the id is unknown.
    user(userId: ID!): AdminUser
    # Cook meals (draft + published + soft-deleted). See `AdminCookMealCriterion`.
    cookMeals(criterion: AdminCookMealCriterion!): [AdminCookMeal!]!
    # One count per criterion, same order. List pages pass a single criterion.
    # `skip` / `take` / `sort*` ignored. Empty criteria rejected; max 20.
    cookMealsCounts(criteria: [AdminCookMealCriterion!]!): [Int!]!
    # Single meal (including soft-deleted). Null when the id is unknown.
    cookMeal(mealId: ID!): AdminCookMeal
    # Cook menus (draft + published + soft-deleted). See `AdminCookMenuCriterion`.
    cookMenus(criterion: AdminCookMenuCriterion!): [AdminCookMenu!]!
    # One count per criterion, same order. List pages pass a single criterion.
    # `skip` / `take` / `sort*` ignored. Empty criteria rejected; max 20.
    cookMenusCounts(criteria: [AdminCookMenuCriterion!]!): [Int!]!
    # Single menu (including soft-deleted). Inventory and offer-scoped copies both
    # resolve so admin offer pages can deep-link; list queries stay inventory-only.
    cookMenu(menuId: ID!): AdminCookMenu
    # Browser / visitor sessions for the admin sessions list. Sorted by criterion
    # (default newest first). See `AdminSessionCriterion`.
    sessions(criterion: AdminSessionCriterion!): [AdminSession!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all kinds, then each kind). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    sessionCounts(criteria: [AdminSessionCriterion!]!): [Int!]!
    # Session-creation time series for the overview chart. Buckets are
    # zero-filled across `range` at the given `granularity` (default `day`).
    # Span capped at 366 days.
    sessionCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Single-session detail. Null when the id is unknown.
    session(sessionId: ID!): AdminSession
    # First-party session events across sessions/users. Sorted newest first.
    # See `AdminSessionEventCriterion` and docs/architecture/session-events.md.
    sessionEvents(criterion: AdminSessionEventCriterion!): [AdminSessionEvent!]!
    # One count per criterion, same order. List / detail pages pass a single
    # criterion. `skip` / `take` ignored. Empty criteria rejected; max 20.
    sessionEventsCounts(criteria: [AdminSessionEventCriterion!]!): [Int!]!
    # Booking-request form funnel (Sankey transitions + per-step entered/completed
    # counts + KPIs) for human non-cook/non-admin sessions in `range`. See
    # docs/features/admin-analytics.md.
    bookingRequestFormFlow(range: DateTimeRange!): AdminAnalyticsBookingRequestFormFlow!
    # Gift-card purchase funnel for human non-cook/non-admin sessions in `range`.
    giftCardFlow(range: DateTimeRange!): AdminAnalyticsSessionFunnelFlow!
    # Chef sign-up funnel for human non-admin sessions in `range` (cooks included).
    chefSignUpFlow(range: DateTimeRange!): AdminAnalyticsSessionFunnelFlow!
    # Booking-request offer checkout funnel for human non-cook/non-admin sessions in `range`.
    bookingRequestCheckoutFlow(range: DateTimeRange!): AdminAnalyticsSessionFunnelFlow!
    # Cook × booking-request offer funnel for cooks notified in `range`.
    cookBookingRequestOfferFlow(range: DateTimeRange!): AdminAnalyticsCookBookingRequestOfferFlow!
    # WEB_PAGE_VISITED time series for a fixed WebPageKey. Same bucket rules as
    # other admin creations queries.
    sessionEventWebPageVisitCreations(
        webPageKey: WebPageKey!
        range: DateTimeRange!
        granularity: AdminTimeBucketGranularity! = day
    ): [AdminTimeBucket!]!
    # Assistant chats (any surface, any owner). Sorted by criterion (default
    # `lastModifiedAt` desc). See `AdminAssistantChatCriterion` and
    # docs/features/admin-assistant-chats.md.
    assistantChats(criterion: AdminAssistantChatCriterion!): [AdminAssistantChat!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all, then each surface). `skip` / `take`
    # ignored. Empty criteria rejected; max 20.
    assistantChatsCounts(criteria: [AdminAssistantChatCriterion!]!): [Int!]!
    # Creation time series for the overview chart. Buckets are zero-filled
    # across `range` at the given `granularity` (default `day`). Span capped at
    # 366 days.
    assistantChatCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Single assistant-chat detail. Null when the id is unknown or the row is
    # missing ownership (`userId` / `surface`).
    assistantChat(chatId: ID!): AdminAssistantChat
    # Single log row. Null when the id is unknown.
    log(logId: ID!): AdminLog
    # Persistent log rows. Sorted by criterion (default newest first). See
    # `AdminLogCriterion`.
    logs(criterion: AdminLogCriterion!): [AdminLog!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all levels, then each level). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    logCounts(criteria: [AdminLogCriterion!]!): [Int!]!
    # Log-creation time series for the overview chart. Buckets are zero-filled
    # across `range` at the given `granularity` (default `day`). Span capped at
    # 366 days.
    logCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Top Postgres statements by total execution time from `pg_stat_statements`.
    # Empty when the extension is not installed. `limit` capped at 100.
    # See docs/architecture/observability.md.
    databaseSlowStatements(limit: Int! = 20): [AdminDatabaseSlowStatement!]!
    # Single one-shot AI generation. Null when the id is unknown.
    aiGeneration(aiGenerationId: ID!): AdminAiGeneration
    # One-shot LLM call ledger. Sorted by criterion (default newest first). See
    # `AdminAiGenerationCriterion` and docs/features/admin-ai-generations.md.
    aiGenerations(criterion: AdminAiGenerationCriterion!): [AdminAiGeneration!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all kinds, then each kind). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    aiGenerationCounts(criteria: [AdminAiGenerationCriterion!]!): [Int!]!
    # Creation time series for the overview chart. Buckets are zero-filled
    # across `range` at the given `granularity` (default `day`). Span capped at
    # 366 days.
    aiGenerationCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Version history (draft + published), newest first.
    legalPrivacyPolicies: [AdminLegalPrivacyPolicy!]!
    legalTermsAndConditions: [AdminLegalTermsAndConditions!]!
    legalImprints: [AdminLegalImprint!]!

    # Gift-card purchases (read-only). Sorted by criterion (default newest first).
    # See `AdminGiftCardCriterion`.
    giftCards(criterion: AdminGiftCardCriterion!): [AdminGiftCard!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # overviews can pass several (e.g. all statuses, then each status). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    giftCardsCounts(criteria: [AdminGiftCardCriterion!]!): [Int!]!
    # Paid purchase time series for the overview chart (`paymentStatus = PAYED`).
    # Buckets are zero-filled across `range` at the given `granularity` (default
    # `day`). Span capped at 366 days.
    giftCardCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Top occasions among paid purchases, by count (then occasion). Omit `range` for
    # all-time (overview default; independent of the chart picker). Default take is 3.
    giftCardOccasionStats(range: DateTimeRange, take: Int! = 3): [AdminGiftCardOccasionStat!]!
    # Top calendar months among paid purchases, by count (then month). Omit `range`
    # for all-time (overview default; independent of the chart picker). Default take is 3.
    giftCardSalesMonthStats(range: DateTimeRange, take: Int! = 3): [AdminGiftCardSalesMonthStat!]!
    # Average `originalBalanceCents` among paid purchases (all-time). 0 when none paid.
    giftCardPaidPurchaseAverageCents: Int!
    # Single gift-card detail. Null when the id is unknown.
    giftCard(giftCardId: ID!): AdminGiftCard

    # Booking requests. Sorted by criterion (default newest first).
    # See `AdminBookingRequestCriterion`.
    bookingRequests(criterion: AdminBookingRequestCriterion!): [AdminBookingRequest!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. all, then each publication status).
    # `skip` / `take` / `sort*` ignored. Empty criteria rejected; max 20.
    bookingRequestsCounts(criteria: [AdminBookingRequestCriterion!]!): [Int!]!
    # Creation time series for the overview chart. Buckets are zero-filled
    # across `range` at the given `granularity` (default `day`). Span capped at
    # 366 days.
    bookingRequestCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Top occasions among requests, by count (then occasion). Omit `range` for
    # all-time (overview default; independent of the chart picker). Default take is 3.
    bookingRequestOccasionStats(range: DateTimeRange, take: Int! = 3): [AdminBookingRequestOccasionStat!]!
    # Top calendar months among request creations, by count (then month). Omit
    # `range` for all-time (overview default). Default take is 3.
    bookingRequestCreationMonthStats(range: DateTimeRange, take: Int! = 3): [AdminBookingRequestCreationMonthStat!]!
    # Average participant count per request (all-time). 0 when none.
    bookingRequestAverageParticipants: Int!
    # Offer funnel economics: all-time averages and paid totals, plus paid
    # revenue / platform-profit totals for optional `range` (payment time).
    bookingRequestOfferEconomics(range: DateTimeRange): AdminBookingRequestOfferEconomics!
    # Top cooks by offer volume or dual-accept conversions (all-time).
    bookingRequestCookOfferStats(
        take: Int! = 3
        sortBy: AdminBookingRequestCookOfferStatSortField! = offerCount
    ): [AdminBookingRequestCookOfferStat!]!
    # Single booking-request detail. Null when the id is unknown.
    bookingRequest(bookingRequestId: ID!): AdminBookingRequest
    # Offer-capable cooks whose travel radius covers the point (admin create picker).
    # Optional `excludeUserId` drops that user (usually the customer). Sorted by distance.
    cooksInTravelRadius(latitude: Latitude!, longitude: Longitude!, excludeUserId: ID): [AdminCookInTravelRadiusPreview!]!
    # Booking-request offers. Sorted newest first unless `plannedPayoutDateTimeTo`
    # is set (then earliest planned payout first — due-payout queue).
    bookingRequestOffers(criterion: AdminBookingRequestOfferCriterion!): [AdminBookingRequestOffer!]!
    # One count per criterion, same order. `skip` / `take` ignored. Empty
    # criteria rejected; max 20.
    bookingRequestOffersCounts(criteria: [AdminBookingRequestOfferCriterion!]!): [Int!]!
    bookingRequestOffer(bookingRequestOfferId: ID!): AdminBookingRequestOffer

    # Support cases (customer ↔ admin). Sorted by criterion (default unread
    # first, then newest message). See `AdminSupportRequestCriterion` and
    # docs/features/support-requests.md.
    supportRequests(criterion: AdminSupportRequestCriterion!): [AdminSupportRequest!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. open, then hasAdminUnread). `skip` /
    # `take` ignored. Empty criteria rejected; max 20.
    supportRequestsCounts(criteria: [AdminSupportRequestCriterion!]!): [Int!]!
    # Single support-request detail. Null when the id is unknown.
    supportRequest(supportRequestId: ID!): AdminSupportRequest

    # WhatsApp Concierge inbox. Sorted unread-first then newest message.
    whatsAppConversations(criterion: AdminWhatsAppConversationCriterion!): [AdminWhatsAppConversation!]!
    whatsAppConversationsCounts(criteria: [AdminWhatsAppConversationCriterion!]!): [Int!]!
    whatsAppConversation(whatsAppConversationId: ID!): AdminWhatsAppConversation
    # Sum of `adminUnreadCount` across conversations (sidebar badge).
    whatsAppConversationsAdminUnreadCount: Int!

    # Attention board: LIVE / PENDING / UPCOMING / RECENT (48h) discovery calls.
    # Refreshed via `adminUpdates`. See `adminCallsFindMany`.
    calls: [AdminCallListItem!]!
    # Full call traffic (slots + rooms, including declines/cancels). Sorted by
    # criterion (default `occurredAt` DESC). See `AdminCallTrafficCriterion`.
    callTraffic(criterion: AdminCallTrafficCriterion!): [AdminCallListItem!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # the overview passes several (e.g. live, pending, declined in range).
    # `skip` / `take` / `sort*` ignored. Empty criteria rejected; max 20.
    callTrafficCounts(criteria: [AdminCallTrafficCriterion!]!): [Int!]!
    # Slot-request creation time series for the overview chart. Buckets are
    # zero-filled across `range` at the given `granularity` (default `day`).
    # Span capped at 366 days.
    callSlotCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # LiveKit room start time series (uses `startedAt`). Same bucket rules.
    callRoomCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Top cooks by call activity in `range` (rooms by startedAt; slot outcomes
    # by lastModifiedAt; pending awaiting cook is current, not range-scoped).
    callCookStats(range: DateTimeRange!, sortBy: AdminCallCookStatSortField! = roomCount, take: Int! = 10): [AdminCallCookStat!]!

    # Promo codes (admin catalog). Sorted by criterion (default newest first).
    # See `AdminPromoCodeCriterion`.
    promoCodes(criterion: AdminPromoCodeCriterion!): [AdminPromoCode!]!
    # One count per criterion, same order. List pages pass a single criterion.
    # `skip` / `take` / `sort*` ignored. Empty criteria rejected; max 20.
    promoCodesCounts(criteria: [AdminPromoCodeCriterion!]!): [Int!]!
    # Single promo-code detail. Null when the id is unknown.
    promoCode(promoCodeId: ID!): AdminPromoCode

    # Outbound transactional emails (read-only). Sorted by criterion (default
    # newest first). See `AdminOutboundEmailCriterion`.
    outboundEmails(criterion: AdminOutboundEmailCriterion!): [AdminOutboundEmail!]!
    # One count per criterion, same order. List pages pass a single criterion;
    # overviews can pass several (e.g. all purposes, then each lifecycle). `skip` /
    # `take` / `sort*` ignored. Empty criteria rejected; max 20.
    outboundEmailsCounts(criteria: [AdminOutboundEmailCriterion!]!): [Int!]!
    # Creation time series for outbound emails (`OutboundEmails.createdAt`).
    # Same bucket rules as other admin creations queries.
    outboundEmailCreations(range: DateTimeRange!, granularity: AdminTimeBucketGranularity! = day): [AdminTimeBucket!]!
    # Top recipients by send count (then toEmail). Omit `range` for all-time
    # (overview default; independent of the chart picker). Default take is 3.
    outboundEmailRecipientStats(range: DateTimeRange, take: Int! = 3): [AdminOutboundEmailRecipientStat!]!
    # Top purposes by send count (then purpose). Omit `range` for all-time
    # (overview default; independent of the chart picker). Default take is 3.
    outboundEmailPurposeStats(range: DateTimeRange, take: Int! = 3): [AdminOutboundEmailPurposeStat!]!
    # Single outbound email detail. Null when the id is unknown.
    outboundEmail(outboundEmailId: ID!): AdminOutboundEmail
    # Live Resend account email quota (monthly + daily). Null when
    # `EMAIL_TRANSPORT` is `console` or the Resend usage API call fails.
    resendUsage: AdminResendUsage

    # Content pages — cities, partners, occasions, blog posts (drafts + published).
    cities: [AdminCity!]!
    city(cityId: ID!): AdminCity
    partners: [AdminPartner!]!
    partner(partnerId: ID!): AdminPartner
    occasions: [AdminOccasion!]!
    occasion(occasionId: ID!): AdminOccasion
    blogPosts: [AdminBlogPost!]!
    blogPost(blogPostId: ID!): AdminBlogPost

    # Fixed-route SEO (WebPages). Always one entry per `WebPageKey` (ghost
    # rows when no DB entry, filled from shared defaults). See
    # docs/features/admin-web-pages.md.
    webPages: [AdminWebPage!]!
    webPage(webPageKey: WebPageKey!): AdminWebPage!

    # Fixed-key feature toggles. Always one entry per `FeatureToggleKey` (ghost
    # rows when no DB entry). See docs/features/admin-feature-toggles.md.
    featureToggles: [AdminFeatureToggle!]!

    # Testimonial catalogs (draft + published). See docs/architecture/testimonials.md.
    # Omit `criterion` for the full catalog (admin list / curation pickers). Pass
    # `cookIds` to scope to a cook (user-detail testimonials tab).
    customerTestimonials(criterion: AdminCustomerTestimonialCriterion): [AdminCustomerTestimonial!]!
    customerTestimonial(customerTestimonialId: ID!): AdminCustomerTestimonial
    cookTestimonials(criterion: AdminCookTestimonialCriterion): [AdminCookTestimonial!]!
    cookTestimonial(cookTestimonialId: ID!): AdminCookTestimonial

    # Shared Garage/S3 object store browse. Capability-optional: when
    # OBJECT_STORAGE_S3_* is incomplete, `configured` is false and `objects` is
    # empty. Paginated via S3 continuation tokens — see
    # `AdminObjectStorageObjectCriterion` and docs/architecture/file-storage.md /
    # docs/features/admin-file-store.md.
    objectStorageObjects(criterion: AdminObjectStorageObjectCriterion!): AdminObjectStorageObjectPage!

    # All pending (created | retry) pg-boss jobs across queued definitions,
    # sorted by `startAfter` ascending. Live from the runner — not a static
    # catalog. Recurring crons have no per-fire row until they enqueue.
    # See docs/features/admin-jobs.md.
    queuedJobs: [AdminQueuedJob!]!
}

type AdminObjectStorageObject {
    key: String!
    size: Int!
    lastModified: DateTime
    etag: String
}

type AdminObjectStorageObjectPage {
    configured: Boolean!
    bucket: String
    objects: [AdminObjectStorageObject!]!
    nextContinuationToken: String
    isTruncated: Boolean!
}

# Filter + pagination for `Admin.objectStorageObjects`. Optional `prefix` is
# passed to S3 `ListObjectsV2` (consumers own key prefixes). Optional
# `continuationToken` resumes the previous page. `take` caps MaxKeys
# (default 25, max 100).
input AdminObjectStorageObjectCriterion {
    prefix: String
    continuationToken: String
    take: Int
}

type AdminGiftCard {
    giftCardId: ID!
    buyerEmail: EmailAddress!
    buyerUserId: ID
    occasion: String!
    recipientName: String!
    message: String!
    originalBalanceCents: Int!
    balanceCents: Int!
    redeemCode: String!
    paymentStatus: GiftCardPaymentStatus!
    invoiceAddress: InvoiceAddress
    # Persisted purchase-receipt PDF id (null when capture soft-failed). Prefer
    # `invoiceFileUpload` for download metadata.
    invoiceFileUploadId: ID
    # Purchase-receipt PDF generated at pay time (null when capture soft-failed).
    invoiceFileUpload: FileUpload
    # Persisted printable voucher PDF id (null when capture soft-failed).
    voucherFileUploadId: ID
    # Printable / sharable gift-card voucher (null when capture soft-failed).
    voucherFileUpload: FileUpload
    expiresAt: DateTime!
    createdAt: DateTime!
}

# Aggregated paid gift-card purchases for one occasion (overview ranking).
type AdminGiftCardOccasionStat {
    occasion: String!
    count: Int!
    totalOriginalBalanceCents: Int!
}

# Aggregated paid gift-card purchases for one calendar month (overview ranking).
type AdminGiftCardSalesMonthStat {
    # First instant of the month (`date_trunc('month', createdAt)`).
    monthStart: DateTime!
    count: Int!
    totalOriginalBalanceCents: Int!
}

# Sortable columns for `Admin.giftCards`. Default when omitted: `createdAt` DESC.
enum AdminGiftCardSortField {
    createdAt
    originalBalanceCents
    buyerEmail
}

# Filter + pagination for `Admin.giftCards` / `giftCardsCounts`. Optional
# `searchText` matches buyer email, recipient name, or redeem code
# (case-insensitive contains). `paymentStatuses` is required — pass every
# status to leave payment unfiltered; an empty list matches nothing. Optional
# `sortField` / `sortDirection` drive server `ORDER BY` (default `createdAt`
# DESC). `skip` / `take` / `sort*` are ignored by `giftCardsCounts`.
input AdminGiftCardCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    # Primary-key filter (`IN`); omit or empty = no id filter. Used by admin
    # assistant drill-in (same list tool with one or more gift card ids).
    giftCardIds: [ID!]
    paymentStatuses: [GiftCardPaymentStatus!]!
    sortField: AdminGiftCardSortField
    sortDirection: SortDirection
}

# Admin promo-code catalog row. Fixed-amount discount; redemption is separate.
type AdminPromoCode {
    promoCodeId: ID!
    redeemCode: String!
    amountCents: Int!
    minimumTotalAmountCustomerCents: Int
    # Set when this code is booking-request-scoped (churn). Null for global codes.
    scopedBookingRequestId: ID
    expiresAt: DateTime!
    createdAt: DateTime!
    # Requests that currently apply this promo (`BookingRequests.promoCodeId`).
    bookingRequests: [AdminBookingRequest!]!
}

# Sortable columns for `Admin.promoCodes`. Default when omitted: `createdAt` DESC.
enum AdminPromoCodeSortField {
    createdAt
    expiresAt
    amountCents
    redeemCode
}

# Filter + pagination for `Admin.promoCodes` / `promoCodesCounts`. Optional
# `searchText` matches redeem code (case-insensitive contains). Optional
# `sortField` / `sortDirection` drive server `ORDER BY` (default `createdAt`
# DESC). `skip` / `take` / `sort*` are ignored by `promoCodesCounts`.
input AdminPromoCodeCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    sortField: AdminPromoCodeSortField
    sortDirection: SortDirection
}

input AdminPromoCodeCreate {
    redeemCode: String!
    amountCents: Int!
    minimumTotalAmountCustomerCents: Int
    expiresAt: DateTime!
}

# Updates mutable promo-code fields. Redeem code / amount stay immutable after
# create (changing them after distribution is unsafe). `expiresAt` may be in the
# past to expire a code immediately.
input AdminPromoCodeUpdate {
    promoCodeId: ID!
    expiresAt: DateTime!
}

enum AdminOutboundEmailPurpose {
    GIFT_CARD_PURCHASED
    AUTH_EMAIL_OTP
    EMAIL_ADDRESS_UPDATE_CONFIRM
    CALL_SLOT_BOOKING_REQUEST
    CALL_SLOT_BOOKING_CONFIRM
    CALL_SLOT_BOOKING_DECLINE
    CALL_SLOT_BOOKING_CANCEL
    CALL_SLOT_BOOKING_REMINDER
    BOOKING_REQUEST_COOK_NOTIFY
    BOOKING_REQUEST_CREATED
    BOOKING_REQUEST_UPDATED
    BOOKING_REQUEST_CANCELED
    BOOKING_REQUEST_OFFER_CREATED
    BOOKING_REQUEST_OFFER_MENU_UPDATED
    BOOKING_REQUEST_OFFER_ACCEPTED
    BOOKING_REQUEST_OFFER_NOT_CHOSEN
    BOOKING_REQUEST_OFFER_DECLINED
    BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT_REQUESTED
    BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT_ACCEPTED
    BOOKING_REQUEST_OFFER_PARTICIPANT_AMENDMENT_DECLINED
    BOOKING_REQUEST_OFFER_PAYMENT_CONFIRMED
    BOOKING_REQUEST_OFFER_PULL_PAYMENT_ANNOUNCEMENT
    TESTIMONIAL_MEMORY_NUDGE_CUSTOMER
    TESTIMONIAL_MEMORY_NUDGE_COOK
    TESTIMONIAL_REMINDER_MORNING_CUSTOMER
    TESTIMONIAL_REMINDER_MORNING_COOK
    TESTIMONIAL_REMINDER_EVENING_CUSTOMER
    TESTIMONIAL_REMINDER_EVENING_COOK
    SUPPORT_REQUEST_CREATED
    SUPPORT_REQUEST_MESSAGE_FROM_ADMIN
    SUPPORT_REQUEST_RESOLVED
    BOOKING_REQUEST_OFFER_CHAT_MESSAGE_TO_CUSTOMER
    BOOKING_REQUEST_OFFER_CHAT_MESSAGE_TO_COOK
    COOK_APPROVED_BY_ADMIN
}

enum AdminOutboundEmailRelatedEntityType {
    GIFT_CARD
    COOK_CALL_SLOT_BOOKING
    BOOKING_REQUEST_OFFER
    BOOKING_REQUEST
    SUPPORT_REQUEST
    COOK
}

enum AdminOutboundEmailProvider {
    resend
    console
}

# Admin-only view of a tracked outbound email send attempt. Lifecycle timestamps
# are first-write-wins from Resend webhooks (or local console transport).
type AdminOutboundEmail {
    outboundEmailId: ID!
    provider: AdminOutboundEmailProvider!
    providerMessageId: String
    purpose: AdminOutboundEmailPurpose!
    relatedEntityType: AdminOutboundEmailRelatedEntityType
    relatedEntityId: ID
    userId: ID
    user: AdminUser
    toEmail: String!
    fromEmail: String
    subject: String!
    locale: String!
    failureReason: String
    # Files attached at send time (e.g. gift-card purchase receipt PDF).
    attachments: [FileUpload!]!
    createdAt: DateTime!
    sentAt: DateTime
    failedAt: DateTime
    deliveredAt: DateTime
    deliveryDelayedAt: DateTime
    openedAt: DateTime
    clickedAt: DateTime
    bouncedAt: DateTime
    complainedAt: DateTime
}

# Aggregated outbound sends for one recipient address (overview ranking).
# `userId` / `displayName` are any attributed user for that address when known.
type AdminOutboundEmailRecipientStat {
    toEmail: String!
    count: Int!
    userId: ID
    displayName: String
}

# Aggregated outbound sends for one purpose (overview ranking).
type AdminOutboundEmailPurposeStat {
    purpose: AdminOutboundEmailPurpose!
    count: Int!
}

# Sortable columns for `Admin.outboundEmails`. Default when omitted: `createdAt`
# DESC.
enum AdminOutboundEmailSortField {
    createdAt
    toEmail
    subject
}

# Lifecycle facets for outbound-email counts / list filters. Overview passes one
# status per criterion; multiple values OR together.
enum AdminOutboundEmailLifecycleStatus {
    FAILED
    OPENED
    BOUNCED
    PENDING
    SENT
}

# Live Resend email sending quota window (daily or monthly).
type AdminResendEmailQuota {
    used: Int!
    # Null when the plan has no cap for this window (paid daily).
    limit: Int
    sent: Int!
    received: Int!
    resetsAt: DateTime!
}

type AdminResendUsage {
    monthly: AdminResendEmailQuota!
    daily: AdminResendEmailQuota!
}

# Filter + pagination for `Admin.outboundEmails` / `outboundEmailsCounts`.
# Optional `searchText` matches `toEmail` or `subject` (case-insensitive
# contains). `purposes` is required — pass every purpose to leave purpose
# unfiltered; an empty list matches nothing. Optional `userIds` scopes to those
# owners (`IN`); omit or empty = no user filter (user-detail tab passes one id;
# list multi-select can pass many). Optional `relatedEntityType`+`relatedEntityId`
# narrow attribution. Optional `lifecycleStatuses` filters by derived lifecycle
# (omit = no lifecycle filter; empty list matches nothing). Optional `sortField` /
# `sortDirection` drive server `ORDER BY` (default `createdAt` DESC). `skip` /
# `take` / `sort*` are ignored by `outboundEmailsCounts`.
input AdminOutboundEmailCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    purposes: [AdminOutboundEmailPurpose!]!
    userIds: [ID!]
    relatedEntityType: AdminOutboundEmailRelatedEntityType
    relatedEntityId: ID
    lifecycleStatuses: [AdminOutboundEmailLifecycleStatus!]
    sortField: AdminOutboundEmailSortField
    sortDirection: SortDirection
}

# Severity levels stored on `Logs.level` (see docs/architecture/logging.md).
enum AdminLogLevel {
    error
    warn
    info
    debug
}

# Admin-only view of a persistent log row. Written by `ServerRuntime.log`;
# never mutated from GraphQL.
type AdminLog {
    logId: ID!
    sessionId: ID
    # Resolved session for `sessionId` when present; null when anonymous or the
    # session row is gone. Prefer `session.user` over raw `sessionId` in admin UI.
    session: AdminSession
    level: AdminLogLevel!
    message: String!
    context: JSON
    createdAt: DateTime!
}

# One row from `pg_stat_statements` for admin slow-query inspection.
type AdminDatabaseSlowStatement {
    query: String!
    calls: Int!
    totalExecTimeMs: Float!
    meanExecTimeMs: Float!
    rows: Int!
}

# Sortable columns for `Admin.logs`. Default when omitted: `createdAt` DESC.
enum AdminLogSortField {
    createdAt
    message
}

# Filter + pagination for `Admin.logs` / `Admin.logCounts`. Optional
# `searchText` matches `message` (case-insensitive contains). `levels` is
# required — pass every level to leave severity unfiltered; an empty list
# matches nothing. Optional `sortField` / `sortDirection` drive server
# `ORDER BY` (default `createdAt` DESC). `skip` / `take` / `sort*` are
# ignored by `logCounts`.
input AdminLogCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    levels: [AdminLogLevel!]!
    sortField: AdminLogSortField
    sortDirection: SortDirection
}

# One-shot LLM call kinds stored on `AiGenerations.kind` (see
# docs/architecture/ai-generations.md). Chat multi-turn generations are not
# included — those live on chat message variant rows.
enum AdminAiGenerationKind {
    COOK_MENU_SUGGESTION_FROM_TEXT
    COOK_MENU_SUGGESTION_FROM_INVENTORY
    COOK_MENU_TITLE_DESCRIPTION
    CHAT_TITLE
    BOOKING_REQUEST_OFFER_CALL_RECORDING_TRANSCRIPT
    COOK_BIOGRAPHY_SUGGESTION
    COOK_BIOGRAPHY_SUMMARY
    BOOKING_REQUEST_COOK_MENU_EVALUATION
}

# Admin-only view of a one-shot LLM call. Written by `ServerRuntime.aiGenerations`;
# never mutated from GraphQL.
type AdminAiGeneration {
    aiGenerationId: ID!
    kind: AdminAiGenerationKind!
    userId: ID
    # Resolved user for `userId` when present; null when unset or the user row
    # is gone. Prefer `user` over raw `userId` in admin UI.
    user: AdminUser
    sessionId: ID
    session: AdminSession
    modelId: String
    system: String!
    prompt: String!
    output: String!
    inputTokens: Int
    outputTokens: Int
    totalTokens: Int
    reasoningTokens: Int
    cachedInputTokens: Int
    createdAt: DateTime!
}

# Sortable columns for `Admin.aiGenerations`. Default when omitted: `createdAt` DESC.
enum AdminAiGenerationSortField {
    createdAt
    kind
    modelId
    totalTokens
}

# Filter + pagination for `Admin.aiGenerations` / `Admin.aiGenerationCounts`.
# Optional `searchText` matches `system` / `prompt` / `output` (case-insensitive
# contains). `kinds` is required — pass every kind to leave unfiltered; an empty
# list matches nothing. Optional `sortField` / `sortDirection` drive server
# `ORDER BY` (default `createdAt` DESC). `skip` / `take` / `sort*` are ignored
# by `aiGenerationCounts`.
input AdminAiGenerationCriterion {
    skip: Int! = 0
    take: Int! = 25
    searchText: String
    kinds: [AdminAiGenerationKind!]!
    sortField: AdminAiGenerationSortField
    sortDirection: SortDirection
}

# Admin write namespace — gated by `guardAdminMutation`, which stamps `adminId`
# (= `Users.userId`) onto the parent in TypeScript only (see `extensions.ts`)
# for downstream commands.
type AdminMutation {
    # Creates a user row (and optional cook / admin membership). Returns the new
    # `userId` as `referenceId`. See `AdminUserCreate`.
    userCreate(input: AdminUserCreate!): MutationResult!
    # Updates `Users.adminNote` for the given user. Returns `userId` as `referenceId`.
    userAdminNoteUpdate(userId: ID!, adminNote: String!): MutationResult!
    # Patch account fields for any user (same shape as `UserUpdate`). Profile
    # picture uploads must be owned by the admin session user and are reassigned
    # to the target. Returns `userId` as `referenceId`.
    userUpdate(userId: ID!, user: UserUpdate!): MutationResult!
    # Direct email change (no OTP). Archives the previous address. Returns
    # `userId` as `referenceId`.
    userEmailAddressUpdate(userId: ID!, emailAddress: EmailAddress!): MutationResult!
    # Anonymize any user (same scrub as self-serve delete). Returns `userId` as
    # `referenceId`. See docs/features/account.md.
    userAnonymize(userId: ID!): MutationResult!
    # Ban or unban (`ACTIVE` ↔ `BANNED` only). Rejects `ANONYMIZED` and any
    # transition involving an anonymized row. On ban, open cook offers are
    # auto-declined. Sessions stay bound so the profile restriction banner can
    # appear live. Returns `userId` as `referenceId`. See docs/features/admin-users.md.
    userStatusUpdate(userId: ID!, status: UserStatus!): MutationResult!
    # Rebind the admin's current cookie session to `userId` (impersonation).
    # Target must be ACTIVE. Skips TOTP. Client should navigate to `/profile`.
    # Returns `userId` as `referenceId`. See docs/features/admin-users.md.
    sessionUserBind(userId: ID!): MutationResult!
    # End any sessions by id (sets `wasTerminatedAt`). Used from the admin user
    # sessions tab. See docs/features/admin-sessions.md.
    terminateSessions(sessionIds: [ID!]!): MutationResult!
    cookApprovalUpdate(cookId: ID!, isApprovedByAdmin: Boolean!): MutationResult!
    # Patch cook profile fields for any cook (same shape as `CookUpdate`).
    # Returns `cookId` as `referenceId`. Does not auto-regenerate biographySummary.
    cookUpdate(cookId: ID!, input: CookUpdate!): MutationResult!
    # AI: generate or expand a cook's first-person biography. Returns suggestion only.
    cookBiographySuggest(cookId: ID!, currentBiography: String!): String!
    # AI: generate a third-person biography summary from the given biography text.
    # Returns suggestion only; admin applies into the form then saves via `cookUpdate`.
    cookBiographySummarySuggest(cookId: ID!, biography: String!): String!
    # Create a draft meal on a cook's inventory. Returns `mealId` as `referenceId`.
    cookMealCreate(cookId: ID!, meal: CookMealCreate): MutationResult!
    # Patch a cook meal (any cook). Image uploads must be owned by the admin and
    # are reassigned to the meal's cook. Returns `mealId` as `referenceId`.
    cookMealUpdate(mealId: ID!, meal: CookMealUpdate!): MutationResult!
    # Soft-delete a cook meal. Same sole-option gate as cook `mealDelete`.
    cookMealDelete(mealId: ID!): MutationResult!
    # Create a draft menu (3 empty courses) on a cook's inventory. Returns
    # `menuId` as `referenceId`.
    cookMenuCreate(cookId: ID!): MutationResult!
    # Patch a cook menu. Inventory: title / description / courses / publishedAt.
    # Offer-scoped copies: title / description / courses (`publishedAt` rejected).
    # Returns `menuId` as `referenceId`.
    cookMenuUpdate(menuId: ID!, menu: CookMenuUpdate!): MutationResult!
    # Soft-delete an inventory menu. Returns `menuId` as `referenceId`.
    cookMenuDelete(menuId: ID!): MutationResult!
    # Deep-copy an inventory menu to a new draft. Returns new `menuId`.
    cookMenuCopy(menuId: ID!): MutationResult!
    legalPrivacyPolicyDraftCreate: MutationResult!
    legalPrivacyPolicyDraftUpdate(input: AdminLegalDocumentDraftInput!): MutationResult!
    legalPrivacyPolicyPublish(privacyPolicyId: ID!): MutationResult!
    legalTermsAndConditionsDraftCreate: MutationResult!
    legalTermsAndConditionsDraftUpdate(input: AdminLegalDocumentDraftInput!): MutationResult!
    legalTermsAndConditionsPublish(termsAndConditionsId: ID!): MutationResult!
    legalImprintDraftCreate: MutationResult!
    legalImprintDraftUpdate(input: AdminLegalDocumentDraftInput!): MutationResult!
    legalImprintPublish(imprintId: ID!): MutationResult!
    cityUpsert(input: CityUpsert!): MutationResult!
    cityDelete(cityId: ID!): MutationResult!
    # Full-list replace of curated city cooks (ordered). Empty clears assignment
    # so the public city page falls back to travel-radius discovery.
    cityCooksUpdate(cityId: ID!, cookIds: [ID!]!): MutationResult!
    partnerUpsert(input: PartnerUpsert!): MutationResult!
    partnerDelete(partnerId: ID!): MutationResult!
    # Full-list replace of curated partner cooks (ordered). Empty clears
    # assignment so the public partner page shows no cooks section.
    partnerCooksUpdate(partnerId: ID!, cookIds: [ID!]!): MutationResult!
    occasionUpsert(input: OccasionUpsert!): MutationResult!
    occasionDelete(occasionId: ID!): MutationResult!
    # Full-list replace of curated occasion cooks (ordered). Empty clears
    # assignment so the public occasion page shows no cooks section.
    occasionCooksUpdate(occasionId: ID!, cookIds: [ID!]!): MutationResult!
    # Testimonials — admin-created rows are always PUBLISHED. See
    # docs/architecture/testimonials.md.
    customerTestimonialCreate(input: AdminCustomerTestimonialCreate!): MutationResult!
    customerTestimonialUpdate(customerTestimonialId: ID!, input: AdminCustomerTestimonialUpdate!): MutationResult!
    customerTestimonialDelete(customerTestimonialId: ID!): MutationResult!
    customerTestimonialImageUpdate(customerTestimonialId: ID!, imageFileUploadIds: [ID!]!): MutationResult!
    customerTestimonialPublish(customerTestimonialId: ID!, publicationStatus: TestimonialPublicationStatus!): MutationResult!
    cookTestimonialCreate(input: AdminCookTestimonialCreate!): MutationResult!
    cookTestimonialUpdate(cookTestimonialId: ID!, input: AdminCookTestimonialUpdate!): MutationResult!
    cookTestimonialDelete(cookTestimonialId: ID!): MutationResult!
    cookTestimonialImageUpdate(cookTestimonialId: ID!, imageFileUploadIds: [ID!]!): MutationResult!
    cookTestimonialPublish(cookTestimonialId: ID!, publicationStatus: TestimonialPublicationStatus!): MutationResult!
    # Full-list replace of curated city/partner/occasion testimonials (ordered).
    # Empty clears the assignment so the public page shows no testimonials section.
    cityTestimonialsUpdate(cityId: ID!, entries: [TestimonialJunctionEntryInput!]!): MutationResult!
    partnerTestimonialsUpdate(partnerId: ID!, entries: [TestimonialJunctionEntryInput!]!): MutationResult!
    occasionTestimonialsUpdate(occasionId: ID!, entries: [TestimonialJunctionEntryInput!]!): MutationResult!
    blogPostUpsert(input: BlogPostUpsert!): MutationResult!
    blogPostDelete(blogPostId: ID!): MutationResult!
    # Creates or updates fixed-route SEO title/description. Missing rows are
    # created on first write. Returns `webPageKey` as `referenceId`.
    webPageUpdate(webPageKey: WebPageKey!, input: AdminWebPageUpdate!): MutationResult!
    # Creates or updates a feature toggle. Missing rows are created on first
    # write. Returns `featureToggleKey` as `referenceId`.
    featureToggleUpdate(featureToggleKey: FeatureToggleKey!, enabled: Boolean!): MutationResult!
    # Force a feature toggle on or off for one user. Returns `userId` as
    # `referenceId`. See docs/features/admin-feature-toggles.md.
    featureToggleUserOverrideUpsert(userId: ID!, featureToggleKey: FeatureToggleKey!, enabled: Boolean!): MutationResult!
    # Clear a per-user override so the global default applies again. Returns
    # `userId` as `referenceId`.
    featureToggleUserOverrideDelete(userId: ID!, featureToggleKey: FeatureToggleKey!): MutationResult!
    # Creates a promo code. Returns the new `promoCodeId` as `referenceId`.
    promoCodeCreate(input: AdminPromoCodeCreate!): MutationResult!
    # Updates a promo code's expiration. Returns `promoCodeId` as `referenceId`.
    promoCodeUpdate(input: AdminPromoCodeUpdate!): MutationResult!
    # Creates a booking request on behalf of an existing customer. Returns the
    # new `bookingRequestId` as `referenceId`. Same publication / cook-notify
    # rules as customer create. See `AdminBookingRequestCreate`.
    bookingRequestCreate(input: AdminBookingRequestCreate!): MutationResult!
    # Partial admin ops update. Omit a scalar to leave it unchanged. Nullable
    # `adjustedMessage` clears when null / blank. `dateTime` recomputes
    # `expiresAt` unless `expiresAt` is also provided. Does not reset cook
    # acceptance or append offer-timeline events. Returns `bookingRequestId`.
    bookingRequestUpdate(bookingRequestId: ID!, input: AdminBookingRequestUpdate!): MutationResult!
    # Creates an offer on behalf of a cook with a full manual fee breakdown
    # (ops override — not cook auto-calc). Dual-accepted inserts land as
    # `PAYED_OUT_OF_SYSTEM`. Seeds offer chat like cook create. Returns
    # `bookingRequestOfferId` as `referenceId`.
    bookingRequestOfferCreate(input: AdminBookingRequestOfferCreate!): MutationResult!
    # Partial admin ops update of accept flags / fees / payment timestamps.
    # Dual-accept while `paymentStatus` is still `EMPTY` flips to
    # `PAYED_OUT_OF_SYSTEM`. Returns `bookingRequestOfferId`.
    bookingRequestOfferUpdate(bookingRequestOfferId: ID!, input: AdminBookingRequestOfferUpdate!): MutationResult!
    # Replaces an existing offer configured-menu JSON snapshot (title,
    # description, courses/meals). Requires a configured menu already present;
    # preserves stored `menuId`. Returns `bookingRequestOfferId`.
    bookingRequestOfferConfiguredMenuUpdate(
        bookingRequestOfferId: ID!
        configuredMenu: BookingRequestOfferConfiguredMenuInput!
    ): MutationResult!
    # Approves a large-group request blocked for admin review. Optional `cookIds`
    # limits who gets a `BookingRequestCooks` notify stamp; omit / empty =
    # all cooks in travel radius that can create offers. Returns `bookingRequestId`.
    bookingRequestPublicationApprove(bookingRequestId: ID!, cookIds: [ID!]): MutationResult!
    # Notifies (or re-notifies) selected cooks about an already-published request.
    # Stamps / refreshes outreach via `bookingRequestCooksNotify` (first `notifiedAt`
    # kept on conflict). `cookIds` must be non-empty; only cooks who can create
    # offers for the venue are notified. Returns `bookingRequestId`.
    bookingRequestCooksNotify(bookingRequestId: ID!, cookIds: [ID!]!): MutationResult!
    # Releases a due PAYED offer's Connect balance to the cook's bank via Stripe
    # payout. Requires cook payout readiness. Sets `TRANSFERRED` + `payoutDateTime`.
    # Idempotent when already transferred / out-of-system / `payoutDateTime` set.
    # Returns `bookingRequestOfferId` as `referenceId`.
    bookingRequestOfferPayoutRelease(bookingRequestOfferId: ID!): MutationResult!
    # Clear cook preparations / groceries lock so the customer can amend again.
    bookingRequestOfferPreparationsClear(bookingRequestOfferId: ID!): MutationResult!
    # Marks a due PAYED offer as paid outside Stripe (wire / cash / goodwill).
    # Sets `PAYED_OUT_OF_SYSTEM` + `payoutDateTime`. No Stripe call. Idempotent
    # when already transferred / out-of-system / `payoutDateTime` set.
    # Returns `bookingRequestOfferId` as `referenceId`.
    bookingRequestOfferPayoutMarkOutOfSystem(bookingRequestOfferId: ID!): MutationResult!
    # Checks Stripe for a matching Connect bank payout on a due PAYED offer, or
    # on a `PAYED_OUT_OF_SYSTEM` offer (ops may have marked that by accident).
    # When found, sets `TRANSFERRED` + `payoutDateTime` without calling
    # `payoutCreate`. When none matches, returns `success: false` and leaves
    # the offer unchanged. Requires cook `stripeAccountId`. Idempotent when
    # already `TRANSFERRED`. Returns `bookingRequestOfferId` as `referenceId`.
    bookingRequestOfferPayoutAlreadyTookPlaceCheck(bookingRequestOfferId: ID!): MutationResult!
    # Append a free-text negotiation message (`ADMIN_MESSAGE_SIMPLE` event).
    # `referenceId` is the new `bookingRequestOfferEventId`.
    bookingRequestOfferChatMessageCreate(bookingRequestOfferId: ID!, message: String!, fileUploadIds: [ID!]): MutationResult!
    # Apply or clear an emoji reaction on a `*_MESSAGE_SIMPLE` event. Empty `emoji`
    # clears. Gated by `BOOKING_REQUEST_OFFER_CHAT_REACTIONS`. Allowed even when
    # chat send is closed. No unread / email. `referenceId` is the target event id.
    bookingRequestOfferChatMessageReactionUpsert(bookingRequestOfferEventId: ID!, emoji: String!): MutationResult!
    # Replace the text body of a `*_MESSAGE_SIMPLE` offer-chat event (customer /
    # cook / admin). Attachments are unchanged. Empty body is allowed only when
    # the event already has attachments. Phone numbers rejected. Allowed even
    # when chat send is closed (ops / moderation). `referenceId` is the event id.
    bookingRequestOfferChatMessageUpdate(bookingRequestOfferEventId: ID!, message: String!): MutationResult!
    # Soft-hide / unhide a `*_MESSAGE_SIMPLE` offer-chat event for customer and
    # cook. Admin still sees the bubble. Allowed when chat send is closed.
    # `referenceId` is the event id. See docs/features/booking-offer-chat.md.
    bookingRequestOfferChatMessageVisibilityUpdate(bookingRequestOfferEventId: ID!, hiddenByAdmin: Boolean!): MutationResult!
    # Permanently delete an `ADMIN_MESSAGE_SIMPLE` offer-chat event (attachments
    # / reactions cascade). Irreversible. Other simple-message types must use
    # visibility update instead. `referenceId` is the deleted event id.
    bookingRequestOfferChatMessageDelete(bookingRequestOfferEventId: ID!): MutationResult!
    # Clears `adminChatReviewPendingCount` and sets `adminChatReviewedAt` for the
    # offer-chat review pipeline. Returns the acknowledged id plus the next
    # pending offer (oldest-first) when any remain. See
    # docs/features/admin-offer-chat-review.md.
    bookingRequestOfferChatReviewAcknowledge(bookingRequestOfferId: ID!): AdminBookingRequestOfferChatReviewAcknowledgeResult!
    # Admin can start / join / leave LiveKit rooms on any offer.
    bookingRequestOfferCallCreate(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallJoin(bookingRequestOfferId: ID!): BookingRequestOfferCallTokenResult!
    bookingRequestOfferCallLeave(bookingRequestOfferCallRoomParticipantId: ID!): MutationResult!
    # Decline a PENDING call-slot request on behalf of the counterparty
    # (`onBehalfOf` must be CUSTOMER when the cook initiated, COOK when the
    # customer initiated). Same lifecycle emails as the party decline path.
    bookingRequestOfferCallSlotDecline(cookCallSlotBookingId: ID!, onBehalfOf: CookCallSlotBookingActor!, reason: String): MutationResult!
    # Cancel a pre-accept booking request (same statuses and customer/cook emails
    # as `UserMutation.bookingRequestCancel`). Returns `bookingRequestId`.
    bookingRequestCancel(bookingRequestId: ID!, reason: String!): MutationResult!
    # Apply or clear a promo / gift-card redeem code on any booking request
    # (same rules as `UserMutation.bookingRequestDiscountUpdate`). Pass
    # `redeemCode` null/empty to clear. Returns redeem code as `referenceId` on
    # apply; `bookingRequestId` on clear.
    bookingRequestDiscountUpdate(bookingRequestId: ID!, redeemCode: String): MutationResult!
    # Concierge handover: close a dual-accepted offer and create/upgrade a dual-
    # accepted offer for another cook. Never mutates `cookId` in place. Returns
    # the new (or upgraded) `bookingRequestOfferId` as `referenceId`.
    bookingRequestOfferHandover(input: AdminBookingRequestOfferHandover!): MutationResult!
    # Admin reply on a support case. `referenceId` is the new message id.
    supportRequestMessageCreate(supportRequestId: ID!, message: String!, fileUploadIds: [ID!]): MutationResult!
    # Clears `adminUnreadNotificationCount` when opening the support chat.
    supportRequestUnreadNotificationCountReset(supportRequestId: ID!): MutationResult!
    # Marks a support case resolved. Returns `supportRequestId` as `referenceId`.
    # When `notifyCustomer` is true (default), bumps customer unread and sends
    # the closed-case email; false resolves quietly (ops Slack still fires).
    supportRequestResolve(supportRequestId: ID!, notifyCustomer: Boolean! = true): MutationResult!
    # Cancel a pending pg-boss queued job by queue `name` + `jobId`. Only known
    # queued definitions from `jobDefinitions` are allowed. Returns `jobId`.
    # See docs/features/admin-jobs.md.
    queuedJobCancel(jobId: ID!, name: String!): MutationResult!
    # Concierge free-form reply inside the Meta 24h customer-service window.
    # `referenceId` is the new WhatsApp message id.
    whatsAppMessageCreate(whatsAppConversationId: ID!, message: String!): MutationResult!
    # Apply or clear a business emoji reaction on an inbound Concierge message.
    # Empty `emoji` clears. `referenceId` is the target WhatsApp message id.
    # Meta only allows reacting to customer messages (not our outbound rows).
    whatsAppMessageReactionUpsert(whatsAppMessageId: ID!, emoji: String!): MutationResult!
    # Clears `adminUnreadCount` when opening the WhatsApp chat.
    whatsAppConversationUnreadCountReset(whatsAppConversationId: ID!): MutationResult!
    # Re-capture voucher + receipt PDFs for any PAYED gift card. Soft-fails per
    # PDF; success when at least one is written. See docs/features/admin-gift-cards.md.
    giftCardPdfsRegenerate(giftCardId: ID!): MutationResult!
}

# Admin create for an existing customer. Same fields as customer create plus
# `userId` for the owning customer account. Address input is duplicated (not
# `UserBookingRequestExactEventAddressInput`) to avoid ZodLazy circular typing
# in generated Zod schemas — define the address input before the create input.
input AdminBookingRequestExactEventAddressInput {
    displayText: String!
    latitude: Latitude!
    longitude: Longitude!
    addressLine1: String!
    addressLine2: String!
    city: String!
    postCode: String!
    state: String!
    country: String!
}

input AdminBookingRequestCreate {
    userId: ID!
    occasion: String!
    dateTime: DateTime!
    exactEventAddress: AdminBookingRequestExactEventAddressInput!
    originalMessage: String!
    preferences: [String!]!
    participants: [UserBookingRequestParticipantCreate!]!
    # Cooks to notify on create (UI selection). Intersected with offer-capable
    # cooks in travel radius; empty = publish without notifying anyone.
    cookIds: [ID!]!
}

# Admin ops partial update. Omit a field to leave it unchanged. Pass
# `adjustedMessage: null` (or blank) to clear the admin-adjusted cook-facing
# message. Venue uses the same address input as admin create.
# Optional `participants` replaces the full guest list (same as customer update):
# resets cook acceptance and emits offer timeline events when the list changes.
input AdminBookingRequestUpdate {
    occasion: String
    dateTime: DateTime
    originalMessage: String
    adjustedMessage: String
    priceClassType: BookingRequestPriceClassType
    expiresAt: DateTime
    createdAt: DateTime
    exactEventAddress: AdminBookingRequestExactEventAddressInput
    participants: [UserBookingRequestParticipantCreate!]
}

# Admin-created offer with a full manual fee breakdown (cents). Dual accept
# flags optional (null = pending). `notifyCustomer` bumps customer unread +
# SSE only — no outbound email yet.
# Admin offer create — only formula inputs. Fees / payout / customer total are
# always derived via `bookingRequestOfferPriceCalculate` on the server.
input AdminBookingRequestOfferCreate {
    bookingRequestId: ID!
    cookId: ID!
    userAccepted: Boolean
    cookAccepted: Boolean
    menuPriceCents: Int!
    travelExpensesCents: Int!
    travelDistanceKm: Float
    createdAt: DateTime
    paymentDateTime: DateTime
    plannedPayoutDateTime: DateTime
    payoutDateTime: DateTime
    notifyCustomer: Boolean!
    # Optional cook note seeded as COOK_MESSAGE_SIMPLE after COOK_CREATED. Phone numbers rejected.
    message: String
}

# Admin ops partial offer update. Fee columns are never accepted — changing
# menuPriceCents and/or travelExpensesCents recalculates the full fee snapshot.
input AdminBookingRequestOfferUpdate {
    userAccepted: Boolean
    cookAccepted: Boolean
    menuPriceCents: Int
    travelExpensesCents: Int
    travelDistanceKm: Float
    paymentDateTime: DateTime
    plannedPayoutDateTime: DateTime
    payoutDateTime: DateTime
}

# Concierge handover — close source dual-accepted offer, open/upgrade target.
# Copy flags default to true in the UI when source has data; omitted price
# fields fall back to the source offer when `copyPrice` is true.
input AdminBookingRequestOfferHandover {
    bookingRequestOfferId: ID!
    cookId: ID!
    copyPrice: Boolean!
    copyConfiguredMenu: Boolean!
    copyScheduleTimestamps: Boolean!
    # Hard-copies USER/COOK/ADMIN_MESSAGE_SIMPLE events (+ attachments) onto the
    # new offer. Prior cook messages carry provenance so they do not appear as
    # the new cook. See docs/features/admin-booking-requests.md.
    copyChatMessages: Boolean!
    # Required when source paymentStatus is PAYED_OUT_OF_SYSTEM.
    confirmOutOfSystemMoneyHandled: Boolean
    menuPriceCents: Int
    travelExpensesCents: Int
    travelDistanceKm: Float
    paymentDateTime: DateTime
    plannedPaymentPullDateTime: DateTime
    plannedPayoutDateTime: DateTime
}

# --- Legal documents ---------------------------------------------------------
#
# Versioned German legal texts (privacy / terms / imprint). Admin types keep
# `publishedAt` optional (drafts); public / acceptance types require it because
# only published rows are returned. `*De` columns leave room for future locales
# without a rename. See docs/features/admin-legal.md.

type AdminLegalPrivacyPolicy {
    privacyPolicyId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    createdAt: DateTime!
    updatedAt: DateTime!
    publishedAt: DateTime
}

type AdminLegalTermsAndConditions {
    termsAndConditionsId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    createdAt: DateTime!
    updatedAt: DateTime!
    publishedAt: DateTime
}

type AdminLegalImprint {
    imprintId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    createdAt: DateTime!
    updatedAt: DateTime!
    publishedAt: DateTime
}

type PublicLegalPrivacyPolicy {
    privacyPolicyId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    publishedAt: DateTime!
}

type PublicLegalTermsAndConditions {
    termsAndConditionsId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    publishedAt: DateTime!
}

type PublicLegalImprint {
    imprintId: ID!
    bodyDe: String!
    changeSummaryDe: String!
    publishedAt: DateTime!
}

type PublicLegal {
    privacyPolicy: PublicLegalPrivacyPolicy
    termsAndConditions: PublicLegalTermsAndConditions
    imprint: PublicLegalImprint
}

type UserLegalAcceptance {
    required: Boolean!
    pendingPrivacyPolicy: PublicLegalPrivacyPolicy
    pendingTermsAndConditions: PublicLegalTermsAndConditions
}

input AdminLegalDocumentDraftInput {
    bodyDe: String!
    changeSummaryDe: String!
}

# --- Chat live updates -------------------------------------------------------
#
# Chat-scoped snapshot subscriptions for durable turn streaming. Auth is chat
# ownership (not generationId-as-capability). The wire NOTIFY carries ids +
# revision; the resolver reloads the turn aggregate. See
# docs/architecture/chat.md and docs/architecture/state-synchronization.md.

type Subscription {
    userUpdates: User!
    sessionUpdates: Session!
    # Shared admin catalog (legal texts, …). Gated by `guardAdminSubscription`;
    # all connected admin UIs share one `admin-updates` channel. See
    # `docs/architecture/state-synchronization.md`.
    adminUpdates: Admin!
    chatTurnUpdates(chatId: ID!): ChatTurnUpdate!
}

# --- Content pages (cities / partners / occasions / blog) ---------------------
#
# Shared bilingual section model for SEO landing pages and articles. See
# docs/architecture/content-sections.md. `publishedAt` null = draft; public
# reads require `publishedAt <= now()`. Empty EN fields fall back to DE at render.

enum ContentListStyle {
    BULLET
    NUMBERED
}

enum ContentSectionKind {
    content
    image
    quote
    list
    cta
    qa
}

type ContentSectionContent {
    sectionId: ID!
    titleDe: String
    titleEn: String
    subtitleDe: String
    subtitleEn: String
    bodyDe: String!
    bodyEn: String!
    imageFileUploadId: ID
    imageUrl: String
    imageFirst: Boolean
}

type ContentSectionImage {
    sectionId: ID!
    imageFileUploadId: ID!
    imageUrl: String!
}

type ContentSectionQuote {
    sectionId: ID!
    quoteDe: String!
    quoteEn: String!
    attributionDe: String
    attributionEn: String
}

type ContentSectionList {
    sectionId: ID!
    titleDe: String
    titleEn: String
    style: ContentListStyle!
    itemsDe: [String!]!
    itemsEn: [String!]!
}

type ContentSectionCta {
    sectionId: ID!
    headlineDe: String!
    headlineEn: String!
    bodyDe: String
    bodyEn: String
    buttonLabelDe: String!
    buttonLabelEn: String!
    href: String!
}

type ContentSectionQaEntry {
    entryId: ID!
    questionDe: String!
    questionEn: String!
    answerDe: String!
    answerEn: String!
}

type ContentSectionQa {
    sectionId: ID!
    titleDe: String
    titleEn: String
    entries: [ContentSectionQaEntry!]!
}

union ContentSection =
    | ContentSectionContent
    | ContentSectionImage
    | ContentSectionQuote
    | ContentSectionList
    | ContentSectionCta
    | ContentSectionQa

# Flat write input — validated and narrowed server-side with Zod
# (`contentSectionsSchema`). Exactly the fields for `kind` must be set.
input ContentSectionQaEntryInput {
    entryId: ID!
    questionDe: String!
    questionEn: String
    answerDe: String!
    answerEn: String
}

input ContentSectionInput {
    sectionId: ID!
    kind: ContentSectionKind!
    titleDe: String
    titleEn: String
    subtitleDe: String
    subtitleEn: String
    bodyDe: String
    bodyEn: String
    imageFileUploadId: ID
    imageFirst: Boolean
    quoteDe: String
    quoteEn: String
    attributionDe: String
    attributionEn: String
    style: ContentListStyle
    itemsDe: [String!]
    itemsEn: [String!]
    headlineDe: String
    headlineEn: String
    buttonLabelDe: String
    buttonLabelEn: String
    href: String
    entries: [ContentSectionQaEntryInput!]
}

# Assigned cook on an admin city editor. Includes cooks that would not appear
# publicly so admins can see and clean up banned / hidden / unapproved rows.
type AdminCityCook {
    position: Int!
    cook: AdminCook!
    # Same gate as `/chefs` and `PublicCity.featuredCooks`.
    isPubliclyListed: Boolean!
}

type AdminPartnerCook {
    position: Int!
    cook: AdminCook!
    isPubliclyListed: Boolean!
}

type AdminOccasionCook {
    position: Int!
    cook: AdminCook!
    isPubliclyListed: Boolean!
}

type AdminCity {
    cityId: ID!
    pathName: String!
    previousPathNames: [String!]!
    nameDe: String!
    nameEn: String!
    latitude: Latitude!
    longitude: Longitude!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    # Fixed first-section slot (ChefForAnyOccasion) above free sections.
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    sections: [ContentSection!]!
    cooks: [AdminCityCook!]!
    # Candidate pool for assignment (visible + approved + travel radius).
    cooksInTravelRadius: [AdminCook!]!
    # Curated, ordered testimonials for the editor. Empty until assigned.
    testimonials: [AdminCityTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type PublicCity {
    cityId: ID!
    pathName: String!
    previousPathNames: [String!]!
    nameDe: String!
    nameEn: String!
    latitude: Latitude!
    longitude: Longitude!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    # Fixed first-section slot (ChefForAnyOccasion) above free sections.
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    sections: [ContentSection!]!
    # Curated order when assigned; else travel-radius fallback at city center.
    featuredCooks: [PublicCook!]!
    # Curated, ordered testimonials. Empty when none are assigned.
    testimonials: [CityTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type AdminPartner {
    partnerId: ID!
    pathName: String!
    previousPathNames: [String!]!
    name: String!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    # Fixed first-section slot (ChefForAnyOccasion) above free sections.
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    # Optional primary CTA href override. Null keeps the booking-request form.
    firstSectionCtaUrl: String
    # Dark scrim on hero / first-section CTA image. Default true.
    heroImageOverlay: Boolean!
    firstSectionImageOverlay: Boolean!
    # HowItWorks alternative media variant. Default false.
    howItWorksAlternativeMedia: Boolean!
    # Assigned promo code id. Null when none. Assignment rejects scoped codes.
    promoCodeId: ID
    # Resolved promo for editor preview. Null when none / expired / scoped.
    promo: PartnerPromo
    sections: [ContentSection!]!
    cooks: [AdminPartnerCook!]!
    # Curated, ordered testimonials for the editor. Empty until assigned.
    testimonials: [AdminPartnerTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type PublicPartner {
    partnerId: ID!
    pathName: String!
    previousPathNames: [String!]!
    name: String!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    # Optional primary CTA href override. Null keeps the booking-request form.
    firstSectionCtaUrl: String
    heroImageOverlay: Boolean!
    firstSectionImageOverlay: Boolean!
    howItWorksAlternativeMedia: Boolean!
    # Promo shown on the CTA card. Null when none / expired / scoped.
    promo: PartnerPromo
    sections: [ContentSection!]!
    featuredCooks: [PublicCook!]!
    # Curated, ordered testimonials. Empty when none are assigned.
    testimonials: [PartnerTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

# Public view of a promo assigned to a partner. Only returned when the code
# exists, is not booking-request-scoped, and has not expired.
type PartnerPromo {
    redeemCode: String!
    amountCents: Int!
}

# Fixed three-format showcase on occasion pages (below ChefForAnyOccasion CTA).
type OccasionFormatsCard {
    imageFileUploadId: ID
    imageUrl: String
    titleDe: String!
    titleEn: String!
    bodyDe: String!
    bodyEn: String!
    fact1De: String!
    fact1En: String!
    fact2De: String!
    fact2En: String!
    fact3De: String!
    fact3En: String!
}

type OccasionFormatsSection {
    titleDe: String!
    titleEn: String!
    subtitleDe: String!
    subtitleEn: String!
    cards: [OccasionFormatsCard!]!
}

input OccasionFormatsCardInput {
    imageFileUploadId: ID
    titleDe: String!
    titleEn: String!
    bodyDe: String!
    bodyEn: String!
    fact1De: String!
    fact1En: String!
    fact2De: String!
    fact2En: String!
    fact3De: String!
    fact3En: String!
}

input OccasionFormatsSectionInput {
    titleDe: String!
    titleEn: String!
    subtitleDe: String!
    subtitleEn: String!
    cards: [OccasionFormatsCardInput!]!
}

type AdminOccasion {
    occasionId: ID!
    pathName: String!
    previousPathNames: [String!]!
    name: String!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    # Fixed first-section slot (ChefForAnyOccasion) above free sections.
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    # Fixed three-format showcase below the CTA (typed jsonb chrome).
    formatsSection: OccasionFormatsSection!
    # Assigned promo code id. Null when none. Assignment rejects scoped codes.
    promoCodeId: ID
    # Resolved promo for editor preview. Null when none / expired / scoped.
    promo: OccasionPromo
    sections: [ContentSection!]!
    cooks: [AdminOccasionCook!]!
    # Curated, ordered testimonials for the editor. Empty until assigned.
    testimonials: [AdminOccasionTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

type PublicOccasion {
    occasionId: ID!
    pathName: String!
    previousPathNames: [String!]!
    name: String!
    titleDe: String!
    titleEn: String!
    descriptionDe: String!
    descriptionEn: String!
    headlineDe: String!
    headlineEn: String!
    subHeadlineDe: String!
    subHeadlineEn: String!
    heroImageFileUploadId: ID
    heroImageUrl: String
    firstSectionHeadlineDe: String!
    firstSectionHeadlineEn: String!
    firstSectionBodyDe: String!
    firstSectionBodyEn: String!
    firstSectionImageFileUploadId: ID
    firstSectionImageUrl: String
    # Fixed three-format showcase below the CTA (typed jsonb chrome).
    formatsSection: OccasionFormatsSection!
    # Promo shown on the CTA card. Null when none / expired / scoped.
    promo: OccasionPromo
    sections: [ContentSection!]!
    # Curated order only. Occasions are not geo pages, so there is no
    # travel-radius fallback: an empty assignment hides the section.
    featuredCooks: [PublicCook!]!
    # Curated, ordered testimonials. Empty when none are assigned.
    testimonials: [OccasionTestimonial!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
}

# Public view of a promo assigned to an occasion. Only returned when the code
# exists, is not booking-request-scoped, and has not expired.
type OccasionPromo {
    redeemCode: String!
    amountCents: Int!
}

type AdminBlogPost {
