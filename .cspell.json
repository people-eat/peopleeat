    "ignoreRegExpList": [
        "/\\bde:\\s*'[^']*'/",
        "/\\bde:\\s*\"[^\"]*\"/",
        "/\\bde:\\s*`[^`]*`/",
        "/\\b[A-Za-z]+De:\\s*'[^']*'/",
