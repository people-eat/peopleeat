# syntax=docker/dockerfile:1

FROM node:24.20.0-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install -g "npm@$(node -p "require('./package.json').packageManager.split('@')[1]")"
RUN --mount=type=cache,target=/root/.npm \
    npm pkg delete scripts.prepare scripts.postinstall \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci

FROM node:24.20.0-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG EMAIL_PREVIEW_WEB_PAGE_URL=http://localhost:3000
ENV EMAIL_PREVIEW_WEB_PAGE_URL=$EMAIL_PREVIEW_WEB_PAGE_URL
RUN npm run email:build

FROM node:24.20.0-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.react-email ./.react-email
COPY --from=build /app/src/server/email ./src/server/email
COPY --from=build /app/src/shared ./src/shared

USER node
EXPOSE 3000
CMD ["npx", "email", "start"]
