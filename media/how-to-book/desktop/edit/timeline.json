        "captions": [
            {
                "in": 0.35,
                "out": 3.2,
                "text": "Ein besonderer Abend beginnt mit deiner Idee."
            },
            {
                "in": 3.7,
                "out": 5.3,
                "text": "Beschreibe deinen Anlass und sag uns,"
            },
            {
                "in": 5.3,
                "out": 7.1,
                "text": "wie viele Gäste dabei sind."
            },
            {
                "in": 8.55,
                "out": 10.55,
                "text": "Wo und wann möchtest du feiern?"
            },
            {
                "in": 12.25,
                "out": 13.8,
                "text": "Wähle deinen Menürahmen"
            },
            {
                "in": 13.8,
                "out": 15.5,
                "text": "und was du gerne isst."
            },
            {
                "in": 17.25,
                "out": 18.6,
                "text": "Noch ein persönlicher Wunsch?"
            },
            {
                "in": 18.6,
                "out": 20.4,
                "text": "Schreib ihn einfach dazu."
            },
            {
                "in": 22.5,
                "out": 24.3,
                "text": "Passende Privatköche schicken dir"
            },
            {
                "in": 24.3,
                "out": 25.9,
                "text": "individuelle Menüvorschläge."
            },
            {
                "in": 26.3,
                "out": 29.2,
                "text": "Vergleiche die Gerichte und den Gesamtpreis in Ruhe."
            },
            {
                "in": 31.5,
                "out": 33.5,
                "text": "Im Chat und per Videoanruf lernst du deinen Koch"
            },
            {
                "in": 33.5,
                "out": 36.4,
                "text": "direkt hier auf der Plattform kennen."
            },
            {
                "in": 38.3,
                "out": 39.8,
                "text": "Brauchst du Unterstützung?"
            },
            {
                "in": 39.8,
                "out": 42.6,
                "text": "Unser Team ist für dich da und hilft bei der Abstimmung."
            },
            {
                "in": 44.6,
                "out": 46.25,
                "text": "Wenn alles passt, nimmst du dein Wunschmenü an"
            },
            {
                "in": 46.25,
                "out": 47.9,
                "text": "und bezahlst sicher."
            },
            {
                "in": 49.5,
                "out": 50.8,
                "text": "Jetzt bist du dran:"
            },
            {
                "in": 50.8,
                "out": 52.25,
                "text": "Sende deine Anfrage"
            },
            {
                "in": 52.25,
                "out": 53.7,
                "text": "und freu dich auf deinen Abend."
            },
            {
                "in": 55.35,
                "out": 57.25,
                "text": "Wir wünschen dir und deinen Gästen"
            },
            {
                "in": 57.25,
                "out": 59.8,
                "text": "unvergessliche Erlebnisse mit eurem Privatkoch."
            }
        ],
